0f1f12288b3a2b3da54f0bf4ed4ff939cab27742313","session_date":"2023-11-02","session_datetime":"2023-11-02T17:46:00","session_id":"session_28","session_index":28,"source_sha256":"5e57158322f00220a3b7dd20b96bc7f9ee78f8f78e41f05d3650c26b4da86723","speaker":"Calvin","turn_index":13},{"dia_id":"D28:14","global_turn_index":497,"locator":"[S28T14]","raw_turn_sha256":"15207489b18c8141d8445f70e3385ef2efc3c2af88efa5ca5db38a105ad0ea5b","rendered_turn_sha256":"91997d0635ea5b22daee13aacfe88b5df5c5618e618130db23ac908c59842f5a","session_date":"2023-11-02","session_datetime":"2023-11-02T17:46:00","session_id":"session_28","session_index":28,"source_sha256":"4f81bf3a4792df49a17f97c65f0db67d0ff62d5e853048bcca7d4e66d0414934","speaker":"Dave","turn_index":14}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Thanks, Dave! It was an awesome feeling seeing everyone come together to celebrate - super rewarding! Look at this photo showcasing how wonderfully we spent our time!\n[Image caption: a photography of a group of people dancing at a party]\n[S28T3] (dia_id: D28:3)\n\nDave: Wow, great job, Calvin! Congrats! What was it like when everyone was cheering you on?\n[S28T4] (dia_id: D28:4)\n\nCalvin: It was incredible, Dave! The room was buzzing with energy and love. It was a powerful reminder of why I'm doing this.\n[Image caption: a photo of a group of people standing on top of a stage]\n[S28T5] (dia_id: D28:5)\n\nDave: Wow, Calvin! Creating something that brings people together and inspires them - that's really awesome!\n[S28T6] (dia_id: D28:6)\n\nCalvin: Thanks, Dave! It's an awesome feeling. Creating something that people connect with and brings joy is what I'm all about. Moments like this really motivate me to keep growing!\n[S28T7] (dia_id: D28:7)\n\nDave: Wow, Calvin, imagining how your music affects others must be incredible! Keep up the great work! By the way, I recently started a blog on car mods. It's my way to share my passion with others. Do you have any tips on blogging for me? Just take a look at this beautiful car!\n\n\n[Image caption: a photography of a car website design]\n[S28T8] (dia_id: D28:8)\n\nCalvin: Cool, Dave! It's really fun to share your passion through blogging. Have you had any success stories yet with inspiring others?\n[S28T9] (dia_id: D28:9)\n\nDave: Thanks, Calvin! It's awesome people are checking out my blog and asking me for advice. I recently posted about how I made this car look like a beast, and it was great to hear it inspired others to start their own DIY projects.\n[Image caption: a photography of a blue subarunt parked in a parking lot]\n[S28T10] (dia_id: D28:10)\n\nCalvin: Wow, Dave! Your blog is awesome. Helping others get creative is awesome. Keep up the great work!\n[S28T11] (dia_id: D28:11)\n\nDave: Thanks, Calvin! I appreciate the support. It's fulfilling to share my knowledge and help others unleash their creativity.\n[S28T12] (dia_id: D28:12)\n\nCalvin: Yeah Dave, keep doing what you do! Your blog and car mods are inspiring and a great way to help people find their creativity.\n[S28T13] (dia_id: D28:13)\n\nDave: Thanks, Calvin! It means a lot that you enjoy my blog. This car mod was a lot of work, but I think it was worth it in the end.\n[Image caption: a photography of a blue subarunt parked in a parking lot]\n[S28T14] (dia_id: D28:14)","text_sha256":"f89b419a11b06376ddb9932dc5a917586778b1e77e6bee6cfb8aab8fa61fa1af","timestamp":"2023-11-02T17:46:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D13:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S13T1]"],"text_sha256":"c04ff814df559397e7da824cd51e0b6f0e0e12a581dd99b292a16d86abd4365f"},{"dia_ids":["D13:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S13T2]"],"text_sha256":"4f7c8422fd8f30ef8124e41694a5b268ef6ec2fe1b6d93e66b65d9c7007a