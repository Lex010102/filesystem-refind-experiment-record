sion-16.md:L68: [Image caption: a photo of a guitar with a purple glow on it]\n/memories/session-16.md:L71: Dave: That guitar has a gorgeous purple hue. Why did you make it so shiny?\n/memories/session-28.md:L88: [Image caption: a photography of a guitar logo with the company band logo]","content_sha256":"4810ff62e8892d0bfa94772b0807d50695a978bee2b34140c508c35a093cbb45","coverage":[{"line_end":49,"line_start":49,"path":"/memories/session-02.md"},{"line_end":68,"line_start":68,"path":"/memories/session-09.md"},{"line_end":72,"line_start":72,"path":"/memories/session-09.md"},{"line_end":51,"line_start":51,"path":"/memories/session-16.md"},{"line_end":52,"line_start":52,"path":"/memories/session-16.md"},{"line_end":58,"line_start":58,"path":"/memories/session-16.md"},{"line_end":61,"line_start":61,"path":"/memories/session-16.md"},{"line_end":68,"line_start":68,"path":"/memories/session-16.md"},{"line_end":71,"line_start":71,"path":"/memories/session-16.md"},{"line_end":88,"line_start":88,"path":"/memories/session-28.md"}],"post_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","pre_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","protocol_version":"center-table12-readonly-v1","result_count":10,"result_sha256":"e94af60eeae650fba94a8cdd66b7bbe93c9c66592c8c8fe4206ada51fc4088eb","root_survey":false,"tool_name":"grep","truncated":false,"whole_tree_grep":true},"schema_version":2,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679"}
