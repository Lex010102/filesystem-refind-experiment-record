ction":"# Session 26","selection_ordinal":1,"session_id":"session_26","source_kind":"raw","source_locators":["[S26T1]","[S26T2]","[S26T3]","[S26T4]","[S26T5]","[S26T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D26:1","global_turn_index":456,"locator":"[S26T1]","raw_turn_sha256":"0954495f715ee7c02250937faedee449e9657bd92f3ecb89994d75cfb85320c7","rendered_turn_sha256":"6d2bcb8c1846254b5111dff2e254bdf86135a4100e1d48bfbc68ed2d6af17ef2","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"a17b4f54f157b986f21df6986d21ce9714b7fb79ec13b445564ede63da484dcc","speaker":"Calvin","turn_index":1},{"dia_id":"D26:2","global_turn_index":457,"locator":"[S26T2]","raw_turn_sha256":"0ba18d92b5f1fa0f365e0eefd2a45b277b57e34b09ee06e6120a7af0dc3048ee","rendered_turn_sha256":"b1744a00170fef82c808ba2da8607d9fcd2774ed644622f1ae5a4fd03d92da0a","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"06d99733973749a159c60e335c05129567ae4d555ec087231b21af1ed317b66c","speaker":"Dave","turn_index":2},{"dia_id":"D26:3","global_turn_index":458,"locator":"[S26T3]","raw_turn_sha256":"fe45878bd84eaf33303fc8df61a3466b8d3f9aba50e7e0059e9bb35af97b2c5d","rendered_turn_sha256":"ce74130c6f859ab8100a8fda2bab30a2169c0aac5e80d5ebf110f8b4d668728b","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"0c7ea61ab88bf9a8d4f8a51e1d1b783e2914d46e97d9bc1a4f66c5718902e3e1","speaker":"Calvin","turn_index":3},{"dia_id":"D26:4","global_turn_index":459,"locator":"[S26T4]","raw_turn_sha256":"e52a41492e27f76b0a253869d64d8cb7986acbead14b8a53b99d3ef110a7c145","rendered_turn_sha256":"36b999a0e53408c35fe6829785843f67e2e66149e833930c0fa94c11ef53eb38","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"afee282a44f4a93fb58775508faf28ecd1d0a9c174ee812426cdbf5ee6f9c091","speaker":"Dave","turn_index":4},{"dia_id":"D26:5","global_turn_index":460,"locator":"[S26T5]","raw_turn_sha256":"18c8cd5de667f90bbbc0114b506771bf344941852b33a9b649db8600648fe478","rendered_turn_sha256":"0545e051475a5506da033b60967e3905b30308f3b34f55ddeae582adce8c96b6","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"294ff547736f1facf0893057babd43757c29a20d60e699758845608a1b10076a","speaker":"Calvin","turn_index":5},{"dia_id":"D26:6","global_turn_index":461,"locator":"[S26T6]","raw_turn_sha256":"0984e65556759dd3603695286715610d2dfb93c81ddc1c30312e0381d979a7b8","rendered_turn_sha256":"b775c33f1cef75ef7013961b39fd3d6f5585cda8a8f835ce1daefaf0b8bae756","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"a572248c08377050670de7546478883dc56f8ee72e4604c8a288e1a95ca6ff1f","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! Long time no talk! I had a great time yesterday, and visited some sights in Boston with a high school friend. It was really fun and eye-opening.\n[S26T1] (dia_id: D26:1)\n\nDave: Hey Calvin! Good to hear from you! Sounds like you had a blast in Boston - so much to do there! One of my favorites there is great for chilling and admiring nature. BTW, something cool I wanted to tell you about - I recently attended a conference in Detroit - it was so cool, I learned a lot.\n[S26T2] (dia_id: D26:2)\n\nCalvin: I had a wonderful experience during my time in Boston. It had awesome architecture and a really cool history. I followed your advice and went there, it was so peaceful. Good to hear that you've learned a lot of new things at the conference in Detroit!\n[S26T3] (dia_id: D26:3)\n\nDave: Glad you enjoyed Boston! It's got some great architecture and history. Working on this takes me out of my head and calms me down. Here's a pic of my latest car project.\n[Image caption: a photography of a group of people washing a car in a garage]\n[S26T4] (dia_id: D26:4)\n\nCalvin: Dave, that car looks awesome! What got you into engineering cars? I'm totally into cars too and love making new and powerful models.\n[S26T5] (dia_id: D26:5)\n\nDave: Thanks, Calvin! It's always been my thing. My dad took me to my first car show when I was 10, and I was wow-ed! I was hooked and wanted to learn more. Now I'm an automotive engineer and it's crazy to think that something so powerful and cool can be made from small parts.\n[S26T6] (dia_id: D26:6)","text_sha256":"2ddd8e2078be7fa0a3477917eb8b1d9402e47c0acc9cf8a363bee09e0bba3bd8","timestamp":"2023-10-25T20:25:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D3:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S3T5]"],"text_sha256":"18e5765822cdb05ccfc3b58dfe2950ab2e849da4a4d751342021c1eb9adc8a04"},{"dia_ids":["D3:6"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S3T6]"],"text_sha256":"5d4ccaad157e453260dd33df75f99cfd4730e8ef567442e44c020cca07b54060"},{"dia_ids":["D3:7"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S3T7]"],"text_sha256":"3b5882ccb2181b4c0bc85727fd1375106260cabee5c80792ad404817c7c22e81"},{"dia_ids":["D3:8"],"kind":"raw_turn","line_end":34,"line_start":33,"source_locators":["[S3T8]"],"text_sha256":"a31f66ec5d22f29dfda703d4ad8743edfd7aa52641f25b4d10fb59c5076c6fd1"},{"dia_ids":["D3:9"],"kind":"raw_turn","line_end":37,"line_start":36,"source_locators":["[S3T9]"],"text_sha256":"f17875332892d0e9b3209ad7e83d0c269dd5e8b57dfe4fe81f10eadbe9eaa4fb"},{"dia_ids":["D3:10"],"kind":"raw_turn","line_end":41,"line_start":39,"source_locators":["[S3T10]"]