he engine!\n[Image caption: a photography of a car engine with a small engine]\n[S20T1] (dia_id: D20:1)","text_sha256":"1c9bf1085f23b638026b0f88d7110f7a10be191d181f5af14e7ae74617a88ed7","timestamp":"2023-09-22T20:57:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D26:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S26T6]"],"text_sha256":"b775c33f1cef75ef7013961b39fd3d6f5585cda8a8f835ce1daefaf0b8bae756"}],"dia_ids":["D26:6"],"evidence_id":"ev-1be17f9909b301038ed28cb24d42c902a25c40ccf903e7d0b572a7b876eb022a","group_id":"session_26","line_end":29,"line_start":28,"observation_ids":["obs-0005"],"path":"/memories/session-26.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 26","selection_ordinal":3,"session_id":"session_26","source_kind":"raw","source_locators":["[S26T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D26:6","global_turn_index":461,"locator":"[S26T6]","raw_turn_sha256":"0984e65556759dd3603695286715610d2dfb93c81ddc1c30312e0381d979a7b8","rendered_turn_sha256":"b775c33f1cef75ef7013961b39fd3d6f5585cda8a8f835ce1daefaf0b8bae756","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"a572248c08377050670de7546478883dc56f8ee72e4604c8a288e1a95ca6ff1f","speaker":"Dave","turn_index":6}],"speaker":"Dave","store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Thanks, Calvin! It's always been my thing. My dad took me to my first car show when I was 10, and I was wow-ed! I was hooked and wanted to learn more. Now I'm an automotive engineer and it's crazy to think that something so powerful and cool can be made from s