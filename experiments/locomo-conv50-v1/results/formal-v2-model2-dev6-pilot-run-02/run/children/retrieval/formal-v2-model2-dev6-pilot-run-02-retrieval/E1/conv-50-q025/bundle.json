s ever since.\n[Image caption: a photo of a man working on a car in a garage]\n[S25T15] (dia_id: D25:15)","text_sha256":"3bea5c17242482d773fc898ab4d4b1d62bd455465dbbb344bcfbcdf5d35749ec","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D22:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S22T5]"],"text_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e"}],"dia_ids":["D22:5"],"evidence_id":"ev-44dc606f5f7d00b35be0f581f7a773f6e21a940efeb87b6764cac1a9b9d84da0","group_id":"session_22","line_end":28,"line_start":27,"observation_ids":["obs-0007"],"path":"/memories/session-22.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 22","selection_ordinal":5,"session_id":"session_22","source_kind":"raw","source_locators":["[S22T5]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D22:5","global_turn_index":374,"locator":"[S22T5]","raw_turn_sha256":"d9df745e960a9235c8ef6144815906d4e022abaaa2b260446481c487ba842026","rendered_turn_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"21025906b21bb4f66753338fae54c39b0c8d7507b31852bdc3645a6571e8e0b0","speaker":"Dave","turn_index":5}],"speaker":"Dave","store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Thanks Calvin! I've spent a lot of time and effort on it. It's not just a hobby, it's a passion. It's like therapy, a way to get away from everyday stress. When I was little I'd spend hours in my dad's garage, tinkering with engines - it was like my own sanct