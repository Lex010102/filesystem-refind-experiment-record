a51","speaker":"Dave","turn_index":3},{"dia_id":"D22:4","global_turn_index":373,"locator":"[S22T4]","raw_turn_sha256":"0509ab7b82695f13b210c52b5ed1aa913c06a546bac4b61f28e3d3d62b3c4893","rendered_turn_sha256":"25fe29d97f81835b34ae104469b4a0b218c64a9df39f93b96ad04db84f12c5c1","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"cba10ff1c04450d25839faf9c31fa7981f8659767347efdfc0db99e40cdfbe9e","speaker":"Calvin","turn_index":4},{"dia_id":"D22:5","global_turn_index":374,"locator":"[S22T5]","raw_turn_sha256":"d9df745e960a9235c8ef6144815906d4e022abaaa2b260446481c487ba842026","rendered_turn_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"21025906b21bb4f66753338fae54c39b0c8d7507b31852bdc3645a6571e8e0b0","speaker":"Dave","turn_index":5}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Thanks! Yeah, this one looks great! I restored and modified it myself and added a custom exhaust and some performance upgrades. It's got a sweet sound and I'm really proud of how it turned out.\n[S22T3] (dia_id: D22:3)\n\nCalvin: Wow, Dave! You really turned it into a masterpiece. Impressive!\n[Image caption: a photo of a car driving down a street with a traffic light]\n[S22T4] (dia_id: D22:4)\n\nDave: Thanks Calvin! I've spent a lot of time and effort on it. It's not just a hobby, it's a passion. It's like therapy, a way to get away from everyday stress. When I was little I'd spend hours in my dad's garage, tinkering with engines - it was like my own sanctuary. Now I'm lucky enough to do this as a job, to take something broken and make it into something awesome.\n[S22T5] (dia_id: D22:5)","text_sha256":"8b5e1bcc190c00dcedced82a1f2d3e7ce84527fbad3a15f799098fff2415a8e8","timesta