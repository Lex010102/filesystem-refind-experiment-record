d662a5e70fc3c640cac71c149a10664204d75","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"7cf01203a97b4136b7f055746a65fb45757641ce8ccdef4836fe083aa90c73d3","speaker":"Dave","turn_index":2},{"dia_id":"D7:3","global_turn_index":122,"locator":"[S7T3]","raw_turn_sha256":"268980520d716df58b337f3f4c3a2386c6d66bbb96864b955e8ed052a7796cf0","rendered_turn_sha256":"e21ffc108c8713e25b3b276ac6c93d0b3990c3805e72d5dfbf5bfe0854f8bb74","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"d9543bbad5d3fb91632abae1fd7c9b0c9e40bb05ed02ab3f907bd0db23e2ccd5","speaker":"Calvin","turn_index":3},{"dia_id":"D7:4","global_turn_index":123,"locator":"[S7T4]","raw_turn_sha256":"a77692115687db66502938fac1dfee3fe7d76e4ac642322cfa41976061a730b3","rendered_turn_sha256":"29c7f28da678631cc2445278145c32a97ca12fe948d970f5a30e37ee09cfe88f","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"368217fa071099ba38a13e07b3e5e3b093e924004685cf43cdc542766a377edf","speaker":"Dave","turn_index":4}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! Been ages since we chatted. So much has gone down. Touring with Frank Ocean last week was wild. Tokyo was unreal -- the crowd was insane. I felt so alive when performing, can't find the words to express it.\n[S7T1] (dia_id: D7:1)\n\nDave: Wow, that's awesome, Cal! I bet it was an incredible experience. Congrats! Look what I've been up to recently, that's my neighbor's car. He's been having some trouble with the engine, but now it's done by myself!\n[Image caption: a photo of a man working on a car engine in a garage]\n[S7T2] (dia_id: D7:2)\n\nCalvin: Thanks, Dave! It was an amazing experience - the energy and love from the fans was crazy. The car in the pic? It's the one you were fixing up the engine for a friend? Working on cars helps me chill and clear my head.\n[S7T3] (dia_id: D7:3)\n\nDave: Yes, Cal! It's not difficult for me to help my neighbors with their cars. Working on cars is definitely therapeutic. Does it relax you as much as it does me?\n[S7T4] (dia_id: D7:4)","text_sha256":"e04e538f7ad5f5decef3083feb152975d36a3e6b412472a1ead746b8ed1a45d8","timestamp":"2023-05-31T18:06:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D26:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S26T5]"],"text_sha256":"0545e051475a5506da033b60967e3905b30308f3b34f55ddeae582adce8c96b6"},{"dia_ids":["D26:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S26T6]"],"text_sha256":"b775c33f1cef75ef7013961b39fd3d6f5585cda8a8f835ce1daefaf0b8bae756"}],"dia_ids":["D26:5","D26:6"],"evidence_id":"ev-b4532f8e76e809ef85a4b52bc0a0e3801d13afd000fdb06a2872b82343f96a3c","group_id":"session_26","line_end":29,"line_start":25,"observation_ids":["obs-0007"],"path":"/memories/cars-and-auto-work/session-26.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 26","selection_ordinal":5,"session_id":"session_26","source_kind":"raw","source_locators":["[S26T5]","[S26T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D26:5","global_turn_index":460,"locator":"[S26T5]","raw_turn_sha256":"18c8cd5de667f90bbbc0114b506771bf344941852b33a9b649db8600648fe478","rendered_turn_sha256":"0545e051475a5506da033b60967e3905b30308f3b34f55ddeae582adce8c96b6","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"294ff547736f1facf0893057babd43757c29a20d60e6997588456