011410e484c396d8bdb015dfa16b35a7","rendered_turn_sha256":"912a1a3c8ad0270e4df402d58b653b7e13d086924fced9a87a5caafd0a2eb039","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"922ae18c66a0ee94adfc6a762bd33340e0a4ccec6f97c42ff1b2dbff70415d7d","speaker":"Calvin","turn_index":2},{"dia_id":"D22:3","global_turn_index":372,"locator":"[S22T3]","raw_turn_sha256":"915b8d883d5bcde5bd1dafc30bba24507e438cd6c6c2329c4f20cc9b18122e8d","rendered_turn_sha256":"18df288f8b36442c2a573b3a379f5f5d0a1e9c5af76455fcaf02bb6f706e937b","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"7c1b2aa43b05024004306ef2082d7e4d55c10cbe3369a47f2bef1798c9a5aa51","speaker":"Dave","turn_index":3},{"dia_id":"D22:4","global_turn_index":373,"locator":"[S22T4]","raw_turn_sha256":"0509ab7b82695f13b210c52b5ed1aa913c06a546bac4b61f28e3d3d62b3c4893","rendered_turn_sha256":"25fe29d97f81835b34ae104469b4a0b218c64a9df39f93b96ad04db84f12c5c1","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"cba10ff1c04450d25839faf9c31fa7981f8659767347efdfc0db99e40cdfbe9e","speaker":"Calvin","turn_index":4},{"dia_id":"D22:5","global_turn_index":374,"locator":"[S22T5]","raw_turn_sha256":"d9df745e960a9235c8ef6144815906d4e022abaaa2b260446481c487ba842026","rendered_turn_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"21025906b21bb4f66753338fae54c39b0c8d7507b31852bdc3645a6571e8e0b0","speaker":"Dave","turn_index":5},{"dia_id":"D22:6","global_turn_index":375,"locator":"[S22T6]","raw_turn_sha256":"5fcce4f279a78847ead4beea8ee2b9ff8636070d0293d7904000b82401258be3","rendered_turn_sha256":"cdb97b02ead7ab0929e49b06a34327709bdc5d6775decbee5bf8f2e7667813d2","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"3782a0284566f921eb52bb03cbb538fbe5833070ef3586e44fade39c05487947","speaker":"Calvin","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Hey Calvin! What’s up? Last Friday I went to the car show. I saw some awesome cars and got to mess with car mods! There were so many cool machines around, it was so much fun! Take a look at this beautiful car!\n[Image caption: a photography of two men looking at a car engine]\n[S22T1] (dia_id: D22:1)\n\nCalvin: Hey Dave, that sounds awesome! I'm into the rush of awesome cars. Can't wait to check out your garage.\n[Image caption: a photo of a red sports car parked in a showroom]\n[S22T2] (dia_id: D22:2)\n\nDave: Thanks! Yeah, this one looks great! I restored and modified it myself and added a custom exhaust and some performance upgrades. It's got a sweet sound and I'm really proud of how it turned out.\n[S22T3] (dia_id: D22:3)\n\nCalvin: Wow, Dave! You really turned it into a masterpiece. Impressive!\n[Image caption: a photo of a car driving down a street with a traffic light]\n[S22T4] (dia_id: D22:4)\n\nDave: Thanks Calvin! I've spent a lot of time and effort on it. It's not just a hobby, it's a passion. It's like therapy, a way to get away from everyday stress. When I was little I'd spend hours in my dad's garage, tinkering with engines - it was like my own sanctuary. Now I'm lucky enough to do this as a job, to take something broken and make it into something awesome.\n[S22T5] (dia_id: D22:5)\n\nCalvin: Wow, Dave, that's amazing. Bringing broken things back to life is so satisfying. Working on cars can be a real escape from reality, and I understand that feeling. Doing what you love for a living, that's the ultimate goal, right? Keep going with it, it's really inspiring.\n[S22T6] (dia_id: D22:6)","text_sha256":"218d62259477b5efc171573ff64ef32bf6ecc869d2a29090020d2d439c25e70c","timestamp":"2023-10-08T15:13:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D5:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S5T1]"],"text_sha256":"9c915f2f720758f1aa69f85fb7031406f5a908a381aee36bcf2d23718843c282"},{"dia_ids":["D5:2"],"kind":"raw_turn","line_end":18,"line_start":16,"source_locators":["[S5T2]"],"text_sha256":"336332abff03e5f7b2a1fe35516f1bfe526ca19cb7a38eeeff144ca466d52b46"},{"dia_ids":["D5:3"],"kind":"raw_turn","line_end":22,"line_start":20,"source_locators":["[S5T3]"],"text_sha256":"a25cd32818a9be4a8398a4723f9944448d406631a9818161bf7b4c014fd2adec"},{"dia_ids":["D5:4"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S5T4]"],"text_sha256":"4b88c4089b91f031a19b310c2dbc5b0d5c438403f60587ccdf81181213a4148a"},{"dia_ids":["D5:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S5T5]"],"text_sha256":"95b51e9c382d11641d8cc39f743c473a109b3611538ef8967014388813d1f795"},{"dia_ids":["D5:6"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S5T6]"],"text_sha256":"3ae0549b4a037d2cc7f3b387de0c13b3248bd962659b9ff1d5c503cadc2a37e1"}],"dia_ids":["D5:1","D5:2","D5:3","D5:4","D5:5","D5:6"],"evidence_id":"ev-6b75113415cfa6493f5a7274c8b382c16685b7d34f15d5f7ebc78f03c64eab2f","group_id":"session_5","line_end":31,"line_start":12,"observation_ids":["obs-0002"],"path":"/memories/cars-and-auto-work/session-05.md","query_terms":["car","mod","blogg","dii","passion"],"rank":5,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":4,"schema_version":1,"score":0.030090497737556562,"section":"# Session 5","selection_ordinal":8,"session_id":"session_5","source_kind":"raw","source_locators":["[S5T1]","[S5T2]","[S5T3]","[S5T4]","[S5T5]","[S5T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdc