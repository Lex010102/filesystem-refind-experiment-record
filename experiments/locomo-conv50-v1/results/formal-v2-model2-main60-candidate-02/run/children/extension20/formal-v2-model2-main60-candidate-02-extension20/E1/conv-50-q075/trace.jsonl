rue to yourself. It got me thinking, where do you see your music taking you?\nL34: [S3T8] (dia_id: D3:8)","content_sha256":"ccfb6bb724be34a4bc84002f2616a170fdc5d401475d3bcfa5b2a449dac4de71","coverage":[{"line_end":34,"line_start":14,"path":"/memories/session-03.md"}],"post_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","pre_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","protocol_version":"center-table12-readonly-v1","result_count":21,"result_sha256":"1077e344ecf41c77a8b9241ceff65d9bfbf479d98310d136ae94b1f104943dbe","root_survey":false,"tool_name":"view","truncated":false,"whole_tree_grep":false},"schema_version":2,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679"}
