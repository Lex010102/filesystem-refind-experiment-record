2abed729a0f9f21","speaker":"Calvin","turn_index":10},{"dia_id":"D23:11","global_turn_index":394,"locator":"[S23T11]","raw_turn_sha256":"1157316c1099dbb3d497d52596424e1456d462162f7168ace30cc5ea3d90ae1b","rendered_turn_sha256":"36fd7ddc8ecaa22cad5ccd57afa98a0cbf4d51f09e34d6444a9be55d728d51ef","session_date":"2023-10-15","session_datetime":"2023-10-15T09:39:00","session_id":"session_23","session_index":23,"source_sha256":"68e3e6708a6e02d59e2d4a048fc084bbcd082e96cd339bbc2b924e6bffe5b25d","speaker":"Dave","turn_index":11},{"dia_id":"D23:12","global_turn_index":395,"locator":"[S23T12]","raw_turn_sha256":"5760dbc7d2301186490dcfac13a8ee071d080662ace3760ebf626e89e70d8f4d","rendered_turn_sha256":"2ff635e5ed8bba9fd5735b8d129dbdf960c87536b7e46f771594053f951caca5","session_date":"2023-10-15","session_datetime":"2023-10-15T09:39:00","session_id":"session_23","session_index":23,"source_sha256":"63ed2ee0f4b993ef6d5b99bee07cb50b480deed089f33a9a6a28f57ed7bbcc05","speaker":"Calvin","turn_index":12},{"dia_id":"D23:13","global_turn_index":396,"locator":"[S23T13]","raw_turn_sha256":"472bdc4a2d1817e0f270e54d3903563ff42df32a6ebfb4cd285472a85cd6106b","rendered_turn_sha256":"61e33ce8de6c818ae7ef0c54812bf81af8d8560c5fbecaf246cf402dfab40e09","session_date":"2023-10-15","session_datetime":"2023-10-15T09:39:00","session_id":"session_23","session_index":23,"source_sha256":"c14feddd0d8b0c852c87599b80430d112becf5d07a38af271d570531a2e0a487","speaker":"Dave","turn_index":13},{"dia_id":"D23:14","global_turn_index":397,"locator":"[S23T14]","raw_turn_sha256":"93312f2c66fdbdc87fc288e97ddbf26dcf9aa9f43e836452b5f70115fdd6668c","rendered_turn_sha256":"93960c420f1d491073181cb9e163ccde22eaa532dd66af7670fb0983cf569e6c","session_date":"2023-10-15","session_datetime":"2023-10-15T09:39:00","session_id":"session_23","session_index":23,"source_sha256":"e415d4e4d92e0934886cbb3fba8776738eaa8b491fa339e93bc16dc8c062cced","speaker":"Calvin","turn_index":14}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: That's a great approach, Cal! Reminding yourself of the passion for the goals and getting help from others is really important. Taking a break and having fun sounds so refreshing. Oh, I just got back from a music festival - it was amazing! The energy, the music, the crowd - sooo good. I felt so alive!\n[S23T5] (dia_id: D23:5)\n\nCalvin: Wow Dave, sounds awesome! Music festivals bring so much joy and the energy of the crowd can be amazing. Got any photos from the festival? I'd love to check them out and join in on the fun.\n[S23T6] (dia_id: D23:6)\n\nDave: Yep! I got this awesome pic from the event. The main stage was unreal. The headliner was so good and the vibe was unreal!\n[Image caption: a photo of a stage with a crowd of people watching a band]\n[S23T7] (dia_id: D23:7)\n\nCalvin: Wow, that looks awesome! The crowd looks really excited and the stage is incredible. Who was the headliner?\n[S23T8] (dia_id: D23:8)\n\nDave: The Fireworks headlined the festival.\n[S23T9] (dia_id: D23:9)\n\nCalvin: Wow, I heard great things about The Fireworks! Performing with Frank Ocean recently has been really cool. Seeing them perform live must've been awesome - I bet the energy was electric! That's why I love my job so much - connecting with the crowd.\n[S23T10] (dia_id: D23:10)\n\nDave: Yeah, Calvin! The crowd had such a buzz. Music brings people together in such an amazing way, and it's just like when I'm fixing up things. I love the feeling of taking something broken and making it whole again. That's why I keep doing what I do.\n[S23T11] (dia_id: D23:11)\n\nCalvin: Yeah, Dave! Music and repairing things are so fulfilling and satisfying. Seeing something go from broken to whole is incredible. You're making a difference too - it's amazing. Keep it up, friend.\n[S23T12] (dia_id: D23:12)\n\nDave: Thanks, buddy. Your support really helps. It's great to have a friend who believes in me. I'll keep pushing.\n[S23T13] (dia_id: D23:13)\n\nCalvin: I believe in you, Dave. Keep pushing and never forget how awesome you are.\n[S23T14] (dia_id: D23:14)","text_sha256":"239b1e6b52b6d6c71353e4422c97d8fa4bf60ce12fb18be18721cfab55079b76","timestamp":"2023-10-15T09:39:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D3:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S3T1]"],"text_sha256":"60de5c5ec1bff27a88cb70259801cd6554101ae3253fea90c34d0c5b708de5ff"},{"dia_ids":["D3:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S3T2]"],"text_sha256":"1f66808dd922f25ddf5cfd921da16628146a3cfaf9d24090e2abe3ca1c90b610"},{"dia_ids":["D3:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S3T3]"],"text_sha256":"968324bcdc2984e4b25fadd10acbde510b87311a5ea843476a96d0863556786b"},{"dia_ids":["D3:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S3T4]"],"text_sha256":"992ce7de476408001520f96954131b2a25787782260aa74b4ce86f4d6a6ba1b6"},{"dia_ids":["D3:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S3T5]"],"text_sha256":"18e5765822cdb05ccfc3b58dfe2950ab2e849da4a4d751342021c1eb9adc8a04"},{"dia_ids":["D3:6"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S3T6]"],"text_sha256":"5d4ccaad157e453260dd33df75f99cfd4730e8ef567442e44c020cca07b54060"},{"dia_ids":["D3:7"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S3T7]"],"text_sha256":"3b5882ccb2181b4c0bc85727fd1375106260cabee5c80792ad404817c7c22e81"},{"dia_ids":["D3:8"],"kind":"raw_turn","line_end":34,"line_start":33,"source_locators":["[S3T8]"],"text_sha256":"a31f66ec5d22f29dfda703d4ad8743edfd7aa52641f25b4d10fb59c5076c6fd1"},{"dia_ids":["D3:9"],"kind":"raw_turn","line_end":37,"line_start":36,"source_locators":["[S3T9]"],"text_sha256":"f17875332892d0e9b3209ad7e83d0c269dd5e8b57dfe4fe81f10eadbe9eaa4fb"},{"dia_ids":["D3:10"]