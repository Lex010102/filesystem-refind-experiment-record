]","raw_turn_sha256":"9af1ba689030eda71a7b77e81646c11c178028488b84bf8033f065df2fe09019","rendered_turn_sha256":"64e0eeace93b6a1c739d8bf14528b557eee23e4d90c888a3787a3d1d820486b8","session_date":"2023-08-22","session_datetime":"2023-08-22T11:06:00","session_id":"session_15","session_index":15,"source_sha256":"967c01aaa2141158daa2dc3c85fc919a51ebce9643d8bb45820096ec28dbb7b0","speaker":"Calvin","turn_index":8}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin! Haven't talked in a while! Last Friday I had a card-night with my friends, it was so much fun. We laughed and had a great time! Take a look at the photo!\n[Image caption: a photography of a group of men sitting at a table with playing cards]\n[S15T1] (dia_id: D15:1)\n\nCalvin: Hey Dave! Great to hear from you, card night sounds like a blast! Always love having fun with friends. Guess what? I scored a deal to continue collaboration with Frank Ocean! This is a dream come true for me, I've been working hard and it's finally paying off. No words can describe how happy I am.\n[S15T2] (dia_id: D15:2)\n\nDave: Wow Calvin, congrats! Super excited for you. How did this chance come up?\n[S15T3] (dia_id: D15:3)\n\nCalvin: Thanks, Dave! I had the opportunity to meet Frank Ocean at a music festival in Tokyo and we clicked. We've been speaking and sharing ideas we arranged a meeting and recorded a song in the studio at my mansion - it's been great!\n[S15T4] (dia_id: D15:4)\n\nDave: Wow, Tokyo sounds like an incredible experience!\n[S15T5] (dia_id: D15:5)\n\nCalvin: It was an incredible experience, Dave! The city was buzzing with energy and the festival crowd was so lively - it was like fuel for my soul. Look at this photo, that's amazing!\n[Image caption: a photo of a crowd of people sitting on the grass at night]\n[S15T6] (dia_id: D15:6)\n\nDave: Wow, that sounds incredible! What was it like playing at the festival? Must have been an amazing experience.\n[S15T7] (dia_id: D15:7)\n\nCalvin: It was a dream come true, Dave! The festival had buzzing energy and a super upbeat crowd. We all felt connected, it was amazing!\n[S15T8] (dia_id: D15:8)","text_sha256":"1a6174300515a4e8828b533975497d5f77a35252ca7730e5cd09058133c44af7","timestamp":"2023-08-22T11:06:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D24:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S24T1]"],"text_sha256":"cd2c480b7b17d3326eff30e3ece6d86ef378ca109d4aff3cdd3db2d727e2877d"},{"dia_ids":["D24:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S24T2]"],"text_sha256":"330147f6d39fe0d4174ccf5c9ccff6a9bde1fa3a3e69314d2969b472034d7abf"},{"dia_ids":["D24:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S24T3]"],"text_sha256":"0a47b03122cda34f3233bc69554f7471ea12258814af538666f73289f63ee86c"},{"dia_ids":["D24:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S24T4]"],"text_sha256":"9b3ba4499cda45adb9f9833b024eddad268077581be6959cd139758113cf6ada"},{"dia_ids":["D24:5"],"kind":"raw_turn","line_end":27,"line_start":25,"source_locators":["[S24T5]"],"text_sha256":"60d20766e5359193e872b15c819fbb920925caed1cf223ca4e759df145144e1c"},{"dia_ids":["D24:6"],"kind":"raw_turn","line_end":30,"line_start":29,"source_locators":["[S24T6]"],"text_sha256":"91d4abcb30f06f9524e08c3463f29590ce086c4de12e01f1434308ba95bcf1b4"},{"dia_ids":["D24:7"],"kind":"raw_turn","line_end":34,"line_start":32,"source_locators":["[S24T7]"],"text_sha256":"4ef35198dcf8c04e86fc37d5dd79850db24f6a53668001d0df206d40b41ce86c"},{"dia_ids":["D24:8"],"kind":"raw_turn","line_end":37,"line_start":36,"source_locators":["[S24T8]"],"text_sha256":"2346af100f269a632800f093267eb00a62b779e94aa2e3e350ae3a503836c8ce"}],"dia_ids":["D24:1","D24:2","D24:3","D24:4","D24:5","D24:6","D24:7","D24:8"],"evidence_id":"ev-6e3f266578