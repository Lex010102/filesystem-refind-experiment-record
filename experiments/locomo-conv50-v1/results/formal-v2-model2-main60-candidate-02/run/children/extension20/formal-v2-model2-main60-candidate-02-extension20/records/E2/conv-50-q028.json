,"source_sha256":"9a419f049f213109cc7f427618ec354da1d5dbf0269d992dded36556a0cedea9","speaker":"Calvin","turn_index":17},{"dia_id":"D6:18","global_turn_index":119,"locator":"[S6T18]","raw_turn_sha256":"44525f2a13a3373bc7a8f1dddd86bfc97090b48c1e7baf9f1592b1ac4fdc67c7","rendered_turn_sha256":"3907ba65df3924e1d8010f0ac9e92a086b97b215d1dfe8cf90cc872f2dfb617d","session_date":"2023-05-16","session_datetime":"2023-05-16T11:50:00","session_id":"session_6","session_index":6,"source_sha256":"913638c7175f969f164670eb47fd7e57978def116ebbba0afd7e895b2bed0b53","speaker":"Dave","turn_index":18}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Sure thing, Dave! I'll keep you posted on how it goes. Thanks for the good luck! Look what a wonderful night! \n\n[Image caption: a photo of a city at night with a lot of lights]\n[S6T13] (dia_id: D6:13)\n\nDave: That looks great! Where did you snap that pic?\n[S6T14] (dia_id: D6:14)\n\nCalvin: I took that pic in Tokyo last night. The skyline was stunning!\n[S6T15] (dia_id: D6:15)\n\nDave: Wow, great shot! The night skyline really pops with those city lights. I gotta take a trip there soon!\n[S6T16] (dia_id: D6:16)\n\nCalvin: Thanks Dave! The city lights there are amazing. You should visit, it's awesome!\n[S6T17] (dia_id: D6:17)\n\nDave: Definitely adding it to my list. Thanks!\n[S6T18] (dia_id: D6:18)","text_sha256":"1f877962a7cf717ed605b8c07950a80e16ac06d5059e52f880a7e8318dbc64c0","timestamp":"2023-05-16T11:50:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D24:9"],"kind":"raw_turn","line_end":41,"line_start":39,"source_locators":["[S24T9]"],"text_sha256":"56973f017b39982c134802816b918ce184b4fdb8bfdae8e70a1ff39b213d6fc7"},{"dia_ids":["D24:10"],"kind":"raw_turn","line_end":44,"line_start":43,"source_locators":["[S24T10]"],"text_sha256":"17b6615cb95db7991e3f6fed8e29feaac