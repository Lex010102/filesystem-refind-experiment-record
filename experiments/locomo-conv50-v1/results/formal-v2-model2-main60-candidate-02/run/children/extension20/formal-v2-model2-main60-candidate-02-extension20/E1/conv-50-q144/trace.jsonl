 way to help people find their creativity.\n/memories/session-28.md:L58: Dave: Thanks, Calvin! It means a lot that you enjoy my blog. This car mod was a lot of work, but I think it was worth it in the end.","content_sha256":"6c6489eed4d5936ad2f6dd94312ec77e8d3b2c6da4c246f3371dc87493f3e968","coverage":[{"line_end":36,"line_start":36,"path":"/memories/session-28.md"},{"line_end":42,"line_start":42,"path":"/memories/session-28.md"},{"line_end":45,"line_start":45,"path":"/memories/session-28.md"},{"line_end":49,"line_start":49,"path":"/memories/session-28.md"},{"line_end":55,"line_start":55,"path":"/memories/session-28.md"},{"line_end":58,"line_start":58,"path":"/memories/session-28.md"}],"post_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","pre_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","protocol_version":"center-table12-readonly-v1","result_count":6,"result_sha256":"5c23ba332614e4be3b09e28cadb0bce09d07b374a7d335fbd435a8745765a98b","root_survey":false,"tool_name":"grep","truncated":false,"whole_tree_grep":true},"schema_version":2,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679"}
