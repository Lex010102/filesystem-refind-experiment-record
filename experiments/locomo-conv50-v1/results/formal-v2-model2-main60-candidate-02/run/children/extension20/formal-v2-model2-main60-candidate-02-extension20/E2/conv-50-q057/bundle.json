eaker":"Calvin","turn_index":13},{"dia_id":"D3:14","global_turn_index":54,"locator":"[S3T14]","raw_turn_sha256":"2841aae09c8ea1914653477b1d2316effa9e6102fd13303865d502ff743275ee","rendered_turn_sha256":"cb2ff569299f198efe43a081b15eebbbfe00a55cf1bc6494e02cdb4aaf3e90a4","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"1934b5c632d744f8dfcfccdfbdf085e2877ab5d909d6dadafceffb337f4a1542","speaker":"Dave","turn_index":14},{"dia_id":"D3:15","global_turn_index":55,"locator":"[S3T15]","raw_turn_sha256":"3d8db99e645084040c82e4f3e7430a93a56bdc2b5b0f400d41219892b2cc23ce","rendered_turn_sha256":"8756da8b4feae065ed7ed84429bbd6e544df083247abd338e5af89f4042c1ab2","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"fe0e57336911b17fe24e3bddcc5d264a13671ceb1ae14bf80848ba2249941c32","speaker":"Calvin","turn_index":15},{"dia_id":"D3:16","global_turn_index":56,"locator":"[S3T16]","raw_turn_sha256":"e5805e7ec4c08f0b01a772011da55b4fb8e3e1c5836976594ba3f544ab27251b","rendered_turn_sha256":"640e85992e807dbbe5b7416a889ef5be2d228fe16c507fe2d0907d8ea7517e75","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"d47233b9f5b3294e736932ca7d13bb75546be8c286e04cd72493e20a4c571984","speaker":"Dave","turn_index":16},{"dia_id":"D3:17","global_turn_index":57,"locator":"[S3T17]","raw_turn_sha256":"240f38e9dd5fa6000b1caf001bbad809dea549ac8ecc81b97063035abc14c66c","rendered_turn_sha256":"f394ab43242604506724c96e635d32d5a7a8f4d77dab993d750dd5160bc8fa9f","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"a52b88db3b4f39d95679cb8c2c71a0b0c342b007e9efb5324d10bb0a8bea96a7","speaker":"Calvin","turn_index":17},{"dia_id":"D3:18","global_turn_index":58,"locator":"[S3T18]","raw_turn_sha256":"1cb1edb37f399b63c9af6b927bdcb9e5a45efb2d1d492a2f56091cfb2c426d8d","rendered_turn_sha256":"64188feba3cceeba358dfb9ef9b09e1e7116164b47a3ca0fd3d355f8d9e53865","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"e077eaaa089c417310c0133ec3dd7939c98e178cfc98bdccb7bf198c6f75ea81","speaker":"Dave","turn_index":18}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Wow, Boston looks great! Thanks for the tips. And, awesome pic!\n[S3T11] (dia_id: D3:11)\n\nDave: Last weekend I went to a car show. Classic cars are so charming and the dedication people put into restoring them is amazing. That's why I'm so into auto engineering. Can't wait to show you some when you come to Boston! Oh, almost forgot to send a photo, look at this beautiful car!\n[Image caption: a photography of a green mustang parked in a field of grass]\n[S3T12] (dia_id: D3:12)\n\nCalvin: Wow, Dave, that car looks great! Take a look at my car, I put a lot of work into it. Can't wait to see more when I'm in Boston!\n[Image caption: a photo of a red sports car on display at a show]\n[S3T13] (dia_id: D3:13)\n\nDave: Thanks! It definitely took a lot of work. Have you had a chance to check out Boston apart from the gigs?\n[S3T14] (dia_id: D3:14)\n\nCalvin: Not yet, been pretty busy with rehearsals and traveling. But I'm looking forward to exploring the city, trying out some delicious food, and visiting the popular attractions. Maybe we can grab a bite together when I'm there?\n[S3T15] (dia_id: D3:15)\n\nDave: Definitely, Cal! Let's grab some food and I'll show you my favorite spots in the city. Can't wait to show them to you!\n[S3T16] (dia_id: D3:16)\n\nCalvin: Sounds great, Dave! Can't wait to try out the food there with you. It'll be fun!\n[S3T17] (dia_id: D3:17)\n\nDave: It'll be great, Cal! Can't wait to show you the amazing music and food here. See you soon!\n[S3T18] (dia_id: D3:18)","text_sha256":"83065825407f2731c9e972f7419fec31e4b589b5b86d2dbb792748b60a0003a4","timestamp":"2023-04-20T16:15:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D27:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S27T1]"],"text_sha256":"d2da4a32c8deca7df6b5d8d3d414d4115079ca43c7ee0efce601eda3f1a81650"},{"dia_ids":["D27:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S27T2]"],"text_sha256":"ef4b7a4b0951ae75f6912be56585746563d9d7aa0f6c8e6671a2b3f582ad8699"},{"dia_ids":["D27:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S27T3]"],"text_sha256":"9d30d75577b61e06e254fc2fd38c151fa008ad1bc0cfb9e45b98486b1f32800c"},{"dia_ids":["D27:4"],"kind":"raw_turn","line_end":23,"line_start":21,"source_locators":["[S27T4]"],"text_sha256":"0b6629bf840436d356cdd2b5034ee43099ad1acaf03adedc3f39d91a4946b018"},{"dia_ids":["D27:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S27T5]"],"text_sha256":"26d3e4b7d8dc2fdd46520e4801311fb32f3b0e5179477ba7d20538169b02f6c1"},{"dia_ids":["D27:6"],"kind":"raw_turn","line_end":30,"line_start":28,"source_locators":["[S27T6]"],"text_sha256":"12d1376b128cfbe6650f81b8a680a342f6627781e642ab5f52c7f16055122b25"},{"dia_ids":["D27:7"],"kind":"raw_turn","line_end":33,"line_start":32,"source_locators":["[S27T7]"],"text_sha256":"51aeeab0e7b91e53e5fdb78abd7d2abe13a2bfcd042f8bb1c8231bc2322a2a8b"},{"dia_ids":["D27:8"],"kind":"raw_turn","line_end":36,"line_start":35,"source_locators":["[S27T8]"],"text_sha256":"f606909ecff493e4f4a08f06313193e5c5d71094557380dce629e97f777ca52e"},{"dia_ids":["D27:9"],"kind":"raw_turn","line_end":39,"line_start":38,"source_locators":["[S27T9]"],"text_sha256":"c142f56ee7c4ca1cdf2a6bacdb67c48e1ab2d6c1da6417e6cb0b0fcff2220e12"},{"dia_ids":["D27:10"],"kind":"raw_turn","line_end":42,"line_start":41,"source_locators":["[S27T10]"],"text_sha256":"4093068f6134