ssion_8","session_index":8,"source_sha256":"6c4fd0e768f4f7ba14cdde081497f22ef29cab7aa1615ced47ad6dabc4612a1a","speaker":"Calvin","turn_index":13},{"dia_id":"D8:14","global_turn_index":152,"locator":"[S8T14]","raw_turn_sha256":"b70388271be9fdcb936e9a408ccba58ef5004814e28c2d89cd3d16411493c0c4","rendered_turn_sha256":"0f04a6afee801440c0352e282b4a7a6a7874ecfb00448b535b30134a5bc08d5d","session_date":"2023-06-09","session_datetime":"2023-06-09T14:31:00","session_id":"session_8","session_index":8,"source_sha256":"fd84029446301e1d404603cc7d86bfcab4cf3157dab8f29fedad9a176397d4ac","speaker":"Dave","turn_index":14}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Nah, haven't been to the mountains but I'm keen to go. Looking for a way to escape it all and de-stress. I want to go on a hike to a place similar to this. What's new and exciting happening for you, Dave?\n[Image caption: a photo of a plane flying over a mountain range with snow on the top]\n[S8T9] (dia_id: D8:9)\n\nDave: I booked a trip to a mountainous region for next month! Finally gonna be able to see those majestic peaks! Gonna be an amazing experience!\n[S8T10] (dia_id: D8:10)\n\nCalvin: Cool, Dave! Have a great time. I'm sure it's going to be an amazing experience. Take lots of pics and show me when you get back.\n[S8T11] (dia_id: D8:11)\n\nDave: Yep, Calvin! Gonna take lots of pics. Can't wait to show you when I get back!\n[S8T12] (dia_id: D8:12)\n\nCalvin: Have fun exploring the mountains, Dave! Safe travels and see you soon. Take care!\n[S8T13] (dia_id: D8:13)\n\nDave: Thanks, Calvin! Take care, see you soon!\n[S8T14] (dia_id: D8:14)","text_sha256":"348181e58917f27f0e5a46d746220de6e4115db28126fee558e05c33557ea3cd","timestamp":"2023-06-09T14:31:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D1:7"],"kind":"raw_turn","line_end":32,"line_