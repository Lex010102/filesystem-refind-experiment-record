5)","text_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e","timestamp":"2023-10-08T15:13:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D22:7"],"kind":"raw_turn","line_end":34,"line_start":33,"source_locators":["[S22T7]"],"text_sha256":"1f9c962e02107c042c4f8369c564114c82ba95ea02278b9eb7a5ffa9715fd304"}],"dia_ids":["D22:7"],"evidence_id":"ev-ed0cfe3c38d6e0608c254f570b31005b62e4f5ade1dc7371d9d5700c9f60a212","group_id":"session_22","line_end":34,"line_start":33,"observation_ids":["obs-0004"],"path":"/memories/cars-and-auto-work/session-22.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 22","selection_ordinal":4,"session_id":"session_22","source_kind":"raw","source_locators":["[S22T7]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D22:7","global_turn_index":376,"locator":"[S22T7]","raw_turn_sha256":"97481435a1f1b8d343869cecac8aaeb00e4e0e975b054f2f3c028b193c5ded65","rendered_turn_sha256":"1f9c962e02107c042c4f8369c564114c82ba95ea02278b9eb7a5ffa9715fd304","session_date":"2023-10-08","session_datetime":"2023-10-08T15:13:00","session_id":"session_22","session_index":22,"source_sha256":"ed75d8320d1810b91785f6741a2569dce13bf4b713e834e9504a2868e8d44d53","speaker":"Dave","turn_index":7}],"speaker":"Dave","store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Thanks, Calvin. It's been my goal since I was a kid and it's awesome to be able to do something I love. Restoring things like this can be tough but the feeling of accomplishment it gives is great. Absolutely, I'm loving it.\n[S22T7] (dia_id: D22:7)","text_sha256":"1f9c962e02107c042c4f8369c564114c82ba95ea02278b9eb7a5ffa9715fd304","timestamp"