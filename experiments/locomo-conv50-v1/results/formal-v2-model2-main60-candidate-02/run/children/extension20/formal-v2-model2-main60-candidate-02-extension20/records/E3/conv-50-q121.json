023-05-01","session_datetime":"2023-05-01T18:24:00","session_id":"session_4","session_index":4,"source_sha256":"b07c7c593503db0764ee3b75bdd943b95527283f703943114837f74a408c28cc","speaker":"Dave","turn_index":3},{"dia_id":"D4:4","global_turn_index":62,"locator":"[S4T4]","raw_turn_sha256":"a2e07beef204dff22d5f13f327bba177d2f765ac36597a8967dcbffdbf686c8a","rendered_turn_sha256":"5191eaa853bb06f4ea440920a498dcfecc2648b5d621eafac58f715b5729f6ee","session_date":"2023-05-01","session_datetime":"2023-05-01T18:24:00","session_id":"session_4","session_index":4,"source_sha256":"ee7a37b6d50b471c53c64ac51740a422cca1706cc5eef7601286533c712d5921","speaker":"Calvin","turn_index":4},{"dia_id":"D4:5","global_turn_index":63,"locator":"[S4T5]","raw_turn_sha256":"fec2d6dc88a80860b2a31605a05c631d3f7c67ecfa3eb65674b550d354562047","rendered_turn_sha256":"558c132154b911dff23c78b11d023c6b89685b1b5e2f3a7215ba2cab85b5d7ae","session_date":"2023-05-01","session_datetime":"2023-05-01T18:24:00","session_id":"session_4","session_index":4,"source_sha256":"186de17db40b5a5180335dd23bb6af466979b93ad24b6c33787cb7ebeac6594f","speaker":"Dave","turn_index":5}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Hey Calvin, long time no see! A lot's been happening since we last talked. Guess what? I finally opened my own car maintenance shop! It's so satisfying to have a spot to work on cars - it's like a dream come true! Take a look at the photo.\n[Image caption: a photo of a car dealership with cars parked in front of it]\n[S4T1] (dia_id: D4:1)\n\nCalvin: Wow Dave! Congrats on opening your own car maintenance shop! It looks like all your hard work and dedication paid off.\n[Image caption: a photo of a man standing under a car in a garage]\n[S4T2] (dia_id: D4:2)\n\nDave: Thanks, Cal! It's great to see my hard work paying off. Opening this shop was my dream, and I'm really happy to see it getting started. It was a lot of hard work, but it was worth it.\n[S4T3] (dia_id: D4:3)\n\nCalvin: Woo, Dave! Congrats on achieving your dream - you've got guts and ambition - that's awesome! Keep it up!\n[Image caption: a photo of a book with a space theme on it]\n[S4T4] (dia_id: D4:4)\n\nDave: Thanks! Appreciate the support. My dream was to open a shop and it's a step towards my other dream of working on classic cars. I love their design and engineering.\n[S4T5] (dia_id: D4:5)","text_sha256":"a1b5d2b460314ea4ddc7f39fc10315109b7944044e4a81094151fbee5fa50729","timestamp":"2023-05-01T18:24:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D5:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S5T1]"],"text_sha256":"9c915f2f720758f1aa69f85fb7031406f5a908a381aee36bcf2d23718843c282"},{"dia_ids":["D5:2"],"kind":"raw_turn","line_end":18,"line_start":16,"source_locators":["[S5T2]"],"text_sha256":"336332abff03e5f7b2a1fe35516f1bfe526ca19cb7a38eeeff144ca466d52b46"},{"dia_ids":["D5:3"],"kind":"raw_turn","line_end":22,"line_start":20,"source_locators":["[S5T3]"],"text_sha256":"a25cd32818a9be4a8398a4723f9944448d406631a9818161bf7b4c014fd2adec"},{"dia_ids":["D5:4"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S5T4]"],"text_sha256":"4b88c4089b91f031a19b310c2dbc5b0d5c438403f60587ccdf81181213a4148a"},{"dia_ids":["D5:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S5T5]"],"text_sha256":"95b51e9c382d11641d8cc39f743c473a109b3611538ef8967014388813d1f795"}],"dia_ids":["D5:1","D5:2","D5:3","D5:4","D5:5"],"evidence_id":"ev-8c21df7b9ba33d1932d1283ca3b13654db2e3f64ad98644ecc454c58eccf5f63","group_id":"session_5","line_end":28,"line_start":12,"observation_ids":["obs-0004"],"path":"/memories/cars-and-auto-work/session-05.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":7,"schema_version":1,"sco