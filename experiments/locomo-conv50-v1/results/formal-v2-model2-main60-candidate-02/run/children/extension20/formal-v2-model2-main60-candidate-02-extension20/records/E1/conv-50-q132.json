_index":10}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Cool, Calvin! Art is amazing how it reflects the world. Has anything caught your eye lately and made an impact on your music?\n[S25T9] (dia_id: D25:9)\n\nCalvin: Yeah, for sure! Recently, I've been really inspired by some of the struggles that people go through. It's made me dig deeper into my music to try to capture those feelings.\n[S25T10] (dia_id: D25:10)","text_sha256":"203653827f000a1c8aa664d096e920281c51fbe00c494b15766203e5a421678f","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D30:4"],"kind":"raw_turn","line_end":25,"line_start":23,"source_locators":["[S30T4]"],"text_sha256":"14161632c0a069b715f5bc5a1014a63e47232a27d78c57c1de98618d39c7cc32"}],"dia_ids":["D30:4"],"evidence_id":"ev-7926e158432b61cbbdaa97bf0e52d4d477bf60b761ca291b769882492df936a6","group_id":"session_30","line_end":25,"line_start":23,"observation_ids":["obs-0008"],"path":"/memories/session-30.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":7,"schema_version":1,"score":null,"section":"# Session 30","selection_ordinal":2,"session_id":"session_30","source_kind":"raw","source_locators":["[S30T4]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D30:4","global_turn_index":548,"locator":"[S30T4]","raw_turn_sha256":"047fb341d22060b2dc5c74662a7f0da812f02feccd46797263116229c9675beb","rendered_turn_sha256":"14161632c0a069b715f5bc5a1014a63e47232a27d78c57c1de98618d39c7cc32","session_date":"2023-11-17","session_datetime":"2023-11-17T10:54:00","session_id":"session_30","session_index":30,"source_sha256":"f6581ca0fda28ca2550e873abea9aaa6fb040b09df4f1d04c068c7dcb3c19904","speaker":"Calvin","turn_