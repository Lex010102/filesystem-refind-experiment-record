dex":15},{"dia_id":"D6:16","global_turn_index":117,"locator":"[S6T16]","raw_turn_sha256":"84999ae2b9f40513175ac69b657dec1c96b4c5d3f83540fd17d623197985821c","rendered_turn_sha256":"b7acfb23bb5b4b59cbae5bc333d6730fbd50f5fafc60cd4f04f938eb093f904f","session_date":"2023-05-16","session_datetime":"2023-05-16T11:50:00","session_id":"session_6","session_index":6,"source_sha256":"6b00cb2ec6c5024d65b12a86bf2f6eab779228211769df782cad6d69e7f2d1d6","speaker":"Dave","turn_index":16}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Thanks, Dave! Can't wait to get back to making music. Anything exciting you're working on these days?\n[S6T7] (dia_id: D6:7)\n\nDave: I'm so excited, I opened my car shop last week! Invited some friends over to celebrate and it's been amazing. Super stoked to share my passion and help out with folks' rides. It's been incredible so far.\n[S6T8] (dia_id: D6:8)\n\nCalvin: Way to go, Dave! Congrats on opening your own car shop! Your excitement is contagious. Keep up the great work!\n[S6T9] (dia_id: D6:9)\n\nDave: Thanks, Calvin! Your support is greatly appreciated. It's been quite a journey so far, and I'm excited to see what the future holds. How about you? Anything exciting happening in the world of music for you?\n[S6T10] (dia_id: D6:10)\n\nCalvin: Thanks Dave! Super excited for my upcoming performance in Tokyo this month. It's gonna be great to show my music to a whole new crowd and hopefully expand my following!\n[S6T11] (dia_id: D6:11)\n\nDave: Cool, Cal! Doing a show in Tokyo, wow! I'm sure the audience is gonna love it. Wishing you all the luck! Let me know how it goes.\n[S6T12] (dia_id: D6:12)\n\nCalvin: Sure thing, Dave! I'll keep you posted on how it goes. Thanks for the good luck! Look what a wonderful night! \n\n[Image caption: a photo of a city at night with a lot of lights]\n[S6T13] (dia_id: D6:13)\n\nDave: That looks great! Where did you snap that pic?\n[S6T14] (dia_id: D6:14)\n\nCalvin: I took that pic in Tokyo last night. The skyline was stunning!\n[S6T15] (dia_id: D6:15)\n\nDave: Wow, great shot! The night skyline really pops with those city lights. I gotta take a trip there soon!\n[S6T16] (dia_id: D6:16)","text_sha256":"fdf83900473b81da37ab81a4a6884b6b4f3df0fdeb487dd16f410afe032fa658","timestamp":"2023-05-16T11:50:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D1:9"],"kind":"raw_turn","line_end":41,"line_start":37,"source_locators":["[S1T9]"],"text_sha256":"c59a0553a8abb9547159fd481e9f4b13f3cc69d672dd7d04ba558c3c32c27b4a"},{"dia_ids":["D1:10"],"kind":"raw_turn","line_end":44,"line_start":43,"source_locators":["[S1T10]"],"text_sha256":"876c827328ae6e3e826078effe24bd56be64d5931af4c286cd9222cd592b19dc"},{"dia_ids":["D1:11"],"kind":"raw_turn","line_end":47,"line_start":46,"source_locators":["[S1T11]"],"text_sha256":"b933fcad816e26bb950513c0d4cdc504caacb30fff2cbdff7c4ca016e89c876e"},{"dia_ids":["D1:12"],"kind":"raw_turn","line_end":50,"line_start":49,"source_locators":["[S1T12]"],"text_sha256":"200eaf0901ae6daaac33831769c7211d87adcc8d17ec302d2d3793d583d83945"},{"dia_ids":["D1:13"],"kind":"raw_turn","line_end":53,"line_start":52,"source_locators":["[S1T13]"],"text_sha256":"33e8c705c2f3cd413d28700e1ec030b59b527033d4549d832ed3e841df20e43d"},{"dia_ids":["D1:14"],"kind":"raw_turn","line_end":56,"line_start":55,"source_locators":["[S1T14]"],"text_sha256":"349c399793bc72a5379077525846c83882e35e12ad7c330b7f7754bc4d1166cb"},{"dia_ids":["D1:15"],"kind":"raw_turn","line_end":59,"line_start":58,"source_locators":["[S1T15]"],"text_sha256":"59eeb2ff0f728bd888ab7b22227e8479b7367d48284d027a762b23f502516f89"},{"dia_ids":["D1:16"],"kind":"raw_turn","line_end":63,"line_start":61,"source_locators":["[S1T16]"],"text_sha256":"9fa516ac77a3d1018f4a30dc0275e9e0ffd3a03c9d481481ceb191722f14e2b0"},{"dia_ids":["D1:17"],"kind":"raw_turn","line_end":66,"line_