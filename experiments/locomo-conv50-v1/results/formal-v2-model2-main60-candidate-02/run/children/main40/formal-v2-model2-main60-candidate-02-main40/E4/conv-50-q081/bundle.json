6":"4d8ed914b0f62ebc3d9f7830b1f1988f10a21a411d7f5164802bce9b153b07a5","speaker":"Dave","turn_index":13},{"dia_id":"D5:14","global_turn_index":100,"locator":"[S5T14]","raw_turn_sha256":"e871252774c0be6961b579a60c7163fc7474295871f1da2f2ee5672adcf8cd4c","rendered_turn_sha256":"19c95846f3d58109c5673ab9f61a4d3ade334d202716352745d047b69da9b791","session_date":"2023-05-03","session_datetime":"2023-05-03T13:16:00","session_id":"session_5","session_index":5,"source_sha256":"44c364190392e074eaf3fdd3230c179205b93723dea32f252927d76f71c62f95","speaker":"Calvin","turn_index":14},{"dia_id":"D5:15","global_turn_index":101,"locator":"[S5T15]","raw_turn_sha256":"abbcd602be04d4f34196bdfb3255a5396c32888a8832ba1276e61fcdaa530f77","rendered_turn_sha256":"54744b26318c8d1048e979362dde9c30ab175c7419386929e15cc19eb8b110e6","session_date":"2023-05-03","session_datetime":"2023-05-03T13:16:00","session_id":"session_5","session_index":5,"source_sha256":"0e7eff8a113fbfa312df7ea504503711b358883f18315e03ecab1d2de4df850d","speaker":"Dave","turn_index":15}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Thanks, Calvin! Gotta take time to chill. Do you have any hobbies that help you relax?\n[S5T7] (dia_id: D5:7)\n\nCalvin: Hey Dave, long drives in [this car] really help me relax. The feeling of the wind and the open road is so freeing. It helps me clear my head. What do you like to do to chill out? \n[Image caption: a photo of a red sports car driving down a road]\n[S5T8] (dia_id: D5:8)\n\nDave: Yeah, I hear you! Driving with the wind in your hair is so calming. Taking a walk around is a great way to destress, too. Exploring, taking in the sights and sounds - it's such a peaceful experience.\n[S5T9] (dia_id: D5:9)\n\nCalvin: Yea, I totally hear ya. Embracing nature has been really calming for me too. I've been loving getting to know Japanese culture. On the other hand, I'm stuck with my music at the moment, like my creativity's frozen or something. Any tips?\n[S5T10] (dia_id: D5:10)\n\nDave: If I'm having trouble coming up with ideas, I usually immerse myself in something I love, like concerts or my favorite albums. Doing that usually helps to jumpstart my inspiration. Maybe try taking a break from music and explore other things. Plus, have some fun while you're at it!\n[S5T11] (dia_id: D5:11)\n\nCalvin: Thanks, Dave! Taking a break is great for getting my mojo back. I'll definitely take your advice and explore. Appreciate the help! You're awesome!\n[S5T12] (dia_id: D5:12)\n\nDave: No worries, Calvin! Glad I could help. Keep pursuing your music and never give up. You're awesome! 🤘\n[S5T13] (dia_id: D5:13)\n\nCalvin: Thanks, appreciate it. Won't give up. Let's stay in touch! Bye!\n[S5T14] (dia_id: D5:14)\n\nDave: Sure, Calvin! Keep in touch. If you ever need help, just let me know. Bye!\n[S5T15] (dia_id: D5:15)","text_sha256":"d7f23009df83959513650c6f955b4cf533e8ac37bbc8fc45d5571589d6805034","timestamp":"2023-05-03T13:16:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D28:27"],"kind":"raw_turn","line_end":105,"line_start":103,"source_locators":["[S28T27]"],"text_sha256":"574c6f0ede34431d520e23bc2a0cf7da0d339dd507f4b9d08284caa635102f2e"},{"dia_ids":["D28:28"],"kind":"raw_turn","line_end":108,"line_start":107,"source_locators":["[S28T28]"],"text_sha256":"2b000439357127aef448b1b74be06b74dcc2fedbbec4a7ac351d0494186a442f"},{"dia_ids":["D28:29"],"kind":"raw_turn","line_end":112,"line_start":110,"source_locators":["[S28T29]"],"text_sha256":"a829903fe412dc5676fe7f58b398042449057a31101db01b22585cb392b71e6e"},{"dia_ids":["D28:30"],"kind":"raw_turn","line_end":115,"line_start":114,"source_locators":["[S28T30]"],"text_sha256":"415478bec67864151ee87b6cc5d6674dbc8a423fdf2a6d739b08c47b6d12f101"},{"dia_ids":["D28:31"],"kind":"raw_turn","line_end":118,"line_start":117,"source_locators":["[S28T31]"],"text_sha