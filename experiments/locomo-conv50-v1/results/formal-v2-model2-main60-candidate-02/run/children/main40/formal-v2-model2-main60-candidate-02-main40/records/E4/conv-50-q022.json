dex":6},{"dia_id":"D3:7","global_turn_index":47,"locator":"[S3T7]","raw_turn_sha256":"13d8226372b5116d2a30d8d09830fa24de4800f74f91eabdfb3b8e7c8357d361","rendered_turn_sha256":"3b5882ccb2181b4c0bc85727fd1375106260cabee5c80792ad404817c7c22e81","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"3ce04b19fe297482b2631dffaed914a8f15f5055c360d55099026090041740bb","speaker":"Calvin","turn_index":7},{"dia_id":"D3:8","global_turn_index":48,"locator":"[S3T8]","raw_turn_sha256":"b6d3d0ae10fff267d8fdd8d050619d3e108692235a4e05d4da4cf3b85376a12d","rendered_turn_sha256":"a31f66ec5d22f29dfda703d4ad8743edfd7aa52641f25b4d10fb59c5076c6fd1","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"2ee98340622da9749a14d068d728747d047bdbfc66ccf824d4ccc431e1b028f7","speaker":"Dave","turn_index":8},{"dia_id":"D3:9","global_turn_index":49,"locator":"[S3T9]","raw_turn_sha256":"9b39cb9683a9303eab161ae8f19a4d8814a8783d2c7d2ba9af85097332750ff4","rendered_turn_sha256":"f17875332892d0e9b3209ad7e83d0c269dd5e8b57dfe4fe81f10eadbe9eaa4fb","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"c7080bdcea041910c1b0fffb2b6be51a7ac8b3e62c569507a76439bddfa965ea","speaker":"Calvin","turn_index":9},{"dia_id":"D3:10","global_turn_index":50,"locator":"[S3T10]","raw_turn_sha256":"8d196d0b8e954218b9478ba675b394e2f2f414c661dbe3dce833d3c8edf45494","rendered_turn_sha256":"629f54b61cc2f38c59f8f6e8048c8f445f83ee4eea4d24dc26797eee1302b016","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"db66e8779394dc8e5e4d7130934385953d1465c6f03c4184cbd3690cc2526fdd","speaker":"Dave","turn_index":10}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! Long time no see. I just went to an awesome music thingy in Tokyo - so cool!\n[S3T1] (dia_id: D3:1)\n\nDave: Hey Calvin! Great to hear from you. How was the music thingy in Tokyo? See any cool bands?\n[S3T2] (dia_id: D3:2)\n\nCalvin: Hey Dave! The festival in Tokyo was awesome! Didn't see any bands, but met lots of talented artists and industry people. Totally enriching!\n[S3T3] (dia_id: D3:3)\n\nDave: Wow, Calvin, sounds great! What did you learn from it?\n[S3T4] (dia_id: D3:4)\n\nCalvin: I learned a lot and got some great advice from professionals in the music industry. It was inspiring!\n[S3T5] (dia_id: D3:5)\n\nDave: Wow, Calvin! Bet that was inspiring being surrounded by professionals. Did you get any advice from them?\n[S3T6] (dia_id: D3:6)\n\nCalvin: The producer gave me some advice to stay true to myself and sound unique. It got me thinking about where I want my music to go. It's really motivating!\n[S3T7] (dia_id: D3:7)\n\nDave: Wow, Calvin! It's really motivating to see you staying true to yourself. It got me thinking, where do you see your music taking you?\n[S3T8] (dia_id: D3:8)\n\nCalvin: Thanks, Dave! I'm dreaming of touring the world, performing for different people and connecting with them. I hope my music can reach a global audience and make an impact. I'm also looking forward to my upcoming trip to Boston after I finish the Frank Ocean tour. I've heard that the music scene there is awesome, so I can't wait to check it out!\n[S3T9] (dia_id: D3:9)\n\nDave: Sounds like an amazing plan, Cal! I can't wait for your trip to Boston. I'll show you around town and all the cool spots. The music scene there is awesome, with places like Paradise Rock, House of Blues, and Fenway Park. You'll definitely have some great performances there. Count me in for the front row when you're up onstage! Oh, and by the way, check out this pic.\n[Image caption: a photography of a city skyline with a boat in the water]\n[S3T10] (dia_id: D3:10)","text_sha256":"1ba02a32541b071eff8deea6b7b7de8335116afef08dd94110252748c73c0c80","timestamp":"2023-04-20T16:15:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D25:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S25T1]"],"text_sha256":"534a37a1a11f8a414aa936d18009605559d2bea07cf07bca898c41c23924a598"},{"dia_ids":["D25:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S25T2]"],"text_sha256":"763d6ad9a0417ef2e95795e2c757f1451bf692c48f602f87582d58cc5d67ab34"},{"dia_ids":["D25:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S25T3]"],"text_sha256":"475867cbac5a508a43cb1e4b3df21441c121ac75fe946d4828627a24bdf76e4f"},{"dia_ids":["D25:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S25T4]"],"text_sha256":"d14b99328b8d746c386132e20bf96cf7a6542aa5f3c167237d52c5ba26fd076e"},{"dia_ids":["D25:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S25T5]"],"text_sha256":"5a5c149bbacdbad1c65970030b41bdcd9904b16cd3c56993d693157fb56c2329"},{"dia_ids":["D25:6"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S25T6]"],"text_sha256":"13443fb62a97f45dded22cc9c6936eb06c2d85ec31c6cd321bd4aa6bc72b2ad0"}],"dia_ids":["D25:1","D25:2","D25:3","D25:4","D25:5","D25:6"],"evidence_id":"ev-56347826a738c8ee0919e5967d9c9d6abdd717f237d876bfb03cb895c090cf5f","group_id":"session_25","line_end":28,"line_start":12,"observation_ids":["obs-0002"],"path":"/memories/music-and-performance/session-25.md","query_terms":["famou","fame","recognition","audience"],"rank":1,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":4,"schema_version":1,"score":0.03252247488101534,"section":"# Session 25","selection_ordinal":3,"session_id":"session_25","source_kind":"raw","source_locators":["[S25T1]","[S25T2]","[S25T3]","[S25T4]","[S25T5]","[S25T6]"],"source_map_sha256":"6e991159