ime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"9b5e5fd72dfb2448855e660566f8487f8609329927d42edd1cd51cf75a5b7127","speaker":"Calvin","turn_index":2}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Hey Calvin, how's the tour with Frank Ocean? I was pondering our chat the other day about fame and its impact on relationships. It must be awesome but it must have its own struggles too. How are you juggling your job plus your personal life?\n[S25T1] (dia_id: D25:1)\n\nCalvin: The tour's been incredible! Performing and connecting with the crowd has been so energizing. Yeah, fame has its own challenges. It's been tough trying to balance everything.\n[S25T2] (dia_id: D25:2)","text_sha256":"eef00100d672512a76ec043b0ff02bb47d0568b81d935898aed1f39c00c2162b","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D12:11"],"kind":"raw_turn","line_end":46,"line_start":44,"source_locators":["[S12T11]"],"text_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708"}],"dia_ids":["D12:11"],"evidence_id":"ev-ab2293b7ff576dddbd3ba5bfc7b90bf62c30d84e88d36844822756efdcd7c9b0","group_id":"session_12","line_end":46,"line_start":44,"observation_ids":["obs-0009"],"path":"/memories/cars-and-auto-work/session-12.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":11,"schema_version":1,"score":null,"section":"# Session 12","selection_ordinal":4,"session_id":"session_12","source_kind":"raw","source_locators":["[S12T11]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D12:11","global_turn_index":215,"locator":"[S12T11]","raw_turn_sha256":"8029c75f90dad86c772ede6e12447a8eef9abf6600d0b73efab389ae32f92fed","rendered_turn_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"24c639fe61ad09000cae9e993e46e94d45cb7d8f2edc5a0ee367b35a94649653","speaker":"Calvin","turn_index":11}],"speaker":"Calvin","store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: My plan for now is to expand my brand worldwide and grow my fanbase. I want my music to reach more people and make an impact. Working with artists from around the globe and challenging myself to create special music are goals of mine too. Look at the photo of how I performed with the boys last night, they are great at the music!\n[Image caption: a photo of a band playing on stage with lights on]\n[S12T11] (dia_id: D12:11)","text_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708","timestamp":"2023-08-03T13:12:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D3:9"],"kind":"raw_turn","line_end":37,"line_start":36,"source_locators":["[S3T9]"],"text_sha256":"f17875332892d0e9b3209ad7e83d0c269dd5e8b57dfe4fe81f10eadbe9eaa4fb"}],"dia_ids":["D3:9"],"evidence_id":"ev-635915ea518ac80c9d913b40198cd947d66696870fcf87d0dacc8f37901b0f72","group_id":"session_3","line_end":37,"line_start":36,"observation_ids":["obs-0014"],"path":"/memories/music-and-performance/session-03.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":11,"schema_version":1,"score":null,"section":"# Session 3","selection_ordinal":5,"session_id":"session_3","source_kind":"raw","source_locators":["[S3T9]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D3:9","global_turn_index":49,"locator":"[S3T