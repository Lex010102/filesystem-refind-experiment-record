w_turn_sha256":"9d84cb176f4ff323adb3abf8e0f86ef0f82880c19aca14b2cdd0968effe48299","rendered_turn_sha256":"b02d8b8796c00898b84f7efd6764c3632f0c2df9d63fff4bbe8524acace92c45","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"ffcbece09e4624e7a6c49c11ecc7f720cc620ec811989a5a1db361adb068c030","speaker":"Dave","turn_index":10},{"dia_id":"D12:11","global_turn_index":215,"locator":"[S12T11]","raw_turn_sha256":"8029c75f90dad86c772ede6e12447a8eef9abf6600d0b73efab389ae32f92fed","rendered_turn_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"24c639fe61ad09000cae9e993e46e94d45cb7d8f2edc5a0ee367b35a94649653","speaker":"Calvin","turn_index":11},{"dia_id":"D12:12","global_turn_index":216,"locator":"[S12T12]","raw_turn_sha256":"1063a453421dd6444610b8758887401d2b2f9b1ccd87dad1deb0c7d8ea9da7a5","rendered_turn_sha256":"0e61f48d58c9a03b7b15c8e4c4672af272da2e18aa8423c3300fe2198bbc00e9","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"c2dc9e6830ab6259845c8592bcd52268b5523d8b2b4ef8f585aa3ba3d92ff291","speaker":"Dave","turn_index":12}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave, long time no see! I just took my Ferrari for a service and it was so stressful. I'm kinda attached to it. Can you relate? What kind of hobbies give you a feeling of being restored?\n[S12T1] (dia_id: D12:1)\n\nDave: Hey Calvin, I understand the stress of getting a car serviced. Fixing cars is like therapy for me. Growing up working on cars with my dad, refurbishing them gives me a sense of fulfillment.\n[S12T2] (dia_id: D12:2)\n\nCalvin: Wow, Dave, that's awesome! Must feel great to have a hobby that makes you proud. Remember any good memories from working on cars with your dad?\n[S12T3] (dia_id: D12:3)\n\nDave: Yeah, definitely! I have fond memories of working on cars with my dad as a kid. We spent one summer restoring an old car. It was hard work, but seeing the end result and knowing that we did it together was really satisfying.\n[S12T4] (dia_id: D12:4)\n\nCalvin: That's awesome, Dave! Working together on projects like that really brings people closer. Do you have any pictures from that time?\n[S12T5] (dia_id: D12:5)\n\nDave: Yes, I have one, take a look. It was a wonderful experience.\n[Image caption: a photography of a man and a child pose for a picture]\n[S12T6] (dia_id: D12:6)\n\nCalvin: Aww, that's cool, Dave. Reminiscing is always fun! That pic you shared takes me back to my trip to the Ferrari dealership. I saw a lot of amazing cars, but as for me, my car is the best and  I'm pretty proud of this. Sure, it's just material, but it reminds me of my hard work and dedication. It really inspires me. Take a look at this beauty!\n[Image caption: a photography of a red car is lifted on a lift in a garage]\n[S12T7] (dia_id: D12:7)\n\nDave: Your car looks great, Calvin! I can tell why you're proud. Having something like that is motivating. It's like a reminder of what you can achieve.\n[S12T8] (dia_id: D12:8)\n\nCalvin: Thanks, Dave! Seeing it everyday keeps me motivated and reminds me to keep pushing.\n[S12T9] (dia_id: D12:9)\n\nDave: Sounds like you're really motivated, Calvin. What's the biggest goal you're working towards, music-wise or something else?\n[S12T10] (dia_id: D12:10)\n\nCalvin: My plan for now is to expand my brand worldwide and grow my fanbase. I want my music to reach more people and make an impact. Working with artists from around the globe and challenging myself to create special music are goals of mine too. Look at the photo of how I performed with the boys last night, they are great at the music!\n[Image caption: a photo of a band playing on stage with lights on]\n[S12T11] (dia_id: D12:11)\n\nDave: Wow, Calvin! Working with different artists and crafting great sounds will definitely help you reach your goals. Keep it up and keep making a difference!\n[S12T12] (dia_id: D12:12)","text_sha256":"d1c0db58689f6c9bbea2f57bd84bab1d0912074797c930691f53699b1d2c04cb","timestamp":"2023-08-03T13:12:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D4:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S4T5]"],"text_sha256":"558c132154b911dff23c78b11d023c6b89685b1b5e2f3a7215ba2cab85b5d7ae"},{"dia_ids":["D4:6"],"kind":"raw_turn","line_end":32,"line_start":30,"source_locators":["[S4T6]"],"text_sha256":"e472be1b48305feec6f5e2cd042b0bf8748abec8b718542ec46062aeeee2d75e"},{"dia_ids":["D4:7"],"kind":"raw_turn","line_end":36,"line_start":34,"source_locators":["[S4T7]"],"text_sha256":"8f6f3e5bf7a18c8a3f29a35ba37cd9ac6faa9a92bccaac80e36d081f0af648ae"},{"dia_ids":["D4:8"],"kind":"raw_turn","line_end":39,"line_start":38,"source_locators":["[S4T8]"],"text_sha256":"5804381d0e302374774256c317d154d31f47fb67acb32be5655521a4cd974523"},{"dia_ids":["D4:9"],"kind":"raw_turn","line_end":42,"line_start":41,"source_locators":["[S4T9]"],"text_sha256":"72403767bf55ef636ec52dafccbd6733599f221b31d712ce05f36ebc8afecc9c"},{"dia_ids":["D4:10"],"kind":"raw_turn","line_end":45,"line_start":44,"source_locators":["[S4T10]"],"text_sha256":"4c0487e30e9bca08d7792d7f933d6272c028cdeea9a71f6dd5c040caa8fa1ce2"},{"dia_ids":["D4:11"],"kind":"raw_turn","line_end":48,"line_start":47,"source_locators":["[S4T11]"],"text_sha256":"7208cb15392259e171d428abe3b161ef9e775b710f6333a3f5a2d18a9cb07fbd"},{"dia_ids":["D4:12"],"kind":"raw_turn","line_end":51,"line_start":50,"source_locators":["[S4T12]"],"text_sha256":"28ea29b9d1a14fa7cca89b909af05dfedcc945e6a8d84cf0e7f1f03205389f78"},{"dia_ids":["D4:13"],"kind":"raw_turn","line_end":54,"line_start":53,"source_locators":[