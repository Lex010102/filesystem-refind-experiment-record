c718aeeaac8","rendered_turn_sha256":"d94c796a816db5e33e791bea751862e20a15b44f4ea430351490c5837c1fb68d","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"e201fef0500c99fa1972ede46cd30e31ec3035cac585f1fdc29f3310bc39f7bd","speaker":"Dave","turn_index":4},{"dia_id":"D21:5","global_turn_index":356,"locator":"[S21T5]","raw_turn_sha256":"6c86ba106c7326abedba570a352ca0a833c5342d18af7fa4a057cf2345d1b4d6","rendered_turn_sha256":"52da6afe2a9f0cff62231bba0eae15a078d74aa923b880abe272e6f17c7a682b","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"d51e95731907f6327e6bffbd4044ba20b67a4ba3b3c76109454f75f25b64b50d","speaker":"Calvin","turn_index":5},{"dia_id":"D21:6","global_turn_index":357,"locator":"[S21T6]","raw_turn_sha256":"38afaceb17a3b8fc70c8a896bc402e1436a0310698f119a70b5b380d6aa91ae7","rendered_turn_sha256":"18ddc1dac20ed924705f00f17e262e027897c7b798eeb9f09beeafdc06753c7c","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"aa233e2489600f1e4fbd697b18281d94089809b49606974b9313f8de9a8366b2","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! Yesterday I met with some incredible artists in Boston and we talked about working together. It was such an inspiring and exciting experience - they all have individual styles and I'm stoked to collaborate with them on new music.\n[S21T1] (dia_id: D21:1)\n\nDave: Awesome, Calvin! Connecting with all those talented artists must have been an inspiring experience. Can't wait to hear what you come up with in your collaboration. Let me know how it goes! Also, how did you arrange that meeting?\n[S21T2] (dia_id: D21:2)\n\nCalvin: Hey Dave, it was awesome talking to those artists! Our mutual friend knew we'd be a great fit. Can't wait to show you the final result. Also, check out this project - I love working on it to chill out. How about you? Got any hobbies to help you relax?\n[Image caption: a photo of a shiny orange car with a hood open]\n[S21T3] (dia_id: D21:3)\n\nDave: Wow, Calvin, that car looks great! Working on cars really helps me relax, it's therapeutic to see them come back to life. I've been working on that Ford Mustang I found in a junkyard - it was in bad shape, but I knew it had potential.\n[S21T4] (dia_id: D21:4)\n\nCalvin: Wow, Dave! It's awesome that you can bring things back to life. Do you have any pictures of it looking amazing? I'd love to see how it turned out!\n[S21T5] (dia_id: D21:5)\n\nDave: Hey Calvin, check out this photo! I put in a lot of work restoring it, but the result is awesome. It's so satisfying to bring an old car back to life.\n[Image caption: a photography of a red car parked in a field with other cars]\n[S21T6] (dia_id: D21:6)","text_sha256":"a864e16f80acb360e6c046900588d5912d99767c18876cbddd8a8e2eb810c841","timestamp":"2023-10-04T14:44:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D17:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S17T3]"],"text_sha256":"0dba7d209dd664bef1fe17b08c6de202fa925bedaadae948dabbec93f3a15bf1"},{"dia_ids":["D17:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S17T4]"],"text_sha256":"235b6188f1872a157955b103c48ff0307c6f21c6e75f6bafbf5d72586b24b44c"},{"dia_ids":["D17:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S17T5]"],"text_sha256":"690a3fcfd4a95e85516b4143d04a34e1d7ec384f1577b598de27a1a188a8273b"},{"dia_ids":["D17:6"],"kind":"raw_turn","line_end":29,"line_start":27,"source_locators":["[S17T6]"],"text_sha256":"baf8f68059bd17fd0c90b6ec79c86dfb8f3280ff4542797c2f57c414d2e6daa4"},{"dia_ids":["D17:7"],"kind":"raw_turn"