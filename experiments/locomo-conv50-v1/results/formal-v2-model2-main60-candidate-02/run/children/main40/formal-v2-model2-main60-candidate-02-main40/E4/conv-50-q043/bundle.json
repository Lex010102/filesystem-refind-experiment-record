sha256":"d0965c1af0be2fc3011e294eb653117a16b996e44c8eb6d887a518ed79c896d4","session_date":"2023-09-02","session_datetime":"2023-09-02T09:19:00","session_id":"session_17","session_index":17,"source_sha256":"b068b79defabd581c9cae3bd591231f9e3bb1b6df21092ff958d118efa854a7c","speaker":"Calvin","turn_index":8},{"dia_id":"D17:9","global_turn_index":305,"locator":"[S17T9]","raw_turn_sha256":"c70cb0cb22918a39e2a9ca2abd9defe0f20d14393f38072144df96af1f20001e","rendered_turn_sha256":"ac7ec0e92adb6a797b7dc46332496cf550105f5965cf805f033867bf14818f39","session_date":"2023-09-02","session_datetime":"2023-09-02T09:19:00","session_id":"session_17","session_index":17,"source_sha256":"4989153e537670734a95456bc2892cd6cc2d1f38c5f00149e88f96dfbaf1b2a8","speaker":"Dave","turn_index":9},{"dia_id":"D17:10","global_turn_index":306,"locator":"[S17T10]","raw_turn_sha256":"0076ccb2c30de1b4c40c4b1c69c9371d3956207a8b4fe8324a08ed75a0e10f1f","rendered_turn_sha256":"2d11fb213a0ed5354b561627480e8dd9277ec5cf438679e5a72ae590dcf438a1","session_date":"2023-09-02","session_datetime":"2023-09-02T09:19:00","session_id":"session_17","session_index":17,"source_sha256":"4eddd1ed77b5d63a744a5e6951acd3628182fdaa3e9fa9cf42b5cbb8ac321fbe","speaker":"Calvin","turn_index":10}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Yeah, it's great fixing stuff up and seeing it turn out better. It's really rewarding and gives me a sense of purpose. Plus, it feels like I'm making a difference when I fix someone's car.\n[S17T3] (dia_id: D17:3)\n\nCalvin: Wow, you must feel great making a real difference in someone's life, like being their superhero!\n[S17T4] (dia_id: D17:4)\n\nDave: Yeah, it's great! It feels really good to make a difference and see their relief when their car is fixed. Makes me proud!\n[S17T5] (dia_id: D17:5)\n\nCalvin: Wow, Dave, that's awesome! You should be really proud of yourself for bringing joy to others. I booked a flight ticket to Boston last week! I'm so excited about my upcoming trip to Boston. Look at this! See you soon, buddy!\n[Image caption: a photo of a book with a boarding pass and a boarding pass]\n[S17T6] (dia_id: D17:6)\n\nDave: Cool! Let me know when you're free and we can catch up in Boston.\n[S17T7] (dia_id: D17:7)\n\nCalvin: Yeah, for sure! I'll let you know when I'm in Boston. See you soon!\n[S17T8] (dia_id: D17:8)\n\nDave: Looking forward to seeing you! Have a safe trip, see ya!\n[S17T9] (dia_id: D17:9)\n\nCalvin: Thanks, Dave! Gotta stay safe on the trip. Can't wait to see you there! I will contact you when I arrive. Goodbye!\n[S17T10] (dia_id: D17:10)","text_sha256":"3396ae9e097fedb086fa30f8cc66eb4f731fa4118508a8cbc70e17f7612b7bca","timestamp":"2023-09-02T09:19:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D30:15"],"kind":"raw_turn","line_end":63,"line_start":62,"source_locators":["[S30T15]"],"text_sha256":"ee01e79daa26414c690ed8a25b8a9507c40790b02fb7a9448db9b63676becae1"},{"dia_ids":["D30:16"],"kind":"raw_turn","line_end":67,"line_start":65,"source_locators":["[S30T16]"],"text_sha256":"57d17eb8b49edd96cfbd891ba3b0d779193a183c33868a8a1635af4fc6ffcbe4"},{"dia_ids":["D30:17"],"kind":"raw_turn","line_end":70,"line_start":69,"source_locators":["[S30T17]"],"text_sha256":"7353599b7b6aa3add9369386fe63e573e57fc33f1c754c64ebafaf9813e2f7e3"},{"dia_ids":["D30:18"],"kind":"raw_turn","line_end":73,"line_start":72,"source_locators":["[S30T18]"],"text_sha256":"93903ca5fc66f1393cd949d9b5697e4670e937d73832ba642dde79a5b6108a6b"},{"dia_ids":["D30:19"],"kind":"raw_turn","line_end":76,"line_start":75,"source_locators":["[S30T19]"],"text_sha256":"d3409c3c5b5ad2ce128f16214d25059802667ef86a148b8fe79d16a7062bf441"},{"dia_ids":["D30:20"],"kind":"raw_turn","line_end":79,"line_start":78,"source_locators":["[S30T20]"],"text_sha256":"e1b22e39f7f68eb9f1e020b731b2c13b7e9a46b058265b08cc1805db823aafe3"