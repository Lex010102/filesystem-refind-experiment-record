97c96dc759ae21d9cefb2d7bccc52b7ae028bc547c5dc","rendered_turn_sha256":"6cb6cf5ea8294054773693965039bc932d88643be5121e22ea59e1daa8b3b68f","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"21261e9fa6f8228d4b689e0b3b9fbe643e75bf4f054b34f946e0a3cb6e40bb1e","speaker":"Dave","turn_index":13},{"dia_id":"D16:14","global_turn_index":285,"locator":"[S16T14]","raw_turn_sha256":"313d200cbcdaaf261054ae577881e3d2c5309b306388136e9ad1d47532a11644","rendered_turn_sha256":"a2972e43089782aa5691d60a04cae08e9e39cba4de92c819afd98ade293f5591","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"81c04bd7c0a7d0b58bf286a8a3cd35ea5c236990e466854c830468b80f76065c","speaker":"Calvin","turn_index":14},{"dia_id":"D16:15","global_turn_index":286,"locator":"[S16T15]","raw_turn_sha256":"0e9a5af45489e61bdd857cf7a11c45c0182c7ec1f484537c7dbd987178eadb9f","rendered_turn_sha256":"17d18dfa5dad6374ec64794b3e9a110d0b22fdcc1fb0d58e0a88a743730088c6","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"9c26739f0017968ad53af14c1117cac382e0de173bd2527879ba41bedcc7bba7","speaker":"Dave","turn_index":15},{"dia_id":"D16:16","global_turn_index":287,"locator":"[S16T16]","raw_turn_sha256":"cad7e402638e0cbc547cd9050787b120afa2d0a3fb3c59947e331370659a6c14","rendered_turn_sha256":"92c765ec49cd314580d4b8b760b3a28ce4d26166a975768cf8cb2b9e1f241e68","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"a07239eb35d334b948b4948f0827bd9386b5d6940526f112d95fd73f5f01ffb6","speaker":"Calvin","turn_index":16}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin! Long time no chat! How was the end of your tour? I bet it was amazing!\n[Image caption: a photo of a crowd of people at a concert with their hands in the air]\n[S16T1] (dia_id: D16:1)\n\nCalvin: Hey Dave! The tour was amazing! I was so pumped from all the energy from the audience. This pic totally captures how I felt. Such an amazing time!\n[Image caption: a photo of a crowd of people watching a concert with a large screen]\n[S16T2] (dia_id: D16:2)\n\nDave: Wow, that looks amazing! How was it performing on that big stage?\n[S16T3] (dia_id: D16:3)\n\nCalvin: Performing on such a big stage was a dream come true! The energy was incredible and I felt on top of the world. It was seriously surreal.\n[S16T4] (dia_id: D16:4)\n\nDave: Wow, that must have been an incredible experience! Congrats on achieving such an awesome moment!\n[S16T5] (dia_id: D16:5)\n\nCalvin: Cool! Last weekend I started shooting a video for my new album - can't wait for you to check it out! Look how great it was!\n[Image caption: a photo of a camera and a video camera on a beach]\n[S16T6] (dia_id: D16:6)\n\nDave: Wow, Calvin! Can't wait to see it. Will it be shot on location?\n[S16T7] (dia_id: D16:7)\n\nCalvin: We're doing the shoot in Miami and picked an awesome beach. It's going to have some epic visuals!\n[S16T8] (dia_id: D16:8)\n\nDave: Sounds great, Calvin! The beaches in Miami are awesome - can't wait to see them!\n[S16T9] (dia_id: D16:9)\n\nCalvin: Oh man, they are amazing! I love the Miami vibe, it's perfect for the vid. Can't wait to show you!\n[S16T10] (dia_id: D16:10)\n\nDave: Looking forward to it! I'm excited to see the vibe and the location. Let me know if you need any help with props or anything else for the video. I'm here to support you!\n[S16T11] (dia_id: D16:11)\n\nCalvin: Thanks, Dave! I'll let you know if I need any assistance with props or anything else. Your support is much appreciated.\n[S16T12] (dia_id: D16:12)\n\nDave: Sure, let me know when, I'm here to lend a hand. It's great to fuel your ideas. Remember that photo you sent me once? Love how this guitar shows our different artistic styles.\n[Image caption: a photo of a guitar with a octopus on it]\n[S16T13] (dia_id: D16:13)\n\nCalvin: Yes Dave, I remember! I had this custom made by my Japanese artist friend. It's got an octopus on it, which represents my love for art and the sea. It's one of my favorites!\n[S16T14] (dia_id: D16:14)\n\nDave: That's a great guitar, Calvin! Love the design, it's so unique and special.\n[S16T15] (dia_id: D16:15)\n\nCalvin: Cheers, mate! Really appreciate it. This guitar means so much to me; it's a reminder of my passion for music and the amazing friendships I've made.\n[S16T16] (dia_id: D16:16)","text_sha256":"70d3a38d40755d1328e742dcd17d6e588e774c2efd87bcd8cdac976628750f27","timestamp":"2023-08-31T14:55:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D28:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S28T1]"],"text_sha256":"1658b74af70a07598f8905a8fa13ff8fdcaa70cff0e96354f7cfc45649d56ed1"},{"dia_ids":["D28:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S28T2]"],"text_sha256":"873d0c9b45e6c202b420b812865b173d2ec14760692535e22699f2d663e49682"},{"dia_ids":["D28:3"],"kind":"raw_turn","line_end":21,"line_start":19,"source_locators":["[S28T3]"],"text_sha256":"09da5fcbab997454bea494bb5f651fbdfe915eda016d6e18e4935055fe1d5ca2"},{"dia_ids":["D28:4"],"kind":"raw_turn","line_end":24,"line_start":23,"source_locators":["[S28T4]"],"text_sha256":"1d531ec64f80b7b42694116e5d128fae24502d0023936fbbb1aa6cdc12d798bb"},{"dia_ids":["D28:5"],"kind":"raw_turn","line_end":28,"line_start":26,"source_locators":["[S28T5]"],"text_sha256":"bf1422df8f7bfdeda04549377f4f85c782cc15b636a908879a78bf294ecb969c"},{"dia_ids":["D28:6"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S28T6]"],"text_sha256":"912c78dcde8b5e59fa1d394bae41be6e72ff5c52d5fe564d726e691b1a12396b"}],"dia_ids":["D28:1","D28:2","D28:3"