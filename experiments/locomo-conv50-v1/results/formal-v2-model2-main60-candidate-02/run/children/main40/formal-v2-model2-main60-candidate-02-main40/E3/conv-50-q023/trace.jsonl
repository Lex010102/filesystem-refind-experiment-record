"6d0aa5293b3fa0a08881bb01ac7168c466571e00c005074647fe71f251bc13b4","coverage":[{"line_end":50,"line_start":38,"path":"/memories/cars-and-auto-work/session-12.md"}],"post_tree_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","pre_tree_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","protocol_version":"center-table12-readonly-v1","result_count":13,"result_sha256":"5eaab0c36a02f599618a72138020b87793b278b4bd9397c0fe1f1c09852d5f67","root_survey":false,"tool_name":"view","truncated":false,"whole_tree_grep":false},"schema_version":2,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d"}
