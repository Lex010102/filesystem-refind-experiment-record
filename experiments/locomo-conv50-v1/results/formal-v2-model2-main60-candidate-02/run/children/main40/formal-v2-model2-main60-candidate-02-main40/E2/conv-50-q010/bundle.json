e273cc0c62a25e9c12f1855","rendered_turn_sha256":"703ec4ef77edcf6b004fa72c797a33a6bf5f2b68641fb708663c2b5ff2319396","session_date":"2023-05-16","session_datetime":"2023-05-16T11:50:00","session_id":"session_6","session_index":6,"source_sha256":"f76c7dbc81e42ffffbae7a96df5902d8d05001b4f60005bac5f95032f6527d78","speaker":"Dave","turn_index":8}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave! Long time no chat! Lots has gone down since we last caught up.\n[S6T1] (dia_id: D6:1)\n\nDave: Hey Calvin! Long time no chat! How's everything been going since we last caught up?\n[S6T2] (dia_id: D6:2)\n\nCalvin: Hey Dave, not everything has been going smoothly. I had an incident last week where my place got flooded, but thankfully, I managed to save my music gear and favorite microphone. It's been tough, but I'm staying positive and looking forward to getting everything fixed up.\n[S6T3] (dia_id: D6:3)\n\nDave: Man, that's rough, Calvin. Sorry to hear about that. But I'm glad you could save your music gear and mic - those are the important things. Stay positive, pal. Anything I can do to help?\n[S6T4] (dia_id: D6:4)\n\nCalvin: Thanks, Dave. Appreciate the support. Waiting on insurance to kick in so I can start repairs - fingers crossed it won't take too long. Take a look at my creative haven, where I pour my heart into the music.\n[Image caption: a photo of a music studio with a keyboard, synthesizer, and other musical equipment]\n[S6T5] (dia_id: D6:5)\n\nDave: That studio looks awesome, Cal! I hope you get it fixed soon so you can continue creating music. Hang in there!\n[S6T6] (dia_id: D6:6)\n\nCalvin: Thanks, Dave! Can't wait to get back to making music. Anything exciting you're working on these days?\n[S6T7] (dia_id: D6:7)\n\nDave: I'm so excited, I opened my car shop last week! Invited some friends over to celebrate and it's been amazing. Super stoked to share my passion and help out with folks' rides. It's been incredible so far.\n[S6T8] (dia_id: D6:8)","text_sha256":"300b5c245c01dec248a444bf834b8329785b4b81b54ee2b4a254fcea5b5d31a3","timestamp":"2023-05-16T11:50:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D2:5"],"kind":"raw_turn","line_end":26,"line_start":24,"source_locators":["[S2T5]"],"text_sha256":"7fd471bf462ff912e9ba60515056f67168b7a3fc63ea272301a4107a17de2727"},{"dia_ids":["D2:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S2T6]"],"text_sha256":"6040d48eb28f79456100f172854b39d1382c0fda132c991aa47676c8070d5edd"},{"dia_ids":["D2:7"],"kind":"raw_turn","line_end":32,"line_start":31,"source_locators":["[S2T7]"],"text_sha256":"745e5af4b9ee571b22787a200652e46fe721b8f91bb08930e359b1bd92bcf7d6"},{"dia_ids":["D2:8"],"kind":"raw_turn","line_end":36,"line_start":34,"source_locators":["[S2T8]"],"text_sha256":"43288e0855c840e66915a448c123eeb9036f34ad68b77c7e7fc3885452972fcd"},{"dia_ids":["D2:9"],"kind":"raw_turn","line_end":39,"line_start":38,"source_locators":["[S2T9]"],"text_sha256":"7f651fc951cc22b18d45737507df0d3fa61689585e03181420da0a63534e21d1"},{"dia_ids":["D2:10"],"kind":"raw_turn","line_end":43,"line_start":41,"source_locators":["[S2T10]"],"text_sha256":"121c9c2854848943596c7e32cad01f80e1bad6c4748bd162e913d64790bb5e45"},{"dia_ids":["D2:11"],"kind":"raw_turn","line_end":46,"line_start":45,"source_locators":["[S2T11]"],"text_sha256":"b979c8776b38a45f1573300e0ed344ac0c18885d3fd0f040b2d61543c44cdb26"},{"dia_ids":["D2:12"],"kind":"raw_turn","line_end":50,"line_start":48,"source_locators":["[S2T12]"],"text_sha256":"930650cf7e34f8296b6b1d9f6248fba0bfdbb7814f6b8bed5a8e2c1f185b43b9"},{"dia_ids":["D2:13"],"kind":"raw_turn","line_end":53,"line_start":52,"source_locators":["[S2T13]"],"text_sha256":"5ba00b13f45a8241168860e5f1960d71e9785493ed0d02c510a6ad4d5adb2c82"},{"dia_ids":["D2:14"],"kind":"raw_turn","line_end":56,"line_start":55,"