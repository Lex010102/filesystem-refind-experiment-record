ia_id":"D30:24","global_turn_index":568,"locator":"[S30T24]","raw_turn_sha256":"aabba3ecc9ff029935e35534c34ed3b9f0ff69f1fc23d0909f17b30e198c8960","rendered_turn_sha256":"19aae2d71e03f50be2694151f2a92628102b5bc0a3cabd585551052a99b7d2a2","session_date":"2023-11-17","session_datetime":"2023-11-17T10:54:00","session_id":"session_30","session_index":30,"source_sha256":"b1112e12756742bd43795fac70cd818da829d92b77e29af173be10fcdbe7919f","speaker":"Calvin","turn_index":24}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Thanks, Calvin! I found this serene spot in a nearby park and took this pic.\n[S30T15] (dia_id: D30:15)\n\nCalvin: Wow, that sounds like such a peaceful and serene spot. Can't wait to check it out myself sometime. Check out this beautiful picture that I shot in a Japanese garden, that's wild!\n[Image caption: a photo of a bench under a tree with pink flowers]\n[S30T16] (dia_id: D30:16)\n\nDave: Cool, Calvin! Found an even better spot, with a bench under a tree with pink flowers - so peaceful. A perfect spot to relax and take in the beauty.\n[S30T17] (dia_id: D30:17)\n\nCalvin: That sounds great, Dave! Can't wait to see it.\n[S30T18] (dia_id: D30:18)\n\nDave: Check it out, Calvin. It's really calming, I think you'll like it. We will definitely go there! Is there anything else you'd like to share?\n[S30T19] (dia_id: D30:19)\n\nCalvin: Thank you for asking, Dave! Yes, I have a few more great news! I've accepted an invitation to perform at an upcoming show in Boston! It's going to be an unforgettable musical experience. Can't wait to fill you in on all the details. Catch up with you soon!\n[S30T20] (dia_id: D30:20)\n\nDave: Wow, Calvin! That's amazing news! Congratulations on both the gala attendance and the upcoming performance. I can't wait to hear all about it and maybe even catch one of your shows in Boston. Let me know when you're free to catch up. Cheers to your musical journey!\n[S30T21] (dia_id: D30:21)\n\nCalvin: Thanks, Dave! I'll catch you when I'm in Boston. Cheers!\n[S30T22] (dia_id: D30:22)\n\nDave: Looking forward to seeing you. Stay safe, talk to you soon!\n[S30T23] (dia_id: D30:23)\n\nCalvin: Thanks! You too. Talk to you later!\n[S30T24] (dia_id: D30:24)","text_sha256":"5aa52621eb66d5e4f4ef453f2bdc3e99861fed6022659a4999838fc19c066156","timestamp":"2023-11-17T10:54:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D29:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S29T1]"],"text_sha256":"aa49f3dfbe3368d8e1e8b266780656ccbc513ccceaea7d289af2e585352a8c0a"},{"dia_ids":["D29:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S29T2]"],"text_sha256":"1307ff7e36d107e681890d4d34ffbd3c1a421df7daf2bc781fcaced9db603c43"},{"dia_ids":["D29:3"],"kind":"raw_turn","line_end":20,"line_start":18,"source_locators":["[S29T3]"],"text_sha256":"6b2f621ede120792ccc9ef2a7e6cdfc044a90247e7165b1bbbaf5c369f00fb36"},{"dia_ids":["D29:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S29T4]"],"text_sha256":"0de27fdce4cc1d64109b57f7414f4a99bd6b62f9f9b39976f358c9fc55c9fbcf"},{"dia_ids":["D29:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S29T5]"],"text_sha256":"bbea71d3a50ccb515832600e5338d7aeb6fc5c54c8fe0af69efc66f059430da3"},{"dia_ids":["D29:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S29T6]"],"text_sha256":"257bbc08104db5b732250161640091648c41e618b36b2ad384d1a53ad3a92ed6"}],"dia_ids":["D29:1","D29:2","D29:3","D29:4","D29:5","D29:6"],"evidence_id":"ev-88ac0020ad2f22101ac3e60e5c42c4a3933f47fdf8c4e4a77ed6874f9c6fa0d5","group_id":"session_29","line_end":29,"line_start":12,"observation_ids":["obs-0001"],"path":"/memories/session-29.md","query_terms":["calvin","boston","perform"],"rank":5,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2