256":"a4495104ad92465f461640cb6ddc20e97e46ba1859a817df7833b6fd4c10e076","speaker":"Calvin","turn_index":17},{"dia_id":"D7:18","global_turn_index":137,"locator":"[S7T18]","raw_turn_sha256":"24e910050f147af9348309a71c2846e0d75ddf41b9ed8491b286bb54d83e16dc","rendered_turn_sha256":"a00bf65d3f76be8043b4832159449f5af582f8ec06f9c915ce88d7663973141d","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"5e6efd4508f7411ef8553a095472c28c9e0b1f8557b3001576fc4fa6ac6e4b6b","speaker":"Dave","turn_index":18},{"dia_id":"D7:19","global_turn_index":138,"locator":"[S7T19]","raw_turn_sha256":"fc0bbccdfde871cec412a200f1f54e885d76bd31fbca7bcaeb04cc17be6d69e9","rendered_turn_sha256":"2fe0dde1f756cbc4c93baa14897202496c8548707cf4ca28106b66ff7685b284","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"b2384a3983e2392a801f82fb8e3d5535f7db91b8da2668cd8eefd3d333c693a9","speaker":"Calvin","turn_index":19}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Performing live always fuels my soul! I love the rush and connection with the crowd, the feeling's indescribable—it's an absolute high!\n[S7T11] (dia_id: D7:11)\n\nDave: Wow, I bet it feels awesome. The connection between artist and audience must be so powerful. Look at the atmosphere in this photo, it's just off the charts!\n[Image caption: a photo of a large crowd of people taking pictures of a concert]\n[S7T12] (dia_id: D7:12)\n\nCalvin: Yeah, Dave! That feeling is amazing. Everyone is part of it, it's like one big harmony.\n[Image caption: a photo of a crowd of people watching a concert with bright lights]\n[S7T13] (dia_id: D7:13)\n\nDave: That's awesome! Music really brings people together and creates a great atmosphere. It's like therapy for us all. So, what's next for your music?\n[Image caption: a photo of a concert with a band performing on stage]\n[S7T14] (dia_id: D7:14)\n\nCalvin: Cool, can't wait for the tour with Frank! I'm buzzing to perform in Boston and see what it's like. Gonna be great playing for folks from home. What do you think of the music scene there?\n[S7T15] (dia_id: D7:15)\n\nDave: Hey, Boston's music scene is awesome! Tons of talented musicians and cool places to play. It'll be a blast performing there - I'll be there to cheer you on!\n[S7T16] (dia_id: D7:16)\n\nCalvin: Thanks, Dave! Your support means a lot to me. Can't wait to experience the music scene there.\n[S7T17] (dia_id: D7:17)\n\nDave: Great, Calvin! Have a great time in Boston. Can't wait to hear all about it when you get back!\n[S7T18] (dia_id: D7:18)\n\nCalvin: Thanks! I'll fill you in on all the details when I get back. See you soon!\n[S7T19] (dia_id: D7:19)","text_sha256":"bc8e7c396cde7a68844002bbf3913abd78811ee52c1303c39c20ba3efbd24d60","timestamp":"2023-05-31T18:06:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D30:15"],"kind":"raw_turn","line_end":63,"line_start":62,"source_locators":["[S30T15]"],"text_sha256":"ee01e79daa26414c690ed8a25b8a9507c40790b02fb7a9448db9b63676becae1"},{"dia_ids":["D30:16"],"kind":"raw_turn","line_end":67,"line_start":65,"source_locators":["[S30T16]"],"text_sha256":"57d17eb8b49edd96cfbd891ba3b0d779193a183c33868a8a1635af4fc6ffcbe4"},{"dia_ids":["D30:17"],"kind":"raw_turn","line_end":70,"line_start":69,"source_locators":["[S30T17]"],"text_sha256":"7353599b7b6aa3add9369386fe63e573e57fc33f1c754c64ebafaf9813e2f7e3"},{"dia_ids":["D30:18"],"kind":"raw_turn","line_end":73,"line_start":72,"source_locators":["[S30T18]"],"text_sha256":"93903ca5fc66f1393cd949d9b5697e4670e937d73832ba642dde79a5b6108a6b"},{"dia_ids":["D30:19"],"kind":"raw_turn","line_end":76,"line_start":75,"source_locators":["[S30T19]"],"text_sha256":"d3409c3c5b5ad2ce128f16214d25059802667ef86a148b8fe79d16a7062b