b0","speaker":"Dave","turn_index":5}],"speaker":"Dave","store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Thanks Calvin! I've spent a lot of time and effort on it. It's not just a hobby, it's a passion. It's like therapy, a way to get away from everyday stress. When I was little I'd spend hours in my dad's garage, tinkering with engines - it was like my own sanctuary. Now I'm lucky enough to do this as a job, to take something broken and make it into something awesome.\n[S22T5] (dia_id: D22:5)","text_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e","timestamp":"2023-10-08T15:13:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D13:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S13T2]"],"text_sha256":"4f7c8422fd8f30ef8124e41694a5b268ef6ec2fe1b6d93e66b65d9c7007ad91b"},{"dia_ids":["D13:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S13T3]"],"text_sha256":"0fde5d01882db55b7fcf79e727d6ea2fc010059e9b5c8697389e77d346bfd579"},{"dia_ids":["D13:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S13T4]"],"text_sha256":"5f2683dbf2d6671eebdbdfb0404138874d66cca09d6efc8e1d875de58fbe68b7"}],"dia_ids":["D13:2","D13:3","D13:4"],"evidence_id":"ev-1ecab5306b1322af35aabe5f451e82a73f57cb572fb3dc0da38621ed97caa6c1","group_id":"session_13","line_end":23,"line_start":16,"observation_ids":["obs-0007"],"path":"/memories/session-13.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 13","selection_ordinal":4,"session_id":"session_13","source_kind":"raw","source_locators":["[S13T2]","[S13T3]","[S13T4]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"d