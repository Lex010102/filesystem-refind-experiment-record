-01T18:24:00","session_id":"session_4","session_index":4,"source_sha256":"528e1eae86b5e30dd207fd0b4e228f8f164d50349c426d8b79e341379a579e4e","speaker":"Dave","turn_index":21}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Wow Dave, working on cars must be really rewarding.\n[S4T20] (dia_id: D4:20)\n\nDave: Definitely, working on cars is what I'm passionate about. Doing it every day is so rewarding! Seeing the transformation is awesome and knowing I'm helping people keep their cars in good condition is really satisfying.\n[S4T21] (dia_id: D4:21)","text_sha256":"4b3907a666eff0e9cf3012631aa361184e028763f3fd105890a3127e30642aab","timestamp":"2023-05-01T18:24:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D7:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S7T6]"],"text_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264"}],"dia_ids":["D7:6"],"evidence_id":"ev-7643a01ddb24ec4e25e461beef256789e3964faa75b03da4fc61cc34786b1c45","group_id":"session_7","line_end":29,"line_start":28,"observation_ids":["obs-0005"],"path":"/memories/session-07.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":6,"schema_version":1,"score":null,"section":"# Session 7","selection_ordinal":2,"session_id":"session_7","source_kind":"raw","source_locators":["[S7T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D7:6","global_turn_index":125,"locator":"[S7T6]","raw_turn_sha256":"ad5e054317db0597739478615b66efc8360019c7e0f8d3ed339d16c49c06c916","rendered_turn_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","sessi