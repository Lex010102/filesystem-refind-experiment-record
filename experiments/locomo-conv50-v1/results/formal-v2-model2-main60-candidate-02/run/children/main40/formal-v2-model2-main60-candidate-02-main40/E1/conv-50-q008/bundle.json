id: D6:8)\n\nCalvin: Way to go, Dave! Congrats on opening your own car shop! Your excitement is contagious. Keep up the great work!\n[S6T9] (dia_id: D6:9)","text_sha256":"a067657eb9ea409a1e7af6486344b77447b968e8ec14d088fbc83048833375f0","timestamp":"2023-05-16T11:50:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D26:4"],"kind":"raw_turn","line_end":23,"line_start":21,"source_locators":["[S26T4]"],"text_sha256":"36b999a0e53408c35fe6829785843f67e2e66149e833930c0fa94c11ef53eb38"}],"dia_ids":["D26:4"],"evidence_id":"ev-5dbf0494b89d48e532b2d651c59ec87d73a65579272cf9ca634707872f35dcd5","group_id":"session_26","line_end":23,"line_start":21,"observation_ids":["obs-0007"],"path":"/memories/session-26.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":14,"schema_version":1,"score":null,"section":"# Session 26","selection_ordinal":4,"session_id":"session_26","source_kind":"raw","source_locators":["[S26T4]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D26:4","global_turn_index":459,"locator":"[S26T4]","raw_turn_sha256":"e52a41492e27f76b0a253869d64d8cb7986acbead14b8a53b99d3ef110a7c145","rendered_turn_sha256":"36b999a0e53408c35fe6829785843f67e2e66149e833930c0fa94c11ef53eb38","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"afee282a44f4a93fb58775508faf28ecd1d0a9c174ee812426cdbf5ee6f9c091","speaker":"Dave","turn_index":4}],"speaker":"Dave","store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Glad you enjoyed Boston! It's got some great architecture and history. Working on this takes me out of my head and calms me down. Here's a pic of my latest car project.\n[Image caption: a photography of a gro