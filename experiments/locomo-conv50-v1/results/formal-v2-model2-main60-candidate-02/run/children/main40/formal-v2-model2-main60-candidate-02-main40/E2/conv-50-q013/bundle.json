05-16T11:50:00","session_id":"session_6","session_index":6,"source_sha256":"bfef6e02638b8cc4b2af867be339c3657326fc8ff19ef3f5be784c5e7529772b","speaker":"Calvin","turn_index":15},{"dia_id":"D6:16","global_turn_index":117,"locator":"[S6T16]","raw_turn_sha256":"84999ae2b9f40513175ac69b657dec1c96b4c5d3f83540fd17d623197985821c","rendered_turn_sha256":"b7acfb23bb5b4b59cbae5bc333d6730fbd50f5fafc60cd4f04f938eb093f904f","session_date":"2023-05-16","session_datetime":"2023-05-16T11:50:00","session_id":"session_6","session_index":6,"source_sha256":"6b00cb2ec6c5024d65b12a86bf2f6eab779228211769df782cad6d69e7f2d1d6","speaker":"Dave","turn_index":16}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Thanks, Dave! Can't wait to get back to making music. Anything exciting you're working on these days?\n[S6T7] (dia_id: D6:7)\n\nDave: I'm so excited, I opened my car shop last week! Invited some friends over to celebrate and it's been amazing. Super stoked to share my passion and help out with folks' rides. It's been incredible so far.\n[S6T8] (dia_id: D6:8)\n\nCalvin: Way to go, Dave! Congrats on opening your own car shop! Your excitement is contagious. Keep up the great work!\n[S6T9] (dia_id: D6:9)\n\nDave: Thanks, Calvin! Your support is greatly appreciated. It's been quite a journey so far, and I'm excited to see what the future holds. How about you? Anything exciting happening in the world of music for you?\n[S6T10] (dia_id: D6:10)\n\nCalvin: Thanks Dave! Super excited for my upcoming performance in Tokyo this month. It's gonna be great to show my music to a whole new crowd and hopefully expand my following!\n[S6T11] (dia_id: D6:11)\n\nDave: Cool, Cal! Doing a show in Tokyo, wow! I'm sure the audience is gonna love it. Wishing you all the luck! Let me know how it goes.\n[S6T12] (dia_id: D6:12)\n\nCalvin: Sure thing, Dave! I'll keep you posted on how it goes. Thanks for the good luck! Look what a wonderful night! \n\n[Image caption: a photo of a city at night with a lot of lights]\n[S6T13] (dia_id: D6:13)\n\nDave: That looks great! Where did you snap that pic?\n[S6T14] (dia_id: D6:14)\n\nCalvin: I took that pic in Tokyo last night. The skyline was stunning!\n[S6T15] (dia_id: D6:15)\n\nDave: Wow, great shot! The night skyline really pops with those city lights. I gotta take a trip there soon!\n[S6T16] (dia_id: D6:16)","text_sha256":"fdf83900473b81da37ab81a4a6884b6b4f3df0fdeb487dd16f410afe032fa658","timestamp":"2023-05-16T11:50:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D7:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S7T1]"],"text_sha256":"012ef9f23f3b50cf765546b114b2598fa9313302d6957a0530e0d6200c696707"},{"dia_ids":["D7:2"],"kind":"raw_turn","line_end":17,"line_start":15,"source_locators":["[S7T2]"],"text_sha256":"f4d9526e0fe3720c91774051474d662a5e70fc3c640cac71c149a10664204d75"},{"dia_ids":["D7:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S7T3]"],"text_sha256":"e21ffc108c8713e25b3b276ac6c93d0b3990c3805e72d5dfbf5bfe0854f8bb74"},{"dia_ids":["D7:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S7T4]"],"text_sha256":"29c7f28da678631cc2445278145c32a97ca12fe948d970f5a30e37ee09cfe88f"},{"dia_ids":["D7:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S7T5]"],"text_sha256":"d7d258d076f2897c721539dad49d239bdbf2f2659388a05628a31891a6e47e86"},{"dia_ids":["D7:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S7T6]"],"text_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264"}],"dia_ids":["D7:1","D7:2","D7:3","D7:4","D7:5","D7:6"],"evidence_id":"ev-c81b0f10e405f42dac96ecc212614fc31b4cf454824ff64ae683736829b84506","group_id":"session_7","line_end":29,"line_start":12,"observation_ids":["obs-0002"],"path":"/memories/session-07.md","query