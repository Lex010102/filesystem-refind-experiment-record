1a730b3","rendered_turn_sha256":"29c7f28da678631cc2445278145c32a97ca12fe948d970f5a30e37ee09cfe88f","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"368217fa071099ba38a13e07b3e5e3b093e924004685cf43cdc542766a377edf","speaker":"Dave","turn_index":4},{"dia_id":"D7:5","global_turn_index":124,"locator":"[S7T5]","raw_turn_sha256":"358af869d49fc39c374d4239a66844c254f6a618dfbf82e777bc882cd521f5fd","rendered_turn_sha256":"d7d258d076f2897c721539dad49d239bdbf2f2659388a05628a31891a6e47e86","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"abff7a82096624a76e6eb7fae5d6a25e03184121a569f91df70e2f7455de50ba","speaker":"Calvin","turn_index":5},{"dia_id":"D7:6","global_turn_index":125,"locator":"[S7T6]","raw_turn_sha256":"ad5e054317db0597739478615b66efc8360019c7e0f8d3ed339d16c49c06c916","rendered_turn_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"fe5132f508a590b80b56d1827f2c5963c6945a664d0352b4aba5bc2f5f3764db","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave! Been ages since we chatted. So much has gone down. Touring with Frank Ocean last week was wild. Tokyo was unreal -- the crowd was insane. I felt so alive when performing, can't find the words to express it.\n[S7T1] (dia_id: D7:1)\n\nDave: Wow, that's awesome, Cal! I bet it was an incredible experience. Congrats! Look what I've been up to recently, that's my neighbor's car. He's been having some trouble with the engine, but now it's done by myself!\n[Image caption: a photo of a man working on a car engine in a garage]\n[S7T2] (dia_id: D7:2)\n\nCalvin: Thanks, Dave! It was an amazing experience - the energy and love from the fans was crazy. The car in the pic? It's the one you were fixing up the engine for a friend? Working on cars helps me chill and clear my head.\n[S7T3] (dia_id: D7:3)\n\nDave: Yes, Cal! It's not difficult for me to help my neighbors with their cars. Working on cars is definitely therapeutic. Does it relax you as much as it does me?\n[S7T4] (dia_id: D7:4)\n\nCalvin: Yeah, totally! Fixing cars really calms me down and gives me a real sense of achievement - like meditating. Do you have any hobbies that give you the same satisfaction?\n[S7T5] (dia_id: D7:5)\n\nDave: I'm passionate about fixing up things. It's more than just a hobby - it gives me a sense of achievement and purpose. I get a real buzz transforming something that's not working into something that runs smoothly - it's like giving it a second chance.\n[S7T6] (dia_id: D7:6)","text_sha256":"da6029d54ee58c01c4bf00c4505b3e90019ee417d32552bb8856d1973135e447","timestamp":"2023-05-31T18:06:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D1:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S1T5]"],"text_sha256":"130868a1e09a7675016e98b44a29a58f75c974d4202db82e091ea350ffb2ae3c"},{"dia_ids":["D1:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S1T6]"],"text_sha256":"c8cd0dcbdc13fd78c7dc3f9c11af08e40a8f737153788c22379ecfa207f6556c"},{"dia_ids":["D1:7"],"kind":"raw_turn","line_end":32,"line_start":31,"source_locators":["[S1T7]"],"text_sha256":"dd89bc670ae4d47a46087f79ca40de851bba2dd8deea138d61d1d43988632720"},{"dia_ids":["D1:8"],"kind":"raw_turn","line_end":35,"line_start":34,"source_locators":["[S1T8]"],"text_sha256":"0cea5537df211a2b789d9ee1fae47ce559fe5ccf8615df36681e92252ddd08d0"},{"dia_ids":["D1:9"],"kind":"raw_turn","line_end":41,"line_start":37,"source_locators":["[S1T9]"],"text_sha256":"c59a0553a8abb9547159fd481e9f4b13f3cc69d672dd7d04ba558c3c32c27b4