44d08e0476","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"ff5c93a801ae8a90395dc547625f72b476d17515c9dc64215ed1a6d213b79c68","speaker":"Calvin","turn_index":20},{"dia_id":"D25:21","global_turn_index":445,"locator":"[S25T21]","raw_turn_sha256":"bd6e4f348d7218c6e3688cb35c7e7ad63f65f5225ae394de43be8b84bc23c0a5","rendered_turn_sha256":"53de5c2ae3c5f09c98c5dcd90d7510b9457c1498d5010019bf13a1db4ec0f203","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"01851d618a01cd31826e07854775daea99bcdac5bcbaa0d7e1b3795328697f08","speaker":"Dave","turn_index":21},{"dia_id":"D25:22","global_turn_index":446,"locator":"[S25T22]","raw_turn_sha256":"b76f0c6e68826546ef6b1d8233906cffcbecdc9cf9bbf7d98100c92ac8a8a7f3","rendered_turn_sha256":"4f8afb0a1550452cae420d32ca551b6bdb29bf814232fe44d6f239bec8c9384f","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"7143319e2b7850e13bd780af792ccf0f70974c59cce452ce01f266ed21efce38","speaker":"Calvin","turn_index":22}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: That's cool. Using your music to share experiences and feelings, is it cathartic for you?\n[S25T11] (dia_id: D25:11)\n\nCalvin: Yeah, it's a way for me to express myself and work through my emotions. It's like my own form of therapy.\n[S25T12] (dia_id: D25:12)\n\nDave: Yeah, I get it. Cars give me an outlet to express myself. It's like a little oasis of calm. Whenever I'm working on one, it's like I'm connecting back with myself. And yeah, the music helps too! Look at my garage, a little dirty, but everything is in its place.\n[Image caption: a photography of a garage with a bunch of tools hanging on the wall]\n[S25T13] (dia_id: D25:13)\n\nCalvin: Looking cool - what made you start working on cars?\n[S25T14] (dia_id: D25:14)\n\nDave: Ever since I was ten, I've been fascinated with how machines work. I found an old car in a neighbor's garage and asked if I could fix it. That's when my love for car engineering began! I enjoyed transforming it from broken-down to high-running, and that sense of accomplishment made me hooked—so I've been working on cars ever since.\n[Image caption: a photo of a man working on a car in a garage]\n[S25T15] (dia_id: D25:15)\n\nCalvin: Impressive! That must have taken a lot of skill and determination to bring that car back to life. Was it a classic car? Do you still have it or are you currently working on another project?\n[S25T16] (dia_id: D25:16)\n\nDave: Thanks Calvin! It was a fun project. I restored a car last year, but I sold it to a collector. Now I'm working on something new, and it's quite a challenge! Take a look at this wonderful car!\n[Image caption: a photo of a black car parked in a parking lot]\n[S25T17] (dia_id: D25:17)\n\nCalvin: Cool! Been wanting to try that. What would you say is the toughest part of car restoration?\n[S25T18] (dia_id: D25:18)\n\nDave: It takes a lot of patience, but the payoff is worth it. Paying extra attention to detail isn't easy, but it pays off.\n[S25T19] (dia_id: D25:19)\n\nCalvin: Yeah, details can really make a difference. It's what makes something great, like a well-crafted rap song or a sleek and stylish car.\n[S25T20] (dia_id: D25:20)\n\nDave: Yeah, for sure Calvin! Paying attention to details makes a big difference, whether it's in music or with vehicles. Little things can make a big impact!\n[S25T21] (dia_id: D25:21)\n\nCalvin: Yeah, Dave! Paying attention to those small details makes a difference. Without them, it's just average. As an artist, I want to create something extraordinary!\n[Image caption: a photo of a silver disc in a black frame on a table]\n[S25T22] (dia_id: D25:22)","text_sha256":"ca8534407b7cd3bc817f480ba54b6cae0d922f6dc9ea43320478da4a38f9da2b","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D13:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S13T1]"],"text_sha256":"c04ff814df559397e7da824cd51e0b6f0e0e12a581dd99b292a16d86abd4365f"},{"dia_ids":["D13:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S13T2]"],"text_sha256":"4f7c8422fd8f30ef8124e41694a5b268ef6ec2fe1b6d93e66b65d9c7007ad91b"},{"dia_ids":["D13:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S13T3]"],"text_sha256":"0fde5d01882db55b7fcf79e727d6ea2fc010059e9b5c8697389e77d346bfd579"},{"dia_ids":["D13:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S13T4]"],"text_sha256":"5f2683dbf2d6671eebdbdfb0404138874d66cca09d6efc8e1d875de58fbe68b7"},{"dia_ids":["D13:5"],"kind":"raw_turn","line_end":27,"line_start":25,"source_locators":["[S13T5]"],"text_sha256":"1b8d478f46f5b03485b44d2cbe7d1eccdab418f2cb7c7a45f8c6516b9cead8ad"},{"dia_ids":["D13:6"],"kind":"raw_turn","line_end":30,"line_start":29,"source_locators":["[S13T6]"],"text_sha256":"f7e40004513c3412efda49c9ddb416d4af282c1ecb40d829d01e12e920892a9c"}],"dia_ids":["D13:1","D13:2","D13:3","D13:4","D13:5","D13:6"],"evidence_id":"ev-a828e5f94769d31505a5cbf514096a4dc77778de82591587291e34f4f4486357","group_id":"session_13","line_end":30,"line_start":12,"observation_ids":["obs-0001"],"path":"/memories/cars-and-auto-work/session-13.md","query_terms":["dodge","charger","subaru","forester","car","project"],"rank":2,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":2,"schema_version":1,"score":0.03125763125763126,"section":"# Session 13","selection_ordinal":2,"session_id":"session_13","source_kind":"raw","source_locators":["[S13T1]","[S13T2]","[S13T3]","[S13T4]","[S13T5]","[S13T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e