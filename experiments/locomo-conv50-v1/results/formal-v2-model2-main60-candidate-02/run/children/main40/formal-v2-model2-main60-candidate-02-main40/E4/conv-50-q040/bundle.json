24c6b534e48a5d35703c316dc7dc7a987c2f7f699907ef43b22139","rendered_turn_sha256":"1b8d478f46f5b03485b44d2cbe7d1eccdab418f2cb7c7a45f8c6516b9cead8ad","session_date":"2023-08-11","session_datetime":"2023-08-11T17:22:00","session_id":"session_13","session_index":13,"source_sha256":"4722b7bde7480c7f50a8e1caa12f29ab19c811e6948515f1842818ded92211dc","speaker":"Dave","turn_index":5},{"dia_id":"D13:6","global_turn_index":227,"locator":"[S13T6]","raw_turn_sha256":"dfdaa6e6142c97a58e085da9cb2494fbb36d6080ccd4eb17ed7f5f6fe074d632","rendered_turn_sha256":"f7e40004513c3412efda49c9ddb416d4af282c1ecb40d829d01e12e920892a9c","session_date":"2023-08-11","session_datetime":"2023-08-11T17:22:00","session_id":"session_13","session_index":13,"source_sha256":"73153090324c1a435572103daefdbe3fd24e60632c3bf7fdeaaf61bdd6c80ba5","speaker":"Calvin","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Hey Calvin, been ages! Guess what? I got picked for a car mod workshop. Gonna get better at it and learn something new! Look at the cars I'm working with right now. \n[Image caption: a photography of a man standing in front of a car on a lift]\n[S13T1] (dia_id: D13:1)\n\nCalvin: Wow Dave, that's awesome! Congrats on being picked for the car mod workshop. It's a great opportunity to take your skills up a notch. Are there any mods or projects you're excited to work on?\n[S13T2] (dia_id: D13:2)\n\nDave: Thanks, Calvin! This is a dream come true for me, as I've always wanted to learn auto engineering and work on building a custom car.\n[S13T3] (dia_id: D13:3)\n\nCalvin: That's awesome, Dave! Pursuing your passion for auto engineering and making a custom car is a great experience. I'm excited to see what you create. Keep it up and have fun every step of the way. What do you think is the most thrilling part of it?\n[S13T4] (dia_id: D13:4)\n\nDave: Thanks, Calvin! I've found the picture with really thrilling part of the workshop, take a look. Seeing the potential come to life is always satisfying.\n[Image caption: a photo of a car is being worked on by a mechanic]\n[S13T5] (dia_id: D13:5)\n\nCalvin: Wow, that sounds like a fulfilling hobby! What kind of transformations have you done so far? How's it going with the current project?\n[S13T6] (dia_id: D13:6)","text_sha256":"f26d93749f757e4d541a4ae7c1428a0864d1a0cd8e3b2017750e315530c25dc5","timestamp":"2023-08-11T17:22:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D5:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S5T1]"],"text_sha256":"9c915f2f720758f1aa69f85fb7031406f5a908a381aee36bcf2d23718843c282"},{"dia_ids":["D5:2"],"kind":"raw_turn","line_end":18,"line_start":16,"source_locators":["[S5T2]"],"text_sha256":"336332abff03e5f7b2a1fe35516f1bfe526ca19cb7a38eeeff144ca466d52b46"},{"dia_ids":["D5:3"],"kind":"raw_turn","line_end":22,"line_start":20,"source_locators":["[S5T3]"],"text_sha256":"a25cd32818a9be4a8398a4723f9944448d406631a9818161bf7b4c014fd2adec"},{"dia_ids":["D5:4"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S5T4]"],"text_sha256":"4b88c4089b91f031a19b310c2dbc5b0d5c438403f60587ccdf81181213a4148a"},{"dia_ids":["D5:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S5T5]"],"text_sha256":"95b51e9c382d11641d8cc39f743c473a109b3611538ef8967014388813d1f795"},{"dia_ids":["D5:6"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S5T6]"],"text_sha256":"3ae0549b4a037d2cc7f3b387de0c13b3248bd962659b9ff1d5c503cadc2a37e1"},{"dia_ids":["D5:7"],"kind":"raw_turn","line_end":34,"line_start":33,"source_locators":["[S5T7]"],"text_sha256":"acf74ea4919bd10706c4f4cd07128cc50f6dd7f3c90935b6b9405a7307a81912"},{"dia_ids":["D5:8"],"kind":"raw_turn","line_end":38,"line_start":36,"source_locators":["[S5T8]"],"text_sha256":"496922821f4c583eba942ea291d4ab7c654af909b6cb9ccd5