695cc8dc0f7ead8ad222c32e0688d5105b67c909cad6852fb2ef2","rendered_turn_sha256":"87a321657a3a49e8ee8d8c318d9b774fb62a97a3372df18b5962e80bb1661fc9","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"de04a597c7bfe7bd43512b0284274e82997ed24c594312aebbc46bd1e1d64a46","speaker":"Calvin","turn_index":3},{"dia_id":"D12:4","global_turn_index":208,"locator":"[S12T4]","raw_turn_sha256":"4aa1f66c0d985fa53a6993ea9396b846499b6450b4e6c5fa76e797e5563bde13","rendered_turn_sha256":"03ea2fef9dc3245dac192501aa2e6987e54a76fdc80935a28cf0739e0ce8ac6d","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"3dc445d81a716d2312700e55eac044256de37afcd4f2c974a546c829f285a96e","speaker":"Dave","turn_index":4}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin, I understand the stress of getting a car serviced. Fixing cars is like therapy for me. Growing up working on cars with my dad, refurbishing them gives me a sense of fulfillment.\n[S12T2] (dia_id: D12:2)\n\nCalvin: Wow, Dave, that's awesome! Must feel great to have a hobby that makes you proud. Remember any good memories from working on cars with your dad?\n[S12T3] (dia_id: D12:3)\n\nDave: Yeah, definitely! I have fond memories of working on cars with my dad as a kid. We spent one summer restoring an old car. It was hard work, but seeing the end result and knowing that we did it together was really satisfying.\n[S12T4] (dia_id: D12:4)","text_sha256":"244d1cb5f32642a157ba0be537161a60354c5bfbaa9d8132815aad429eae8a94","timestamp":"2023-08-03T13:12:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D20:5"],"kind":"raw_turn","line_end":27,"line_start":26,"source_locators":["[S20T5]"],"text_sha256":"f0e9db5a18b32940b5