7aeb6fc5c54c8fe0af69efc66f059430da3","session_date":"2023-11-13","session_datetime":"2023-11-13T21:15:00","session_id":"session_29","session_index":29,"source_sha256":"4024e123b1a96080ca68d71aefaa5a104716147c65b4bae759c888e451fbe229","speaker":"Calvin","turn_index":5},{"dia_id":"D29:6","global_turn_index":532,"locator":"[S29T6]","raw_turn_sha256":"7d800eadc75efb7b783f2ef7195fb8fbc6ab8c15385aa9e8875cee38bf1281c1","rendered_turn_sha256":"257bbc08104db5b732250161640091648c41e618b36b2ad384d1a53ad3a92ed6","session_date":"2023-11-13","session_datetime":"2023-11-13T21:15:00","session_id":"session_29","session_index":29,"source_sha256":"b381f6ea04216ab2147dd3c610c13d456a3cb551bdc841d6b995c0893472f49b","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave, I invited my old high school buddy to see me perform in Boston! It was insane. It got me thinking about how far I've come and reminded me how important relationships are in this biz. Felt so good!\n[S29T1] (dia_id: D29:1)\n\nDave: Whoa, that's great Calvin! Seeing your old friend must have brought back so many memories. It's awesome to have someone who's been there since the start to support us.\n[S29T2] (dia_id: D29:2)\n\nCalvin: Remembering those days made me so nostalgic! Freestyling and talking about getting famous, it's crazy how life has changed. But being around certain people still sparks those same feelings. Take a look at how we freestyled when we were teenagers!\n[Image caption: a photography of two men standing on a sidewalk with a car in the background]\n[S29T3] (dia_id: D29:3)\n\nDave: Wow, that's a great pic! Did that person make a big difference during your trip?\n[S29T4] (dia_id: D29:4)\n\nCalvin: He's been such a great friend to me. Always there to support and encourage me. His positivity has made a big difference in my journey.\n[S29T5] (dia_id: D29:5)\n\nDave: It's great how someone's support and encouragement can really shape our lives! They give us the motivation to keep going and trust ourselves. Do you also find having supportive people around you important for your artist development?\n[S29T6] (dia_id: D29:6)","text_sha256":"725b37313981fb4d0736039caf0b5a95f080da6f0ee5544e7f2cc6753ddc3136","timestamp":"2023-11-13T21:15:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D30:15"],"kind":"raw_turn","line_end":63,"line_start":62,"source_locators":["[S30T15]"],"text_sha256":"ee01e79daa26414c690ed8a25b8a9507c40790b02fb7a9448db9b63676becae1"},{"dia_ids":["D30:16"],"kind":"raw_turn","line_end":67,"line_start":65,"source_locators":["[S30T16]"],"text_sha256":"57d17eb8b49edd96cfbd891ba3b0d779193a183c33868a8a1635af4fc6ffcbe4"},{"dia_ids":["D30:17"],"kind":"raw_turn","line_end":70,"line_start":69,"source_locators":["[S30T17]"],"text_sha256":"7353599b7b6aa3add9369386fe63e573e57fc33f1c754c64ebafaf9813e2f7e3"},{"dia_ids":["D30:18"],"kind":"raw_turn","line_end":73,"line_start":72,"source_locators":["[S30T18]"],"text_sha256":"93903ca5fc66f1393cd949d9b5697e4670e937d73832ba642dde79a5b6108a6b"},{"dia_ids":["D30:19"],"kind":"raw_turn","line_end":76,"line_start":75,"source_locators":["[S30T19]"],"text_sha256":"d3409c3c5b5ad2ce128f16214d25059802667ef86a148b8fe79d16a7062bf441"},{"dia_ids":["D30:20"],"kind":"raw_turn","line_end":79,"line_start":78,"source_locators":["[S30T20]"],"text_sha256":"e1b22e39f7f68eb9f1e020b731b2c13b7e9a46b058265b08cc1805db823aafe3"},{"dia_ids":["D30:21"],"kind":"raw_turn","line_end":82,"line_start":81,"source_locators":["[S30T21]"],"text_sha256":"72284bb8d769ed8b3747a0995cfd64c9f3ecb56e4650b7cb9f42edc79df8de1a"},{"dia_ids":["D30:22"],"kind":"raw_turn","line_end":85,"line_start":84,"source_locators":["[S30T22]"],"text_sha256":"170ea461d92ea5f35569f0603e2d700c99ad488a6803928d79010593da6f74d2"},{"dia_ids":["D30:23"],"kind":"raw_turn","line_end":88,"line_st