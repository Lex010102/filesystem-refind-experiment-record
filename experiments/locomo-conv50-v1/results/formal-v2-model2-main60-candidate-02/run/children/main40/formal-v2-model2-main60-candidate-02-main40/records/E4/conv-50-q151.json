ion_index":7,"source_sha256":"5e6efd4508f7411ef8553a095472c28c9e0b1f8557b3001576fc4fa6ac6e4b6b","speaker":"Dave","turn_index":18},{"dia_id":"D7:19","global_turn_index":138,"locator":"[S7T19]","raw_turn_sha256":"fc0bbccdfde871cec412a200f1f54e885d76bd31fbca7bcaeb04cc17be6d69e9","rendered_turn_sha256":"2fe0dde1f756cbc4c93baa14897202496c8548707cf4ca28106b66ff7685b284","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"b2384a3983e2392a801f82fb8e3d5535f7db91b8da2668cd8eefd3d333c693a9","speaker":"Calvin","turn_index":19}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Performing live always fuels my soul! I love the rush and connection with the crowd, the feeling's indescribable—it's an absolute high!\n[S7T11] (dia_id: D7:11)\n\nDave: Wow, I bet it feels awesome. The connection between artist and audience must be so powerful. Look at the atmosphere in this photo, it's just off the charts!\n[Image caption: a photo of a large crowd of people taking pictures of a concert]\n[S7T12] (dia_id: D7:12)\n\nCalvin: Yeah, Dave! That feeling is amazing. Everyone is part of it, it's like one big harmony.\n[Image caption: a photo of a crowd of people watching a concert with bright lights]\n[S7T13] (dia_id: D7:13)\n\nDave: That's awesome! Music really brings people together and creates a great atmosphere. It's like therapy for us all. So, what's next for your music?\n[Image caption: a photo of a concert with a band performing on stage]\n[S7T14] (dia_id: D7:14)\n\nCalvin: Cool, can't wait for the tour with Frank! I'm buzzing to perform in Boston and see what it's like. Gonna be great playing for folks from home. What do you think of the music scene there?\n[S7T15] (dia_id: D7:15)\n\nDave: Hey, Boston's music scene is awesome! Tons of talented musicians and cool places to play. It'll be a blast performing there - I'll be there to cheer you on!\n[S7T16] (dia_id: D7:16)\n\nCalvin: Thanks, Dave! Your support means a lot to me. Can't wait to experience the music scene there.\n[S7T17] (dia_id: D7:17)\n\nDave: Great, Calvin! Have a great time in Boston. Can't wait to hear all about it when you get back!\n[S7T18] (dia_id: D7:18)\n\nCalvin: Thanks! I'll fill you in on all the details when I get back. See you soon!\n[S7T19] (dia_id: D7:19)","text_sha256":"bc8e7c396cde7a68844002bbf3913abd78811ee52c1303c39c20ba3efbd24d60","timestamp":"2023-05-31T18:06:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D26:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S26T1]"],"text_sha256":"6d2bcb8c1846254b5111dff2e254bdf86135a4100e1d48bfbc68ed2d6af17ef2"},{"dia_ids":["D26:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S26T2]"],"text_sha256":"b1744a00170fef82c808ba2da8607d9fcd2774ed644622f1ae5a4fd03d92da0a"},{"dia_ids":["D26:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S26T3]"],"text_sha256":"ce74130c6f859ab8100a8fda2bab30a2169c0aac5e80d5ebf110f8b4d668728b"},{"dia_ids":["D26:4"],"kind":"raw_turn","line_end":23,"line_start":21,"source_locators":["[S26T4]"],"text_sha256":"36b999a0e53408c35fe6829785843f67e2e66149e833930c0fa94c11ef53eb38"},{"dia_ids":["D26:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S26T5]"],"text_sha256":"0545e051475a5506da033b60967e3905b30308f3b34f55ddeae582adce8c96b6"},{"dia_ids":["D26:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S26T6]"],"text_sha256":"b775c33f1cef75ef7013961b39fd3d6f5585cda8a8f835ce1daefaf0b8bae756"}],"dia_ids":["D26:1","D26:2","D26:3","D26:4","D26:5","D26:6"],"evidence_id":"ev-e7aef2cb6b4ea7fae83ac05b5fd0f4439a63bee3ae057f4f84e8facce0ed48a0","group_id":"session_26","line_end":29,"line_start":12,"observation_ids":["obs-0002"],"path":"/memories/cars-and-auto-work