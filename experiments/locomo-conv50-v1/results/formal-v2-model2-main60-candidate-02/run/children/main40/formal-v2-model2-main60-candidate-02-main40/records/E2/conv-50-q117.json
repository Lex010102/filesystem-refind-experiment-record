bd6","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"8e1c394003c7eb91fc7ce2d88c90940dbd60f33319d130545d8e7e2222223a26","speaker":"Dave","turn_index":13},{"dia_id":"D14:14","global_turn_index":254,"locator":"[S14T14]","raw_turn_sha256":"d13b39b8fd01372138f1a5ee20048e11601cd13496d4d9eb5040b0b90fde2270","rendered_turn_sha256":"76aba909aeb7a3a47c2dc26db3e8f01f2aa3a81a7ec6ef116358120bde5f69ed","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"0de90cbb539562ba2ccf4c834c82bca1a9c4ba540ca7953e8ed586cd52b2a8bf","speaker":"Calvin","turn_index":14},{"dia_id":"D14:15","global_turn_index":255,"locator":"[S14T15]","raw_turn_sha256":"3e01196a76dc6ad77ef4c891b6cc7c26a49a4f1b16a8b3e3c14f491bb94dc421","rendered_turn_sha256":"7ef3ac279271d35edac5491ae9eb31faf6e6e9854364e15b33823c331c21ebd8","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"6243408e6c9d7567706a71f238339a84125a07523bfc631d2eae1095bfcad887","speaker":"Dave","turn_index":15},{"dia_id":"D14:16","global_turn_index":256,"locator":"[S14T16]","raw_turn_sha256":"9850482bea88ffab37ef6b15a376e6bb47fe3594ac860aa99a352e1e63f5cf69","rendered_turn_sha256":"daa59c074789961c7be61d22bd4aaed637020261fd59bfaf25c09b69a80769a9","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"3e89fc34bf38991714532e49599d9f9d3d7bcc687d1a2d8182629bd553f41ec4","speaker":"Calvin","turn_index":16}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Wow, Calvin, sounds amazing! Got any pictures from that show? Would love to see the atmosphere.\n[S14T7] (dia_id: D14:7)\n\nCalvin: Yeah, here's a pic I took. It was so awesome - I loved how the crowd was into it. These moments are why I love my job.\n[Image caption: a photography of a crowd of people at a concert with their hands up]\n[S14T8] (dia_id: D14:8)\n\nDave: The energy in that pic is awesome! Seeing everyone with their hands up must have been really cool. It's great when your passion brings joy to others!\n[S14T9] (dia_id: D14:9)\n\nCalvin: Yeah, that was buzzing! It's moments like these that make me so proud and motivated. I'm all about spreading joy with my art. So, how's your project going?\n[S14T10] (dia_id: D14:10)\n\nDave: Yeah, the project is going great! Here's a pic of the car I'm restoring. It's pretty cool seeing it go from a beat-up mess to a real beauty.\n[Image caption: a photo of a car with a broken engine in the woods]\n[S14T11] (dia_id: D14:11)\n\nCalvin: Wow Dave, that car is going to look amazing when you're done. How long do you think it will take to restore it?\n[S14T12] (dia_id: D14:12)\n\nDave: Thanks, Calvin! Fingers crossed it'll be all fixed up by the end of next month. Lots of elbow grease but it'll be worth the transformation.\n[S14T13] (dia_id: D14:13)\n\nCalvin: Wow, Dave, I'm really excited to see the end result of your hard work! You've got some serious talent!\n[S14T14] (dia_id: D14:14)\n\nDave: Thanks, Cal! Your support means a lot to me.\n[S14T15] (dia_id: D14:15)\n\nCalvin: You got this, Dave! I'm always here for you. Seeing your enthusiasm is amazing. Keep growing, buddy. It'll be worth it! Good luck with that. See ya!\n[S14T16] (dia_id: D14:16)","text_sha256":"a08fa6b63122fce2db9861ffebd8bcf53c40e44e91e50d1b9ea2ea5f95d9811b","timestamp":"2023-08-14T00:35:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D20:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S20T1]"],"text_sha256":"1c9bf1085f23b638026b0f88d7110f7a10be191d181f5af14e7ae74617a88ed7"},{"dia_ids":["D20:2"],"kind":"raw_turn","line_end":18,"line_start":16,"source_l