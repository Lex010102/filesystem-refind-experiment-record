ha256":"494a58f4710ad5cd3eb197da3cb4b38c6c5be075e9de868cd1bd62ee99068001","rendered_turn_sha256":"c41a3128e5e2e9e6a3703e3bd5a620008565be64273cdf56a606016f061070ae","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"943d2e3a381c12903006584c9d6ae38488153a8fc816c8c298a8b84b0833e24c","speaker":"Calvin","turn_index":12},{"dia_id":"D16:13","global_turn_index":284,"locator":"[S16T13]","raw_turn_sha256":"3305eef83e7b881dcaf97c96dc759ae21d9cefb2d7bccc52b7ae028bc547c5dc","rendered_turn_sha256":"6cb6cf5ea8294054773693965039bc932d88643be5121e22ea59e1daa8b3b68f","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"21261e9fa6f8228d4b689e0b3b9fbe643e75bf4f054b34f946e0a3cb6e40bb1e","speaker":"Dave","turn_index":13},{"dia_id":"D16:14","global_turn_index":285,"locator":"[S16T14]","raw_turn_sha256":"313d200cbcdaaf261054ae577881e3d2c5309b306388136e9ad1d47532a11644","rendered_turn_sha256":"a2972e43089782aa5691d60a04cae08e9e39cba4de92c819afd98ade293f5591","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"81c04bd7c0a7d0b58bf286a8a3cd35ea5c236990e466854c830468b80f76065c","speaker":"Calvin","turn_index":14},{"dia_id":"D16:15","global_turn_index":286,"locator":"[S16T15]","raw_turn_sha256":"0e9a5af45489e61bdd857cf7a11c45c0182c7ec1f484537c7dbd987178eadb9f","rendered_turn_sha256":"17d18dfa5dad6374ec64794b3e9a110d0b22fdcc1fb0d58e0a88a743730088c6","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"9c26739f0017968ad53af14c1117cac382e0de173bd2527879ba41bedcc7bba7","speaker":"Dave","turn_index":15},{"dia_id":"D16:16","global_turn_index":287,"locator":"[S16T16]","raw_turn_sha256":"cad7e402638e0cbc547cd9050787b120afa2d0a3fb3c59947e331370659a6c14","rendered_turn_sha256":"92c765ec49cd314580d4b8b760b3a28ce4d26166a975768cf8cb2b9e1f241e68","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"a07239eb35d334b948b4948f0827bd9386b5d6940526f112d95fd73f5f01ffb6","speaker":"Calvin","turn_index":16}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Dave: Wow, that looks amazing! How was it performing on that big stage?\n[S16T3] (dia_id: D16:3)\n\nCalvin: Performing on such a big stage was a dream come true! The energy was incredible and I felt on top of the world. It was seriously surreal.\n[S16T4] (dia_id: D16:4)\n\nDave: Wow, that must have been an incredible experience! Congrats on achieving such an awesome moment!\n[S16T5] (dia_id: D16:5)\n\nCalvin: Cool! Last weekend I started shooting a video for my new album - can't wait for you to check it out! Look how great it was!\n[Image caption: a photo of a camera and a video camera on a beach]\n[S16T6] (dia_id: D16:6)\n\nDave: Wow, Calvin! Can't wait to see it. Will it be shot on location?\n[S16T7] (dia_id: D16:7)\n\nCalvin: We're doing the shoot in Miami and picked an awesome beach. It's going to have some epic visuals!\n[S16T8] (dia_id: D16:8)\n\nDave: Sounds great, Calvin! The beaches in Miami are awesome - can't wait to see them!\n[S16T9] (dia_id: D16:9)\n\nCalvin: Oh man, they are amazing! I love the Miami vibe, it's perfect for the vid. Can't wait to show you!\n[S16T10] (dia_id: D16:10)\n\nDave: Looking forward to it! I'm excited to see the vibe and the location. Let me know if you need any help with props or anything else for the video. I'm here to support you!\n[S16T11] (dia_id: D16:11)\n\nCalvin: Thanks, Dave! I'll let you know if I need any assistance with props or anything else. Your support is much appreciated.\n[S16T12] (dia_id: D16:12)\n\nDave: Sure, let me know when, I'm here to lend a hand. It's great to fuel your ideas. Remember that photo you sent me once? Love how this guitar shows our different artistic styles.\n[Image caption: a photo of a guitar with a octopus on it]\n[S16T13] (dia_id: D16:13)\n\nCalvin: Yes Dave, I remember! I had this custom made by my Japanese artist friend. It's got an octopus on it, which represents my love for art and the sea. It's one of my favorites!\n[S16T14] (dia_id: D16:14)\n\nDave: That's a great guitar, Calvin! Love the design, it's so unique and special.\n[S16T15] (dia_id: D16:15)\n\nCalvin: Cheers, mate! Really appreciate it. This guitar means so much to me; it's a reminder of my passion for music and the amazing friendships I've made.\n[S16T16] (dia_id: D16:16)","text_sha256":"3ece0ba7011783dfedb9d61a921ffc5e2538d9876a20691fa5f32774a75ea893","timestamp":"2023-08-31T14:55:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D17:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S17T5]"],"text_sha256":"690a3fcfd4a95e85516b4143d04a34e1d7ec384f1577b598de27a1a188a8273b"},{"dia_ids":["D17:6"],"kind":"raw_turn","line_end":29,"line_start":27,"source_locators":["[S17T6]"],"text_sha256":"baf8f68059bd17fd0c90b6ec79c86dfb8f3280ff4542797c2f57c414d2e6daa4"},{"dia_ids":["D17:7"],"kind":"raw_turn","line_end":32,"line_start":31,"source_locators":["[S17T7]"],"text_sha256":"56c8033a90b9beee29376254d7f55b86dab39e810fd76c9b5b2387e693c626db"},{"dia_ids":["D17:8"],"kind":"raw_turn","line_end":35,"line_start":34,"source_locators":["[S17T8]"],"text_sha256":"d0965c1af0be2fc3011e294eb653117a16b996e44c8eb6d887a518ed79c896d4"},{"dia_ids":["D17:9"],"kind":"raw_turn","line_end":38,"line_start":37,"source_locators":["[S17T9]"],"text_sha256":"ac7ec0e92adb6a797b7dc46332496cf550105f5965cf805f033867bf14818f39"},{"dia_ids":["D17:10"],"kind":"raw_turn","line_end":41,"line_start":40,"source_locators":["[S17T10]"],"text_sha256":"2d11fb213a0ed5354b561627480e8dd9277ec5cf438679e5a72ae590dcf438a1"}],"dia_id