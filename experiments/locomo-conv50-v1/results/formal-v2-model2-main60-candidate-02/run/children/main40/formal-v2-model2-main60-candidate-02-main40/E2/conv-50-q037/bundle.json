_sha256":"c330fb0f627aa87c85fef6e015b89d4a6c368ac326adff3fbb87887611871b57","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"34a3c9209c843de1a6f54cefed9b2d02de6d3dbd9970425032c636ba2d6a54ff","speaker":"Dave","turn_index":9},{"dia_id":"D16:10","global_turn_index":281,"locator":"[S16T10]","raw_turn_sha256":"51a6183a49b0d0fb32c490b8bc8c0b85819d836626fb070d8df9fc6dbc5be818","rendered_turn_sha256":"a524441bcfb9c2dc7dd931d3eea70928a194afd19879fd654fd1bf785b36c8e4","session_date":"2023-08-31","session_datetime":"2023-08-31T14:55:00","session_id":"session_16","session_index":16,"source_sha256":"2833b2e2565c57f5d7a43e0a73fed77189e6f68274b2b7d96c3f0efaee6500d6","speaker":"Calvin","turn_index":10}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin! Long time no chat! How was the end of your tour? I bet it was amazing!\n[Image caption: a photo of a crowd of people at a concert with their hands in the air]\n[S16T1] (dia_id: D16:1)\n\nCalvin: Hey Dave! The tour was amazing! I was so pumped from all the energy from the audience. This pic totally captures how I felt. Such an amazing time!\n[Image caption: a photo of a crowd of people watching a concert with a large screen]\n[S16T2] (dia_id: D16:2)\n\nDave: Wow, that looks amazing! How was it performing on that big stage?\n[S16T3] (dia_id: D16:3)\n\nCalvin: Performing on such a big stage was a dream come true! The energy was incredible and I felt on top of the world. It was seriously surreal.\n[S16T4] (dia_id: D16:4)\n\nDave: Wow, that must have been an incredible experience! Congrats on achieving such an awesome moment!\n[S16T5] (dia_id: D16:5)\n\nCalvin: Cool! Last weekend I started shooting a video for my new album - can't wait for you to check it out! Look how great it was!\n[Image caption: a photo of a camera and a video camera on a beach]\n[S16T6] (dia_id: D16:6)\n\nDave: Wow, Calvin! Can't wait to see it. Will it be shot on location?\n[S16T7] (dia_id: D16:7)\n\nCalvin: We're doing the shoot in Miami and picked an awesome beach. It's going to have some epic visuals!\n[S16T8] (dia_id: D16:8)\n\nDave: Sounds great, Calvin! The beaches in Miami are awesome - can't wait to see them!\n[S16T9] (dia_id: D16:9)\n\nCalvin: Oh man, they are amazing! I love the Miami vibe, it's perfect for the vid. Can't wait to show you!\n[S16T10] (dia_id: D16:10)","text_sha256":"070a1f1ed3c7abb113b99fd0f204093a5ad0c8ce8d6f2519034e34b04099fc0f","timestamp":"2023-08-31T14:55:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D27:7"],"kind":"raw_turn","line_end":33,"line_start":32,"source_locators":["[S27T7]"],"text_sha256":"51aeeab0e7b91e53e5fdb78abd7d2abe13a2bfcd042f8bb1c8231bc2322a2a8b"},{"dia_ids":["D27:8"],"kind":"raw_turn","line_end":36,"line_start":35,"source_locators":["[S27T8]"],"text_sha256":"f606909ecff493e4f4a08f06313193e5c5d71094557380dce629e97f777ca52e"},{"dia_ids":["D27:9"],"kind":"raw_turn","line_end":39,"line_start":38,"source_locators":["[S27T9]"],"text_sha256":"c142f56ee7c4ca1cdf2a6bacdb67c48e1ab2d6c1da6417e6cb0b0fcff2220e12"},{"dia_ids":["D27:10"],"kind":"raw_turn","line_end":42,"line_start":41,"source_locators":["[S27T10]"],"text_sha256":"4093068f61345de392afa0843c3eb5e62676706b482f0a2bba8f5f9d173942c7"},{"dia_ids":["D27:11"],"kind":"raw_turn","line_end":45,"line_start":44,"source_locators":["[S27T11]"],"text_sha256":"375e86ff913a389823cf807836ab1615ed53eea0e603b0441d88cb2e144f033f"},{"dia_ids":["D27:12"],"kind":"raw_turn","line_end":48,"line_start":47,"source_locators":["[S27T12]"],"text_sha256":"407abb3307245194f484d93ba4eb90538de97ef8520b91bccd35050687538113"},{"dia_ids":["D27:13"],"kind":"raw_turn","line_end":51,"line_start":50,"source_locators":["[S27T13]"],"text_sha256":"f96a84c3d5df1ec91744f772abde1e5558ba96c408ff13f7a959a095f7fa26