6":"c8223c834afd021c44dcbe0b2af455fe20c6db916145ffcff1fcd94dd17b997e","rendered_turn_sha256":"2346af100f269a632800f093267eb00a62b779e94aa2e3e350ae3a503836c8ce","session_date":"2023-10-19","session_datetime":"2023-10-19T10:11:00","session_id":"session_24","session_index":24,"source_sha256":"f72be0c0cbe74f9f51909769b6b6a5cd246264a62d80b8138aaf838e7cb56890","speaker":"Dave","turn_index":8}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave! Been a few days since we talked, but lots happened. Started touring with Frank Ocean and it's been amazing - so much energy from the crowd, such a connection when I'm on stage - unreal! Take a look at how I performed on stage, that was awesome!\n[Image caption: a photo of a band performing on stage with bright lights]\n[S24T1] (dia_id: D24:1)\n\nDave: Congrats, Calvin! That's awesome. Being able to play your music to a crowd and feel that connection must be unreal. How's the tour going?\n[S24T2] (dia_id: D24:2)\n\nCalvin: Thanks, Dave! The tour has been great, the energy from the crowd is awesome and jamming with Frank Ocean is a dream come true. It's been amazing!\n[S24T3] (dia_id: D24:3)\n\nDave: Wow, Calvin! I bet performing with him is like a dream come true! How did it happen?\n[S24T4] (dia_id: D24:4)\n\nCalvin: It all started August last year when we met at a festival and he said he wanted to collaborate. We clicked right away and the chemistry on stage was incredible. I'm so lucky! Check the photo, of how we perfectly look together on stage!\n[Image caption: a photo of a band performing on stage with a projection of a man on the wall]\n[S24T5] (dia_id: D24:5)\n\nDave: Wow, Calvin - you and Frank are so in tune! It's clear you both rock on stage. Can't wait to catch your show!\n[S24T6] (dia_id: D24:6)\n\nCalvin: Thanks, Dave! I'm so excited you'll be at one of our shows. It's such a great experience, you'll definitely enjoy it! Look at this crowd, that was insane!\n[Image caption: a photo of a large crowd of people in a large auditorium]\n[S24T7] (dia_id: D24:7)\n\nDave: That sounds really exciting! Can't wait to experience it. I'm sure everyone in the crowd is going to be pumped up!\n[S24T8] (dia_id: D24:8)","text_sha256":"db37bfbe43c648d70e5fcd92f615ad94c8230d478d92e56df72e8c9e45337f65","timestamp":"2023-10-19T10:11:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D25:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S25T1]"],"text_sha256":"534a37a1a11f8a414aa936d18009605559d2bea07cf07bca898c41c23924a598"},{"dia_ids":["D25:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S25T2]"],"text_sha256":"763d6ad9a0417ef2e95795e2c757f1451bf692c48f602f87582d58cc5d67ab34"},{"dia_ids":["D25:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S25T3]"],"text_sha256":"475867cbac5a508a43cb1e4b3df21441c121ac75fe946d4828627a24bdf76e4f"},{"dia_ids":["D25:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S25T4]"],"text_sha256":"d14b99328b8d746c386132e20bf96cf7a6542aa5f3c167237d52c5ba26fd076e"},{"dia_ids":["D25:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S25T5]"],"text_sha256":"5a5c149bbacdbad1c65970030b41bdcd9904b16cd3c56993d693157fb56c2329"},{"dia_ids":["D25:6"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S25T6]"],"text_sha256":"13443fb62a97f45dded22cc9c6936eb06c2d85ec31c6cd321bd4aa6bc72b2ad0"}],"dia_ids":["D25:1","D25:2","D25:3","D25:4","D25:5","D25:6"],"evidence_id":"ev-91eb5ef6b3c63f64fbbfd11d3d044e7a4d19e3b4433513ba387190fe191d7008","group_id":"session_25","line_end":28,"line_start":12,"observation_ids":["obs-0001"],"path":"/memories/session-25.md","query_terms":["calvin","frank","ocean","tour"],"rank":3,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f