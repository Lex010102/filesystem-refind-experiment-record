5-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"368217fa071099ba38a13e07b3e5e3b093e924004685cf43cdc542766a377edf","speaker":"Dave","turn_index":4},{"dia_id":"D7:5","global_turn_index":124,"locator":"[S7T5]","raw_turn_sha256":"358af869d49fc39c374d4239a66844c254f6a618dfbf82e777bc882cd521f5fd","rendered_turn_sha256":"d7d258d076f2897c721539dad49d239bdbf2f2659388a05628a31891a6e47e86","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"abff7a82096624a76e6eb7fae5d6a25e03184121a569f91df70e2f7455de50ba","speaker":"Calvin","turn_index":5},{"dia_id":"D7:6","global_turn_index":125,"locator":"[S7T6]","raw_turn_sha256":"ad5e054317db0597739478615b66efc8360019c7e0f8d3ed339d16c49c06c916","rendered_turn_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264","session_date":"2023-05-31","session_datetime":"2023-05-31T18:06:00","session_id":"session_7","session_index":7,"source_sha256":"fe5132f508a590b80b56d1827f2c5963c6945a664d0352b4aba5bc2f5f3764db","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave! Been ages since we chatted. So much has gone down. Touring with Frank Ocean last week was wild. Tokyo was unreal -- the crowd was insane. I felt so alive when performing, can't find the words to express it.\n[S7T1] (dia_id: D7:1)\n\nDave: Wow, that's awesome, Cal! I bet it was an incredible experience. Congrats! Look what I've been up to recently, that's my neighbor's car. He's been having some trouble with the engine, but now it's done by myself!\n[Image caption: a photo of a man working on a car engine in a garage]\n[S7T2] (dia_id: D7:2)\n\nCalvin: Thanks, Dave! It was an amazing experience - the energy and love from the fans was crazy. The car in the pic? It's the one you were fixing up the engine for a friend? Working on cars helps me chill and clear my head.\n[S7T3] (dia_id: D7:3)\n\nDave: Yes, Cal! It's not difficult for me to help my neighbors with their cars. Working on cars is definitely therapeutic. Does it relax you as much as it does me?\n[S7T4] (dia_id: D7:4)\n\nCalvin: Yeah, totally! Fixing cars really calms me down and gives me a real sense of achievement - like meditating. Do you have any hobbies that give you the same satisfaction?\n[S7T5] (dia_id: D7:5)\n\nDave: I'm passionate about fixing up things. It's more than just a hobby - it gives me a sense of achievement and purpose. I get a real buzz transforming something that's not working into something that runs smoothly - it's like giving it a second chance.\n[S7T6] (dia_id: D7:6)","text_sha256":"da6029d54ee58c01c4bf00c4505b3e90019ee417d32552bb8856d1973135e447","timestamp":"2023-05-31T18:06:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D9:11"],"kind":"raw_turn","line_end":47,"line_start":45,"source_locators":["[S9T11]"],"text_sha256":"18773b7ed8c6560e73ebdd4ca912b2965eb5a4a08b6bb2fcb3eadfa8e733acc6"},{"dia_ids":["D9:12"],"kind":"raw_turn","line_end":50,"line_start":49,"source_locators":["[S9T12]"],"text_sha256":"f6b6e55635d2ea576fff6e017a9777bea3e5e0438eb93debbcc4c71719461186"},{"dia_ids":["D9:13"],"kind":"raw_turn","line_end":53,"line_start":52,"source_locators":["[S9T13]"],"text_sha256":"497e7f7cf1c50c08052f3e83d2ee3f57d08a0cfab4d907ccac9d029da4cd77d0"},{"dia_ids":["D9:14"],"kind":"raw_turn","line_end":56,"line_start":55,"source_locators":["[S9T14]"],"text_sha256":"a8e705950cc37ab6e0580a366a3d9d3ce85c8b20b603d47c079bf6de7261bb8f"},{"dia_ids":["D9:15"],"kind":"raw_turn","line_end":60,"line_start":58,"source_locators":["[S9T15]"],"text_sha256":"5a8c2385dd6fa4f1b051628cf1c2993a6356c58607965209feca931400192b20"},{"dia_ids":["D9:16"],"kind":"raw_turn","line_end":63,"line_start":62,"source_locators":["[S9T16]"],"text_sha256":"e62a898b0a7069bd334d08c66