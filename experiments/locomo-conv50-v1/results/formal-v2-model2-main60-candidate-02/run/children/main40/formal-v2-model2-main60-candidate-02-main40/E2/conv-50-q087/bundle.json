_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"18abf6ffd734e82119289100f5937218dea504de81325a6af199c3040643ea88","speaker":"Calvin","turn_index":4},{"dia_id":"D25:5","global_turn_index":429,"locator":"[S25T5]","raw_turn_sha256":"f0d80d6a07cbf390329b7f453969b588960083c7c63dfda5cd05afcdf0dac69e","rendered_turn_sha256":"5a5c149bbacdbad1c65970030b41bdcd9904b16cd3c56993d693157fb56c2329","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"604940819d155bba7700c6cfff763d1ceb0a83f400bd64d5d4c563ddb114ac7d","speaker":"Dave","turn_index":5},{"dia_id":"D25:6","global_turn_index":430,"locator":"[S25T6]","raw_turn_sha256":"38336dbd3a8ce52a39b1c37aaf56f20bfecb6f4fe09f34573c57ad0b0385a7d9","rendered_turn_sha256":"13443fb62a97f45dded22cc9c6936eb06c2d85ec31c6cd321bd4aa6bc72b2ad0","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"3c7f2a4aa3eb62101e99655755ef75f6da72e5395fad1e8b68d387c35b1d5f50","speaker":"Calvin","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin, how's the tour with Frank Ocean? I was pondering our chat the other day about fame and its impact on relationships. It must be awesome but it must have its own struggles too. How are you juggling your job plus your personal life?\n[S25T1] (dia_id: D25:1)\n\nCalvin: The tour's been incredible! Performing and connecting with the crowd has been so energizing. Yeah, fame has its own challenges. It's been tough trying to balance everything.\n[S25T2] (dia_id: D25:2)\n\nDave: How are you managing everything? Do you ever feel overwhelmed?\n[S25T3] (dia_id: D25:3)\n\nCalvin: I take it one day at a time, but it can get overwhelming with so many demands. Still, I enjoy what I do so I push on.\n[S25T4] (dia_id: D25:4)\n\nDave: Glad you're finding joy in what you do! Any strategies that help you manage everything?\n[S25T5] (dia_id: D25:5)\n\nCalvin: Yeah, having a strong support system is really helpful. My friends and team keep me on track.\n[S25T6] (dia_id: D25:6)","text_sha256":"837482aeb37550006e9a6fec924bd4a0304ce7279464c78f403be6fde67b14ac","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D7:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S7T1]"],"text_sha256":"012ef9f23f3b50cf765546b114b2598fa9313302d6957a0530e0d6200c696707"},{"dia_ids":["D7:2"],"kind":"raw_turn","line_end":17,"line_start":15,"source_locators":["[S7T2]"],"text_sha256":"f4d9526e0fe3720c91774051474d662a5e70fc3c640cac71c149a10664204d75"},{"dia_ids":["D7:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S7T3]"],"text_sha256":"e21ffc108c8713e25b3b276ac6c93d0b3990c3805e72d5dfbf5bfe0854f8bb74"},{"dia_ids":["D7:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S7T4]"],"text_sha256":"29c7f28da678631cc2445278145c32a97ca12fe948d970f5a30e37ee09cfe88f"},{"dia_ids":["D7:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S7T5]"],"text_sha256":"d7d258d076f2897c721539dad49d239bdbf2f2659388a05628a31891a6e47e86"},{"dia_ids":["D7:6"],"kind":"raw_turn","line_end":29,"line_start":28,"source_locators":["[S7T6]"],"text_sha256":"46a043b0767915bb66b8266ea1bc651d4f401f573fc11b4560bb60bc73602264"}],"dia_ids":["D7:1","D7:2","D7:3","D7:4","D7:5","D7:6"],"evidence_id":"ev-c81b0f10e405f42dac96ecc212614fc31b4cf454824ff64ae683736829b84506","group_id":"session_7","line_end":29,"line_start":12,"observation_ids":["obs-0001"],"path":"/memories/session-07.md","query_terms":["calvin","frank","ocean","tour"],"rank":4,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":2