ae8e949c9d34feb06f6881249e8297","session_date":"2023-07-07","session_datetime":"2023-07-07T19:56:00","session_id":"session_10","session_index":10,"source_sha256":"7018b83cf9905ecedefb62653662afa1824ce7ac2a37bea6161521816ae06827","speaker":"Calvin","turn_index":14},{"dia_id":"D11:10","global_turn_index":200,"locator":"[S11T10]","raw_turn_sha256":"3b9be966329ab3f0809a52130626b1e5de1f9cf33e76067aa8fb4c30cef8ef85","rendered_turn_sha256":"dd5c87541b676252a000b04f84eb848336f321dfa8ee3492c6e4ed582e6f3f80","session_date":"2023-07-21","session_datetime":"2023-07-21T18:38:00","session_id":"session_11","session_index":11,"source_sha256":"5cc70ace695de19f670142b04fe30f8165c3af930918c5fef96d6306c3f85163","speaker":"Calvin","turn_index":10},{"dia_id":"D12:11","global_turn_index":215,"locator":"[S12T11]","raw_turn_sha256":"8029c75f90dad86c772ede6e12447a8eef9abf6600d0b73efab389ae32f92fed","rendered_turn_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"24c639fe61ad09000cae9e993e46e94d45cb7d8f2edc5a0ee367b35a94649653","speaker":"Calvin","turn_index":11}],"speaker":null,"store_id":"s3","store_snapshot_sha256":"983238fddc77a88ef4ae3d06b50bcfd25a429f497e89c6af4d9477cefca9cad2","text":"- Dreaming of touring the world, performing for different people and connecting with them; hopes his music can reach a global audience and make an impact [S3T9].\n- On 2023-05-01, expressed that it's an amazing feeling when something you create resonates with people, and satisfying to finish something made from scratch — the same joy he finds in seeing a creation come to life [S4T10][S4T12].\n- Has a home music studio where he \"pour[s] [his] heart into the music\"; shared a photo of it (keyboard, synthesizer, and other musical equipment) while telling Dave about the house flood [S6T5].\n- On 2023-05-03, said he's stuck with his music — \"like [his] creativity's frozen\" — and asked Dave for tips; said he'll take Dave's advice (take a break from music and explore other things for fun) to get his \"mojo\" back, and affirmed he won't give up on his music [S5T10][S5T11][S5T12][S5T14].\n- On 2023-05-16, \"super excited\" for the Tokyo performance happening this month (May 2023) — a chance to show his music to a whole new crowd and hopefully expand his following (details in ## Tokyo trip) [S6T11]. The tour went ahead: as of 2023-05-31 he had been touring with Frank Ocean the week before (see ## Tokyo trip) [S7T1].\n- As of 2023-06-09, has an album in progress (\"my album\"); met with the creative team for it on 2023-06-08 — \"a long session, but awesome to see everything coming together\", and he's \"feeling stoked\" and \"making some magic\" in the studio working on the music and everything. He shared a photo of the studio (a recording studio with a large window and a desk) [S8T1][S8T3].\n- On 2023-05-31, said performing live \"always fuels my soul\" — he loves \"the rush and connection with the crowd,\" \"the feeling's indescribable — it's an absolute high\"; at a concert \"Everyone is part of it, it's like one big harmony.\" The chat came with concert photos (a large crowd taking pictures of a concert; a crowd watching a concert with bright lights; a band performing on stage) [S7T10][S7T11][S7T12][S7T13][S7T14].\n- As of 2023-07-07, is working on music collaborations with Japanese artists and promised Dave he'll share clips when everything's ready (details in ## Japan plan) [S10T12][S10T14].\n- On 2023-07-21, said he started making music to follow his dreams and is \"stoked\" about how far he's come [S11T10].\n- On 2023-07-21, when Dave asked how he deals with the pressure and stays motivated: collaborating with others and learning from them keeps him motivated, and surrounding himself with positive energy and passion helps as well [S11T10].\n- On 2023-08-03, said his plan for now (when Dave asked for his biggest goal) is to expand his brand worldwide and grow his fanbase — \"I want my music to reach more people and make an impact\" — and working with artists from around the globe and challenging himself to create special music are goals of his too (an extension of his earlier world-tour dream, see above) [S12T11].","text_sha256":"a0c0ee5f88c62cfdbd4780fb15b6ac13b78a1a7f72326ed6cb5660a5d029bddf","timestamp":null},{"attribution_index_sha256":"98109144a5a23da7a5b89634be2c543ea2366f2abe85f1f3f8a3df64a5e92ce2","attribution_units":[{"dia_ids":["D25:2","D25:4","D25:6"],"kind":"curated_fact","line_end":141,"line_start":141,"source_locators":["[S25T2]","[S25T4]","[S25T6]"],"text_sha256":"74702fe8eac1b7b912a310234c50782e84c62de17cb5cbbfbed3509e67d90cb3"}],"dia_ids":["D25:2","D25:4","D25:6"],"evidence_id":"ev-1b01ba145894ce732c1a2a43c88405b59cdbab91e30143029220122e742e2754","group_id":"/memories/calvin.md > # Calvin","line_end":141,"line_start":141,"observation_ids":["obs-0003"],"path":"/memories/calvin.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":4,"schema_version":1,"score":null,"section":"# Calvin > ## Music","selection_ordinal":2,"session_id":"session_25","source_kind":"curated","source_locators":["[S25T2]","[S25T4]","[S25T6]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D25:2","global_turn_index":426,"locator":"[S25T2]","raw_turn_sha256":"762aec6c57aca67bc96b6a927cc8c3ce83537f9b9775beabb7c0ef6ed6613e8d","rendered_turn_sha256":"763d6ad9a0417ef2e95795e2c757f1451bf692c48f602f87582d58cc5d67ab34","session_date":"2023-10-23","session_datetime":"2023-10-23T14:17:00","session_id":"session_25","session_index":25,"source_sha256":"9b5e5fd72dfb2448855e660566f8487f8609329927d42edd1cd51cf75a5b7127","speaker":"Calvin","turn_index":2},{"dia_id":"D25:4","global_turn_index":428,"locator":"[S25T4]","raw_turn_sha256":"9b6dc89022382eb2ee8fb42