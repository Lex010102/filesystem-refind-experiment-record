n_datetime":"2023-11-02T17:46:00","session_id":"session_28","session_index":28,"source_sha256":"20c65017c06be29c8f9a72ed9a768b7efee96292934be3ec0ca07cff083a20cd","speaker":"Calvin","turn_index":5},{"dia_id":"D28:6","global_turn_index":489,"locator":"[S28T6]","raw_turn_sha256":"4cd57727c340c07c59da8390cbf11c133a36a085f0302368155338f58a0fb5ac","rendered_turn_sha256":"912c78dcde8b5e59fa1d394bae41be6e72ff5c52d5fe564d726e691b1a12396b","session_date":"2023-11-02","session_datetime":"2023-11-02T17:46:00","session_id":"session_28","session_index":28,"source_sha256":"5a14bb7040d9a8143895894042e9fef05439f9613ae1147192b7766071039674","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! It's been a while! Crazy stuff has been happening. Last week I threw a small party at my Japanese house for my new album. It was amazing, so much love from my fam and friends! Take a look at the photo of the party in the mansion, it was so energizing!\n[Image caption: a photography of a group of people sitting in a room with a projector screen]\n[S28T1] (dia_id: D28:1)\n\nDave: Congrats on your album release and the party, Calvin! Must've been a great feeling having your loved ones show their support.\n[S28T2] (dia_id: D28:2)\n\nCalvin: Thanks, Dave! It was an awesome feeling seeing everyone come together to celebrate - super rewarding! Look at this photo showcasing how wonderfully we spent our time!\n[Image caption: a photography of a group of people dancing at a party]\n[S28T3] (dia_id: D28:3)\n\nDave: Wow, great job, Calvin! Congrats! What was it like when everyone was cheering you on?\n[S28T4] (dia_id: D28:4)\n\nCalvin: It was incredible, Dave! The room was buzzing with energy and love. It was a powerful reminder of why I'm doing this.\n[Image caption: a photo of a group of people standing on top of a stage]\n[S28T5] (dia_id: D28:5)\n\nDave: Wow, Calvin! Creating something that brings people together and inspires them - that's really awesome!\n[S28T6] (dia_id: D28:6)","text_sha256":"efb6c52f78c9be07eb4095cbb6ba753596edf4cfdb5f2a841edfbca34bbad3c1","timestamp":"2023-11-02T17:46:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D11:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S11T1]"],"text_sha256":"ad8bd86e640c48d5965a796cac6fd2f49249b625f7093d47b0ab6532c6367cdd"},{"dia_ids":["D11:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S11T2]"],"text_sha256":"bdc81c32f8e03ee849ca44457ece85a81206ed9755141a3534f60b14988ac7bb"},{"dia_ids":["D11:3"],"kind":"raw_turn","line_end":20,"line_start":18,"source_locators":["[S11T3]"],"text_sha256":"b1c4aa5ff7966155f539de28c27dd8cc9642c46fe18a335a6eff30bb97f0290e"},{"dia_ids":["D11:4"],"kind":"raw_turn","line_end":24,"line_start":22,"source_locators":["[S11T4]"],"text_sha256":"84567e68a35d024ceaffd589e4b187132de6a7c467aaa2d711bfced9d1015544"},{"dia_ids":["D11:5"],"kind":"raw_turn","line_end":27,"line_start":26,"source_locators":["[S11T5]"],"text_sha256":"f434f2783612cd8083ebb9d7b56dbc52175ed6c0a4c1befdaae80a2d5628e9c1"},{"dia_ids":["D11:6"],"kind":"raw_turn","line_end":30,"line_start":29,"source_locators":["[S11T6]"],"text_sha256":"c9376ff7ab1ef241dea303789b464e0d86decce245105d4f7b477595ccdd3f4b"},{"dia_ids":["D11:7"],"kind":"raw_turn","line_end":33,"line_start":32,"source_locators":["[S11T7]"],"text_sha256":"69c48251711f858cbec033193e23eb6a7781c95d978f022cecdc5270b4a0a14d"},{"dia_ids":["D11:8"],"kind":"raw_turn","line_end":36,"line_start":35,"source_locators":["[S11T8]"],"text_sha256":"9362adec5a6a5951e9ff1ec7579256138abe762b8e2d6458fab4529b5b045c89"}],"dia_ids":["D11:1","D11:2","D11:3","D11:4","D11:5","D11:6","D11:7","D11:8"],"evidence_id":"ev-05bddbf124d7252b35810a1835fbf884faf971814b009ba9b7ae1306dc9fb41a","group_id":"session_11","line_end":36,"line_start":12