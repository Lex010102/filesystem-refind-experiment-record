3-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"1934b5c632d744f8dfcfccdfbdf085e2877ab5d909d6dadafceffb337f4a1542","speaker":"Dave","turn_index":14},{"dia_id":"D3:15","global_turn_index":55,"locator":"[S3T15]","raw_turn_sha256":"3d8db99e645084040c82e4f3e7430a93a56bdc2b5b0f400d41219892b2cc23ce","rendered_turn_sha256":"8756da8b4feae065ed7ed84429bbd6e544df083247abd338e5af89f4042c1ab2","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"fe0e57336911b17fe24e3bddcc5d264a13671ceb1ae14bf80848ba2249941c32","speaker":"Calvin","turn_index":15},{"dia_id":"D3:16","global_turn_index":56,"locator":"[S3T16]","raw_turn_sha256":"e5805e7ec4c08f0b01a772011da55b4fb8e3e1c5836976594ba3f544ab27251b","rendered_turn_sha256":"640e85992e807dbbe5b7416a889ef5be2d228fe16c507fe2d0907d8ea7517e75","session_date":"2023-04-20","session_datetime":"2023-04-20T16:15:00","session_id":"session_3","session_index":3,"source_sha256":"d47233b9f5b3294e736932ca7d13bb75546be8c286e04cd72493e20a4c571984","speaker":"Dave","turn_index":16}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: The producer gave me some advice to stay true to myself and sound unique. It got me thinking about where I want my music to go. It's really motivating!\n[S3T7] (dia_id: D3:7)\n\nDave: Wow, Calvin! It's really motivating to see you staying true to yourself. It got me thinking, where do you see your music taking you?\n[S3T8] (dia_id: D3:8)\n\nCalvin: Thanks, Dave! I'm dreaming of touring the world, performing for different people and connecting with them. I hope my music can reach a global audience and make an impact. I'm also looking forward to my upcoming trip to Boston after I finish the Frank Ocean tour. I've heard that the music scene there is awesome, so I can't wait to check it out!\n[S3T9] (dia_id: D3:9)\n\nDave: Sounds like an amazing plan, Cal! I can't wait for your trip to Boston. I'll show you around town and all the cool spots. The music scene there is awesome, with places like Paradise Rock, House of Blues, and Fenway Park. You'll definitely have some great performances there. Count me in for the front row when you're up onstage! Oh, and by the way, check out this pic.\n[Image caption: a photography of a city skyline with a boat in the water]\n[S3T10] (dia_id: D3:10)\n\nCalvin: Wow, Boston looks great! Thanks for the tips. And, awesome pic!\n[S3T11] (dia_id: D3:11)\n\nDave: Last weekend I went to a car show. Classic cars are so charming and the dedication people put into restoring them is amazing. That's why I'm so into auto engineering. Can't wait to show you some when you come to Boston! Oh, almost forgot to send a photo, look at this beautiful car!\n[Image caption: a photography of a green mustang parked in a field of grass]\n[S3T12] (dia_id: D3:12)\n\nCalvin: Wow, Dave, that car looks great! Take a look at my car, I put a lot of work into it. Can't wait to see more when I'm in Boston!\n[Image caption: a photo of a red sports car on display at a show]\n[S3T13] (dia_id: D3:13)\n\nDave: Thanks! It definitely took a lot of work. Have you had a chance to check out Boston apart from the gigs?\n[S3T14] (dia_id: D3:14)\n\nCalvin: Not yet, been pretty busy with rehearsals and traveling. But I'm looking forward to exploring the city, trying out some delicious food, and visiting the popular attractions. Maybe we can grab a bite together when I'm there?\n[S3T15] (dia_id: D3:15)\n\nDave: Definitely, Cal! Let's grab some food and I'll show you my favorite spots in the city. Can't wait to show them to you!\n[S3T16] (dia_id: D3:16)","text_sha256":"2522823529755a07f7e3ba936eff9cf552793001cc65f289da8b39edee1eb2e6","timestamp":"2023-04-20T16:15:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids"