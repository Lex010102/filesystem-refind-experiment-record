e! Everyone was so into it when I played one of my songs and sang along. It was a magical moment.\n[S14T6] (dia_id: D14:6)","text_sha256":"684633d5623c7779ef3681c9e6b35d8d2475d2f74ea90811990e1c66708458e3","timestamp":"2023-08-14T00:35:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D17:1"],"kind":"raw_turn","line_end":13,"line_start":12,"source_locators":["[S17T1]"],"text_sha256":"f7fbcec7fb18bfa49d6b4d6e5c0085effbe6488958a16a1592138ee7d006416f"},{"dia_ids":["D17:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S17T2]"],"text_sha256":"ada5ae9e6c02d7e73339aaa60f10a6049187401177ce626839d9511c61195608"},{"dia_ids":["D17:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S17T3]"],"text_sha256":"0dba7d209dd664bef1fe17b08c6de202fa925bedaadae948dabbec93f3a15bf1"},{"dia_ids":["D17:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S17T4]"],"text_sha256":"235b6188f1872a157955b103c48ff0307c6f21c6e75f6bafbf5d72586b24b44c"},{"dia_ids":["D17:5"],"kind":"raw_turn","line_end":25,"line_start":24,"source_locators":["[S17T5]"],"text_sha256":"690a3fcfd4a95e85516b4143d04a34e1d7ec384f1577b598de27a1a188a8273b"},{"dia_ids":["D17:6"],"kind":"raw_turn","line_end":29,"line_start":27,"source_locators":["[S17T6]"],"text_sha256":"baf8f68059bd17fd0c90b6ec79c86dfb8f3280ff4542797c2f57c414d2e6daa4"}],"dia_ids":["D17:1","D17:2","D17:3","D17:4","D17:5","D17:6"],"evidence_id":"ev-6990068783495e0edbea26b85ed1f8f6e362b83e2eb4e78d01e07abdc84978df","group_id":"session_17","line_end":29,"line_start":12,"observation_ids":["obs-0002"],"path":"/memories/session-17.md","query_terms":["san","francisco","workshop","car","restoration","technique"],"rank":3,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":4,"schema_version":1,"score":0.03200204813108039,"section":"# Session 17","selection_ordinal":2,"session_id