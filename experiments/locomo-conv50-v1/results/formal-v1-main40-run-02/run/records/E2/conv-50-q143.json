rings people together and inspires them - that's really awesome!\n[S28T6] (dia_id: D28:6)","text_sha256":"efb6c52f78c9be07eb4095cbb6ba753596edf4cfdb5f2a841edfbca34bbad3c1","timestamp":"2023-11-02T17:46:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D15:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S15T1]"],"text_sha256":"5f79f9f735194b8840c7a26337288b8cf0526c17b420a5a1df29c3b22834b1a5"},{"dia_ids":["D15:2"],"kind":"raw_turn","line_end":17,"line_start":16,"source_locators":["[S15T2]"],"text_sha256":"a248213a3a041cd41541eccd43cfdcd8b3cf2da7aea7f8a805fb9c48cf3b001b"},{"dia_ids":["D15:3"],"kind":"raw_turn","line_end":20,"line_start":19,"source_locators":["[S15T3]"],"text_sha256":"a4b40bd939dae42955a16ff2f9dc1d65d47e2ec3b483ad437919f2ee7f7b3e88"},{"dia_ids":["D15:4"],"kind":"raw_turn","line_end":23,"line_start":22,"source_locators":["[S15T4]"],"text_sha256":"1b1aca6c93ca24304fec4afbec8996e82bb3532d0ffc99a93e47bd2931e4d117"},{"dia_ids":["D15:5"],"kind":"raw_turn","line_end":26,"line_start":25,"source_locators":["[S15T5]"],"text_sha256":"b6d6a7e305a5dce73267aa6552a5750840afe2a2a4053d5c2bb6c88a2df52ad0"},{"dia_ids":["D15:6"],"kind":"raw_turn","line_end":30,"line_start":28,"source_locators":["[S15T6]"],"text_sha256":"3850ecc3a36c31d1b7b6cdc14dce65a03f143b767b883e402c63d616b1309ab3"},{"dia_ids":["D15:7"],"kind":"raw_turn","line_end":33,"line_start":32,"source_locators":["[S15T7]"],"text_sha256":"6fdd00f6d22c42b30916db09b67f1b7b91602c88c418c7be550f3a045d4d4205"},{"dia_ids":["D15:8"],"kind":"raw_turn","line_end":36,"line_start":35,"source_locators":["[S15T8]"],"text_sha256":"64e0eeace93b6a1c739d8bf14528b557eee23e4d90c888a3787a3d1d820486b8"}],"dia_ids":["D15:1","D15:2","D15:3","D15:4","D15:5","D15:6","D15:7","D15:8"],"evidence_id":"ev-6a1cc227d59fc040e65fead3bb410af78509cecc299e3b74e22dc9b6416c3d59","group_id":"session_15","line_end":36,"line_start":12,"observation_i