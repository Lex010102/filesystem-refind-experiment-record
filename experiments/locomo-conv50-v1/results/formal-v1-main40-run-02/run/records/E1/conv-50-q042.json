7)\n\nCalvin: We used to rock a song by Tupac and Dr. Dre called \"California Love\". Ah, those were the days!\n[S20T8] (dia_id: D20:8)","text_sha256":"aee23345845cd27b17e7c79e052d886a75ccf811ae8b8a33a977765a0a33d0ff","timestamp":"2023-09-22T20:57:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D12:2"],"kind":"raw_turn","line_end":16,"line_start":15,"source_locators":["[S12T2]"],"text_sha256":"df1948bc300331bf2dccbd4a818e3335cf8498da9297cd52906a947da0343001"},{"dia_ids":["D12:3"],"kind":"raw_turn","line_end":19,"line_start":18,"source_locators":["[S12T3]"],"text_sha256":"87a321657a3a49e8ee8d8c318d9b774fb62a97a3372df18b5962e80bb1661fc9"},{"dia_ids":["D12:4"],"kind":"raw_turn","line_end":22,"line_start":21,"source_locators":["[S12T4]"],"text_sha256":"03ea2fef9dc3245dac192501aa2e6987e54a76fdc80935a28cf0739e0ce8ac6d"}],"dia_ids":["D12:2","D12:3","D12:4"],"evidence_id":"ev-623cd78781de53c86d8cd1e356d1b7a3a940d5a6c6a0ca5038691f84634bf48f","group_id":"session_12","line_end":22,"line_start":15,"observation_ids":["obs-0008"],"path":"/memories/session-12.md","query_terms":[],"rank":null,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":7,"schema_version":1,"score":null,"section":"# Session 12","selection_ordinal":2,"session_id":"session_12","source_kind":"raw","source_locators":["[S12T2]","[S12T3]","[S12T4]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D12:2","global_turn_index":206,"locator":"[S12T2]","raw_turn_sha256":"ee08a5d711c5735d7fd1ae64afeb8f6806309f7ed413f43244beeee72c9cee1e","rendered_turn_sha256":"df1948bc300331bf2dccbd4a818e3335cf8498da9297cd52906a947da0343001","session_date":"2023-08-03","session_datetime":"2023-08-03T13:12:00","session_id":"session_12","session_index":12,"source_sha256":"d1b03a9f737559de11ed56e27e97597ccb46f66d80ad30eab82fc8ad59c80d18","s