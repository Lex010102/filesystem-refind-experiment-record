ada9507cb766e39bc4244e380f9fc84621a5fe73953b0","rendered_turn_sha256":"9e3ff47c748cbe9a72b3553babf710335671a8e5e98da4f2e3a4f32d644a8d6b","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"0ac942c2a003d4e31f7b3511015e7f6ec224b4b1fd971c7328696822270f1515","speaker":"Dave","turn_index":5},{"dia_id":"D14:6","global_turn_index":246,"locator":"[S14T6]","raw_turn_sha256":"49835c13d75ac0a54081e9dc6e41ce74520c5b3ac410a44724973a14fa54bae4","rendered_turn_sha256":"7867f666dedcfb23927aaeaeeb3bfb37708cfa6cfaa14743174a62b25844d37d","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"source_sha256":"a82648d816fd975633589912a643347b762188fde7a76821acacaa7feefb76c0","speaker":"Calvin","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Cal, how's it going? Something cool happened since last we talked - I got to go to a car workshop in San Francisco! So cool to dive into the world of car restoration and see all the different techniques. People were really passionate and dedicated - truly inspiring!\n[S14T1] (dia_id: D14:1)\n\nCalvin: Hey Dave! That's awesome! Car workshops sound totally cool and inspiring. Glad you found something that really gets you going.\n[S14T2] (dia_id: D14:2)\n\nDave: It's always great to learn and grow. So, what have you been up to lately?\n[S14T3] (dia_id: D14:3)\n\nCalvin: As you know, I had an amazing experience touring with a well-known artist. The feeling of performing and connecting with the audience was unreal. We ended with a show in Japan and then I had the opportunity to explore my new place - it's like a dream come true!\n[S14T4] (dia_id: D14:4)\n\nDave: Wow, Calvin! I bet playing for an eager audience was an incredible experience. Exploring Japan must have been amazing! How did Tokyo react to your music? Did you have any special moments there?\n[S14T5] (dia_id: D14:5)\n\nCalvin: Thanks, Dave! That show in Tokyo was awesome! Everyone was so into it when I played one of my songs and sang along. It was a magical moment.\n[S14T6] (dia_id: D14:6)","text_sha256":"684633d5623c7779ef3681c9e6b35d8d2475d2f74ea90811990e1c66708458e3","timestamp":"2023-08-14T00:35:00"},{"attribution_index_sha256":"98109144a5a23da7a5b89634be2c543ea2366f2abe85f1f3f8a3df64a5e92ce2","attribution_units":[{"dia_ids":["D13:17","D13:18","D13:19"],"kind":"curated_fact","line_end":201,"line_start":201,"source_locators":["[S13T17]","[S13T18]","[S13T19]"],"text_sha256":"27e0e65fbca71fe19fdf0be117a3abb98a6a4ce2b25949fc34e6db2933a8a966"},{"dia_ids":["D14:1","D14:2","D14:4","D14:5","D14:6","D14:7","D14:8","D14:9"],"kind":"curated_fact","line_end":202,"line_start":202,"source_locators":["[S14T1]","[S14T2]","[S14T4]","[S14T5]","[S14T6]","[S14T7]","[S14T8]","[S14T9]"],"text_sha256":"8fae6afe91a12bb8d0939d0bb7e1bece2d3a69fb700907548fbc109a93f2fa2c"},{"dia_ids":["D14:11","D14:12","D14:13","D14:15"],"kind":"curated_fact","line_end":203,"line_start":203,"source_locators":["[S14T11]","[S14T12]","[S14T13]","[S14T15]"],"text_sha256":"36a0dfb1a094702f190f9c354832e8225a78e88a4d28f0a54de18c91c8ad60df"},{"dia_ids":["D14:14","D14:16"],"kind":"curated_fact","line_end":204,"line_start":204,"source_locators":["[S14T14]","[S14T16]"],"text_sha256":"1837cb0430d35f15fb8f5dafa4b34d80f3c3c5ed0dfdc4ebdc18e3eba663fa42"},{"dia_ids":["D15:1","D15:2","D15:3","D15:4","D15:5","D15:6","D15:7","D15:8"],"kind":"curated_fact","line_end":205,"line_start":205,"source_locators":["[S15T1]","[S15T2]","[S15T3]","[S15T4]","[S15T5]","[S15T6]","[S15T7]","[S15T8]"],"text_sha256":"2f3b8f14bb895f019b93c19897a513f90a15a7fe674cee09500dd03fcb11b441"}],"dia_ids":["D13:17","D13:18","D13:19","D14:1","D14:2","D14:4","D14:5","D14:6","D14:7","D14:8","D14:9","D14:11","D14:12","D14:13","D14:15","D14:14","D14:16","D15:1","D15:2","D15:3","D15:4","D15:5","D15:6","D15:7