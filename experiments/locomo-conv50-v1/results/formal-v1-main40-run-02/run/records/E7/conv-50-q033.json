a140990ded10fd2e1a04201ea101","rendered_turn_sha256":"690a3fcfd4a95e85516b4143d04a34e1d7ec384f1577b598de27a1a188a8273b","session_date":"2023-09-02","session_datetime":"2023-09-02T09:19:00","session_id":"session_17","session_index":17,"source_sha256":"893ee9960621250cb2fe9e36a6158bfbc9aa2902b71f898f2ba4fb45c7aecc61","speaker":"Dave","turn_index":5},{"dia_id":"D17:6","global_turn_index":302,"locator":"[S17T6]","raw_turn_sha256":"04f5a4055d464b8b8cdf087c0db653c7fb151d5f8c61054b2a78cdf445ca804a","rendered_turn_sha256":"baf8f68059bd17fd0c90b6ec79c86dfb8f3280ff4542797c2f57c414d2e6daa4","session_date":"2023-09-02","session_datetime":"2023-09-02T09:19:00","session_id":"session_17","session_index":17,"source_sha256":"8a7cc85d81499fecb6fdafc2b3a8ef32e2f2deb882f63c42f81db302dd8961c4","speaker":"Calvin","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Dave: Hey Calvin! Been a while, what's up? I'm tied up with car stuff lately, yesterday I came back from San Francsico with some great insights and knowledge on car modification that I want to share with you! Changing things around, and giving an old car a new life - so satisfying!\n[S17T1] (dia_id: D17:1)\n\nCalvin: Hey Dave! Nice to hear from you. That's cool! I totally understand the satisfaction you get from fixing cars. It's like you're giving them new life.\n[S17T2] (dia_id: D17:2)\n\nDave: Yeah, it's great fixing stuff up and seeing it turn out better. It's really rewarding and gives me a sense of purpose. Plus, it feels like I'm making a difference when I fix someone's car.\n[S17T3] (dia_id: D17:3)\n\nCalvin: Wow, you must feel great making a real difference in someone's life, like being their superhero!\n[S17T4] (dia_id: D17:4)\n\nDave: Yeah, it's great! It feels really good to make a difference and see their relief when their car is fixed. Makes me proud!\n[S17T5] (dia_id: D17:5)\n\nCalvin: Wow, Dave, that's awesome! You should be really proud of yourself for bringing joy to others. I booked a flight ticket to Boston last week! I'm so excited about my upcoming trip to Boston. Look at this! See you soon, buddy!\n[Image caption: a photo of a book with a boarding pass and a boarding pass]\n[S17T6] (dia_id: D17:6)","text_sha256":"fb5c39a282853184e88c76df2577d2fd81e32f2ab46ffc6537fb7e5a0168f4cb","timestamp":"2023-09-02T09:19:00"},{"attribution_index_sha256":"98109144a5a23da7a5b89634be2c543ea2366f2abe85f1f3f8a3df64a5e92ce2","attribution_units":[{"dia_ids":["D14:1"],"kind":"curated_fact","line_end":66,"line_start":66,"source_locators":["[S14T1]"],"text_sha256":"ea89a27cafc0513cdc9966a1a33977508bba9d7ae99bb1575f20b8a120fbd698"},{"dia_ids":["D17:1"],"kind":"curated_fact","line_end":67,"line_start":67,"source_locators":["[S17T1]"],"text_sha256":"059110d7288543bbe847b89f2c0a20360657783512fafc4c1d3ada18c238a427"}],"dia_ids":["D14:1","D17:1"],"evidence_id":"ev-02a454d331d8686afb23af2e898ed86758fcdf8570bb724cc51760f53128f607","group_id":"/memories/dave.md > # Dave","line_end":67,"line_start":66,"observation_ids":["obs-0002"],"path":"/memories/dave.md","query_terms":["dave","workshop","san","francisco","new","technique","restoration"],"rank":1,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":4,"schema_version":1,"score":0.03252247488101534,"section":"# Dave > ## Car workshops in San Francisco","selection_ordinal":2,"session_id":null,"source_kind":"curated","source_locators":["[S14T1]","[S17T1]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5ce57e3c266dfc7a5d4d574","source_records":[{"dia_id":"D14:1","global_turn_index":241,"locator":"[S14T1]","raw_turn_sha256":"f3fd0d2391d9e7d9156ae64c1f94f512bc71c1cb118f2e701609800bae442dfd","rendered_turn_sha256":"55a307522d0cf3a96aa6c2813952e3a420b9263862db0ca185796fed736825dc","session_date":"2023-08-14","session_datetime":"2023-08-14T00:35:00","session_id":"session_14","session_index":14,"sour