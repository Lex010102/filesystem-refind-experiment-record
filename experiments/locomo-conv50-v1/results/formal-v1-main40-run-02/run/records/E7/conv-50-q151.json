3632e17c2b33a5c0bd657809f45e6139e48cd967a21cf","rendered_turn_sha256":"bbea71d3a50ccb515832600e5338d7aeb6fc5c54c8fe0af69efc66f059430da3","session_date":"2023-11-13","session_datetime":"2023-11-13T21:15:00","session_id":"session_29","session_index":29,"source_sha256":"4024e123b1a96080ca68d71aefaa5a104716147c65b4bae759c888e451fbe229","speaker":"Calvin","turn_index":5},{"dia_id":"D29:6","global_turn_index":532,"locator":"[S29T6]","raw_turn_sha256":"7d800eadc75efb7b783f2ef7195fb8fbc6ab8c15385aa9e8875cee38bf1281c1","rendered_turn_sha256":"257bbc08104db5b732250161640091648c41e618b36b2ad384d1a53ad3a92ed6","session_date":"2023-11-13","session_datetime":"2023-11-13T21:15:00","session_id":"session_29","session_index":29,"source_sha256":"b381f6ea04216ab2147dd3c610c13d456a3cb551bdc841d6b995c0893472f49b","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave, I invited my old high school buddy to see me perform in Boston! It was insane. It got me thinking about how far I've come and reminded me how important relationships are in this biz. Felt so good!\n[S29T1] (dia_id: D29:1)\n\nDave: Whoa, that's great Calvin! Seeing your old friend must have brought back so many memories. It's awesome to have someone who's been there since the start to support us.\n[S29T2] (dia_id: D29:2)\n\nCalvin: Remembering those days made me so nostalgic! Freestyling and talking about getting famous, it's crazy how life has changed. But being around certain people still sparks those same feelings. Take a look at how we freestyled when we were teenagers!\n[Image caption: a photography of two men standing on a sidewalk with a car in the background]\n[S29T3] (dia_id: D29:3)\n\nDave: Wow, that's a great pic! Did that person make a big difference during your trip?\n[S29T4] (dia_id: D29:4)\n\nCalvin: He's been such a great friend to me. Always there to support and encourage me. His positivity has made a big difference in my journey.\n[S29T5] (dia_id: D29:5)\n\nDave: It's great how someone's support and encouragement can really shape our lives! They give us the motivation to keep going and trust ourselves. Do you also find having supportive people around you important for your artist development?\n[S29T6] (dia_id: D29:6)","text_sha256":"725b37313981fb4d0736039caf0b5a95f080da6f0ee5544e7f2cc6753ddc3136","timestamp":"2023-11-13T21:15:00"},{"attribution_index_sha256":"98109144a5a23da7a5b89634be2c543ea2366f2abe85f1f3f8a3df64a5e92ce2","attribution_units":[{"dia_ids":["D29:1"],"kind":"curated_fact","line_end":85,"line_start":85,"source_locators":["[S29T1]"],"text_sha256":"d6b8a2d90be57bc9ba248ba8a8ca53948f35cce20fd50c4d041fedc12e613f54"},{"dia_ids":["D30:2"],"kind":"curated_fact","line_end":86,"line_start":86,"source_locators":["[S30T2]"],"text_sha256":"8f0204a921c35d15dff44b10c15eeab91094e1e9c8e82b75e13ba4f9fbdd3b04"},{"dia_ids":["D30:20","D30:21","D30:22"],"kind":"curated_fact","line_end":87,"line_start":87,"source_locators":["[S30T20]","[S30T21]","[S30T22]"],"text_sha256":"cac899ea318afdb4a714cd73665c412b8115251e8cef339c0ee105cca8e0addd"}],"dia_ids":["D29:1","D30:2","D30:20","D30:21","D30:22"],"evidence_id":"ev-0f483172db3276ff739e17c7943871b7ac8be1d6cb3854c0686e3350388d6268","group_id":"/memories/calvin.md > # Calvin","line_end":87,"line_start":85,"observation_ids":["obs-0001"],"path":"/memories/calvin.md","query_terms":["calvin","boston","perform","invite","november"],"rank":5,"records_sha256":"130a5a1e1b75083358ef27a98dd215a4e75c819ace6f2ee9b560ba394e0f0394","retrieval_round":2,"schema_version":1,"score":0.03057889822595705,"section":"# Calvin > ## Boston trip (planned as of 2023-04-20; Frank Ocean tour stop as of 2023-05-31; personal visit July 2023)","selection_ordinal":1,"session_id":null,"source_kind":"curated","source_locators":["[S29T1]","[S30T2]","[S30T20]","[S30T21]","[S30T22]"],"source_map_sha256":"6e99115961bae06a48bfb7e82dbdcc18dc32ccf6c5