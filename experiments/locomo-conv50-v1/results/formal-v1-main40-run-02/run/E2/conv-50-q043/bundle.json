796a816db5e33e791bea751862e20a15b44f4ea430351490c5837c1fb68d","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"e201fef0500c99fa1972ede46cd30e31ec3035cac585f1fdc29f3310bc39f7bd","speaker":"Dave","turn_index":4},{"dia_id":"D21:5","global_turn_index":356,"locator":"[S21T5]","raw_turn_sha256":"6c86ba106c7326abedba570a352ca0a833c5342d18af7fa4a057cf2345d1b4d6","rendered_turn_sha256":"52da6afe2a9f0cff62231bba0eae15a078d74aa923b880abe272e6f17c7a682b","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"d51e95731907f6327e6bffbd4044ba20b67a4ba3b3c76109454f75f25b64b50d","speaker":"Calvin","turn_index":5},{"dia_id":"D21:6","global_turn_index":357,"locator":"[S21T6]","raw_turn_sha256":"38afaceb17a3b8fc70c8a896bc402e1436a0310698f119a70b5b380d6aa91ae7","rendered_turn_sha256":"18ddc1dac20ed924705f00f17e262e027897c7b798eeb9f09beeafdc06753c7c","session_date":"2023-10-04","session_datetime":"2023-10-04T14:44:00","session_id":"session_21","session_index":21,"source_sha256":"aa233e2489600f1e4fbd697b18281d94089809b49606974b9313f8de9a8366b2","speaker":"Dave","turn_index":6}],"speaker":null,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","text":"Calvin: Hey Dave! Yesterday I met with some incredible artists in Boston and we talked about working together. It was such an inspiring and exciting experience - they all have individual styles and I'm stoked to collaborate with them on new music.\n[S21T1] (dia_id: D21:1)\n\nDave: Awesome, Calvin! Connecting with all those talented artists must have been an inspiring experience. Can't wait to hear what you come up with in your collaboration. Let me know how it goes! Also, how did you arrange that meeting?\n[S21T2] (dia_id: D21:2)\n\nCalvin: Hey Dave, it was awesome talking to those artists! Our mutual friend knew we'd be a great fit. Can't wait to show you the final result. Also, check out this project - I love working on it to chill out. How about you? Got any hobbies to help you relax?\n[Image caption: a photo of a shiny orange car with a hood open]\n[S21T3] (dia_id: D21:3)\n\nDave: Wow, Calvin, that car looks great! Working on cars really helps me relax, it's therapeutic to see them come back to life. I've been working on that Ford Mustang I found in a junkyard - it was in bad shape, but I knew it had potential.\n[S21T4] (dia_id: D21:4)\n\nCalvin: Wow, Dave! It's awesome that you can bring things back to life. Do you have any pictures of it looking amazing? I'd love to see how it turned out!\n[S21T5] (dia_id: D21:5)\n\nDave: Hey Calvin, check out this photo! I put in a lot of work restoring it, but the result is awesome. It's so satisfying to bring an old car back to life.\n[Image caption: a photography of a red car parked in a field with other cars]\n[S21T6] (dia_id: D21:6)","text_sha256":"a864e16f80acb360e6c046900588d5912d99767c18876cbddd8a8e2eb810c841","timestamp":"2023-10-04T14:44:00"},{"attribution_index_sha256":"08302ae53c7681312a62f5734d6ef73dfd8c86405ba319838bd79230cce094d2","attribution_units":[{"dia_ids":["D21:13"],"kind":"raw_turn","line_end":53,"line_start":52,"source_locators":["[S21T13]"],"text_sha256":"ebc75ec8ee7387123bc3446cdcc51e341661cb9362f50e0e75a40fdb9b65d32a"},{"dia_ids":["D21:14"],"kind":"raw_turn","line_end":56,"line_start":55,"source_locators":["[S21T14]"],"text_sha256":"f6ad6bdbfa30c6bd8be13fe8951d8e39eaf8668a883c12d271659008949dc00c"},{"dia_ids":["D21:15"],"kind":"raw_turn","line_end":59,"line_start":58,"source_locators":["[S21T15]"],"text_sha256":"ac1fa8708a8a954171a062560e782dafa07a341711e5f8b5da7e35087a4f68b9"},{"dia_ids":["D21:16"],"kind":"raw_turn","line_end":62,"line_start":61,"source_locators":["[S21T16]"],"text_sha256":"3204df1942b4763286c44158eec96f590730135e41e6fe2264a489f60253b779"},{"dia_ids":["D21:17"],"kind":"raw_turn","line_end":70,"line_start":64,"