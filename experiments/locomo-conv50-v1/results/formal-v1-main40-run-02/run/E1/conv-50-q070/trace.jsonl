a is key for capturing those special moments. What do you like to take photos of?","content_sha256":"b871ed19ee6e6e3cf2a22dda8a049c2c23160ed1e3db3e0bd8ed0477d2d8baf4","coverage":[{"line_end":30,"line_start":30,"path":"/memories/session-16.md"},{"line_end":21,"line_start":21,"path":"/memories/session-27.md"},{"line_end":27,"line_start":27,"path":"/memories/session-30.md"},{"line_end":28,"line_start":28,"path":"/memories/session-30.md"},{"line_end":31,"line_start":31,"path":"/memories/session-30.md"},{"line_end":34,"line_start":34,"path":"/memories/session-30.md"},{"line_end":37,"line_start":37,"path":"/memories/session-30.md"}],"post_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","pre_tree_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679","protocol_version":"center-table12-readonly-v1","result_count":7,"result_sha256":"783c7eca8c66a3c203f68f689cce4d176578eac21b0819191546df7f95aee4c2","root_survey":false,"tool_name":"grep","truncated":false,"whole_tree_grep":true},"schema_version":2,"store_id":"s1","store_snapshot_sha256":"ca39361e8e23f204a9fda55fc83e3ce7f411c7c8d582939aa63688c1923c7679"}
