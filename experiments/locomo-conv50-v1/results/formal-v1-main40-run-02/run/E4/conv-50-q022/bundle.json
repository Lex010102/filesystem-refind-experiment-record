u do! Any strategies that help you manage everything?\n[S25T5] (dia_id: D25:5)\n\nCalvin: Yeah, having a strong support system is really helpful. My friends and team keep me on track.\n[S25T6] (dia_id: D25:6)","text_sha256":"837482aeb37550006e9a6fec924bd4a0304ce7279464c78f403be6fde67b14ac","timestamp":"2023-10-23T14:17:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D12:7"],"kind":"raw_turn","line_end":33,"line_start":31,"source_locators":["[S12T7]"],"text_sha256":"763b2f6e468b1c258928e45b93c947733c784952a591501817bcf80a9237f30b"},{"dia_ids":["D12:8"],"kind":"raw_turn","line_end":36,"line_start":35,"source_locators":["[S12T8]"],"text_sha256":"8d05d12d8dbca589621acc642a16422a971b5d161b8cffde80c1b99c1dbf8228"},{"dia_ids":["D12:9"],"kind":"raw_turn","line_end":39,"line_start":38,"source_locators":["[S12T9]"],"text_sha256":"b00cf8667b1572a65b5b5c27a8c92ee0f978bdd5b27ffe8f35566db1a354f217"},{"dia_ids":["D12:10"],"kind":"raw_turn","line_end":42,"line_start":41,"source_locators":["[S12T10]"],"text_sha256":"b02d8b8796c00898b84f7efd6764c3632f0c2df9d63fff4bbe8524acace92c45"},{"dia_ids":["D12:11"],"kind":"raw_turn","line_end":46,"line_start":44,"source_locators":["[S12T11]"],"text_sha256":"3879470e4d6f3766abc832bc37a9a5f92c381568e897f1cf09477fe5b12e1708"},{"dia_ids":["D12:12"],"kind":"raw_turn","line_end":49,"line_start":48,"source_locators":["[S12T12]"],"text_sha256":"0e61f48d58c9a03b7b15c8e4c4672af272da2e18aa8423c3300fe2198bbc00e9"},{"dia_ids":["D12:13"],"kind":"raw_turn","line_end":52,"line_start":51,"source_locators":["[S12T13]"],"text_sha256":"7ebce75937eb7d6fcda81cb971e4a03d6373c6de78f085fa34c1a181937e3d4e"},{"dia_ids":["D12:14"],"kind":"raw_turn","line_end":55,"line_start":54,"source_locators":["[S12T14]"],"text_sha256":"f4c1a61881d2e751879ca4f1325d8ecab505a97f9ba2ccabca8409a5099f3c1b"},{"dia_ids":["D12:15"],"kind":"raw_turn","line_end":58,"line_start":57,"source_locators":["[S12T15]"]