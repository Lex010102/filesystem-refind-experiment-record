792b6322b7d91f395c3f27afe5862b6","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"ded99797c3e48b699c2f324dec86f83046e1bfa2b69ab60445e767f36bb42bc3","speaker":"Calvin","turn_index":7},{"dia_id":"D26:8","global_turn_index":463,"locator":"[S26T8]","raw_turn_sha256":"1b24d41c82a8a4026473d1c028584ebf7ebdbbc770aaceea21cb914385ffe417","rendered_turn_sha256":"4a6ebadac0356f2d81103b700e6f2777e9a758cbf8e41de17227eeb3ad831c31","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"b95dd58e9f06527903062f3400c94a993e24ebe480131b84deb6c344aff5c138","speaker":"Dave","turn_index":8},{"dia_id":"D26:9","global_turn_index":464,"locator":"[S26T9]","raw_turn_sha256":"f01a0812217499bb50d4ba35ad6d897ae016fca8fc1a7c205f02b993cf5fc18a","rendered_turn_sha256":"049f9687d3cdd87798ba0fd71c1a617dc8c4183220d329d7e855bcc14f723a42","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"738405cdb2944100108060148bd2816486f1214293f7e4b7dc233f84ff862e4a","speaker":"Calvin","turn_index":9},{"dia_id":"D26:10","global_turn_index":465,"locator":"[S26T10]","raw_turn_sha256":"2f9318fefed8cfd0fbc1bc77cc3bbdb2182d1799e01d84893eb82d17dd7aa686","rendered_turn_sha256":"b5ab7841f9c603faab3d552df50b4878fe4807ed27dce5f91ee148b84b2c7821","session_date":"2023-10-25","session_datetime":"2023-10-25T20:25:00","session_id":"session_26","session_index":26,"source_sha256":"0a729cbaaca4329a62ec225ac7bd122aed223abd4563ebc8f80217bff1ef24df","speaker":"Dave","turn_index":10}],"speaker":null,"store_id":"s2","store_snapshot_sha256":"e9b96bcd4e036f4ea4599edb06e9c0527c929442b09efe05d09ea416b8a4469d","text":"Calvin: Hey Dave! Long time no talk! I had a great time yesterday, and visited some sights in Boston with a high school friend. It was really fun and eye-opening.\n[S26T1] (dia_id: D26:1)\n\nDave: Hey Calvin! Good to hear from you! Sounds like you had a blast in Boston - so much to do there! One of my favorites there is great for chilling and admiring nature. BTW, something cool I wanted to tell you about - I recently attended a conference in Detroit - it was so cool, I learned a lot.\n[S26T2] (dia_id: D26:2)\n\nCalvin: I had a wonderful experience during my time in Boston. It had awesome architecture and a really cool history. I followed your advice and went there, it was so peaceful. Good to hear that you've learned a lot of new things at the conference in Detroit!\n[S26T3] (dia_id: D26:3)\n\nDave: Glad you enjoyed Boston! It's got some great architecture and history. Working on this takes me out of my head and calms me down. Here's a pic of my latest car project.\n[Image caption: a photography of a group of people washing a car in a garage]\n[S26T4] (dia_id: D26:4)\n\nCalvin: Dave, that car looks awesome! What got you into engineering cars? I'm totally into cars too and love making new and powerful models.\n[S26T5] (dia_id: D26:5)\n\nDave: Thanks, Calvin! It's always been my thing. My dad took me to my first car show when I was 10, and I was wow-ed! I was hooked and wanted to learn more. Now I'm an automotive engineer and it's crazy to think that something so powerful and cool can be made from small parts.\n[S26T6] (dia_id: D26:6)\n\nCalvin: That's awesome, Dave! So happy you followed your dreams and became an engineer. Seeing you work on cars is inspiring - it makes me want to keep pushing my music. Check this out - a pic of me performing with someone I admire! So amazing!\n[Image caption: a photo of a dj in a nightclub with a dj table]\n[S26T7] (dia_id: D26:7)\n\nDave: Wow, Calvin! That's amazing! You looked super comfortable on stage. Bet it was an incredible experience to perform with someone you admire. How did it feel being up there?\n[S26T8] (dia_id: D26:8)\n\nCalvin: It was unreal, Dave. Being up there with someone I admire - it was a dream come true. The energy, the crowd - it made me realize how much music means to me, it's like my passion and my purpose.\n[S26T9] (dia_id: D26:9)\n\nDave: That's great, Calvin. We both have discovered something that brings us fulfillment. It's a fortunate thing for us.\n[S26T10] (dia_id: D26:10)","text_sha256":"aeae3cdcfa63a378c4fd56176b9eb54520f7a1da0cadae458ce9e632f5cd32bc","timestamp":"2023-10-25T20:25:00"},{"attribution_index_sha256":"557de20bfece3f61e9afe8e8305a3e15c2c6f1474569dc78a6580fbb1490e746","attribution_units":[{"dia_ids":["D22:1"],"kind":"raw_turn","line_end":14,"line_start":12,"source_locators":["[S22T1]"],"text_sha256":"2998200aa379b0ffdf6d2c5eb80b638c63c4f492ac3a458fbcf37eefcc5d10d4"},{"dia_ids":["D22:2"],"kind":"raw_turn","line_end":18,"line_start":16,"source_locators":["[S22T2]"],"text_sha256":"912a1a3c8ad0270e4df402d58b653b7e13d086924fced9a87a5caafd0a2eb039"},{"dia_ids":["D22:3"],"kind":"raw_turn","line_end":21,"line_start":20,"source_locators":["[S22T3]"],"text_sha256":"18df288f8b36442c2a573b3a379f5f5d0a1e9c5af76455fcaf02bb6f706e937b"},{"dia_ids":["D22:4"],"kind":"raw_turn","line_end":25,"line_start":23,"source_locators":["[S22T4]"],"text_sha256":"25fe29d97f81835b34ae104469b4a0b218c64a9df39f93b96ad04db84f12c5c1"},{"dia_ids":["D22:5"],"kind":"raw_turn","line_end":28,"line_start":27,"source_locators":["[S22T5]"],"text_sha256":"1a4bb4e5e3813ac263f857847d17b16c435017bddad1d4cd221ef7b81c61324e"},{"dia_ids":["D22:6"],"kind":"raw_turn","line_end":31,"line_start":30,"source_locators":["[S22T6]"],"text_sha256":"cdb97b02ead7ab0929e49b06a34327709bdc5d6775decbee5bf8f2e7667813d2"},{"dia_ids":["D22:7"],"kind":"raw_turn","line_end":34,"line_start":33,"source_locators":["[S22T7]"],"text_sha256":"1f9c962e02107c042c4f8369c564114c82ba95ea02278b9eb7a5ffa9715fd304"},{"dia_ids":["D22:8"],"kind":"raw_turn","line_end":37,"line_start":36,"source_locators":["[S22T8]"],"text_sha256":"7482e5fab1f99c7ebe80de254daa1a95d89c31ea62f9fb946bb0f2d927a21f19"},{"dia_ids":["D22:9"],"kind":"raw